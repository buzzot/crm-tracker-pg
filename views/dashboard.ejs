<% if (typeof isRdUser !== 'undefined' && isRdUser) { %>
<%
  // ── R&D Dashboard ──────────────────────────────────────────────────────────
  function rdFmtDate(d) {
    if (!d) return '—';
    const dt = new Date(d + 'T00:00:00');
    if (isNaN(dt)) return d;
    return dt.toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
  }
  const rdToday = new Date(); rdToday.setHours(0,0,0,0);
  function rdIsOverdue(t) { return t.deadline && new Date(t.deadline + 'T00:00:00') < rdToday && t.status !== 'Completed'; }
  const statusColors = {
    'To Do':       { bg:'#eef0f3', fg:'#5b6172' },
    'In Progress': { bg:'#e7eefc', fg:'#2b5fb8' },
    'Completed':   { bg:'#dff5e3', fg:'#1c7a3c' },
    'Overdue':     { bg:'#fbe5e7', fg:'#c23b4a' },
    'Planning':    { bg:'#fef3c7', fg:'#92400e' },
    'Active':      { bg:'#e7eefc', fg:'#2b5fb8' },
    'On Hold':     { bg:'#fef3c7', fg:'#92400e' },
    'Open':        { bg:'#eef0f3', fg:'#5b6172' },
  };
  const typeIcon = { task: 'bi-diagram-3', project: 'bi-folder2-open', activity: 'bi-clock-history' };
  const typeLabel = { task: 'Task', project: 'Project', activity: 'Activity' };
  const typeLinkBase = { task: '/tasks/', project: '/projects/', activity: '/activities/' };
%>

<div class="mb-4">
  <div class="text-muted small"><%= new Date().toLocaleDateString(undefined, { weekday: 'long', month: 'long', day: 'numeric' }) %> &middot; R&D Team</div>
  <h1 class="display-headline mb-0">Open <em>issues</em></h1>
</div>

<div class="row g-3">
  <div class="col-lg-8">
    <div class="pnew-card p-0" style="overflow:hidden;">
      <div style="display:flex; align-items:center; justify-content:space-between; padding:1rem 1.25rem; border-bottom:1px solid var(--crm-border);">
        <span class="dashboard-card-title">Open Issues <span style="font-size:0.78rem; font-weight:500; color:var(--crm-muted-fg); margin-left:0.5rem;"><%= rdIssues.length %> open</span></span>
        <div style="display:flex; gap:0.75rem; align-items:center;">
          <a href="/tasks"      class="btn-view-all" style="font-size:0.75rem;"><i class="bi bi-diagram-3"></i> Tasks</a>
          <a href="/projects"   class="btn-view-all" style="font-size:0.75rem;"><i class="bi bi-folder2-open"></i> Projects</a>
          <a href="/activities" class="btn-view-all" style="font-size:0.75rem;"><i class="bi bi-clock-history"></i> Activities</a>
        </div>
      </div>
      <% if (!rdIssues.length) { %>
        <div style="padding:2.5rem; text-align:center; color:var(--crm-muted-fg);">
          <i class="bi bi-check2-circle" style="font-size:2rem; display:block; margin-bottom:0.5rem;"></i>
          No open issues right now.
        </div>
      <% } else { %>
        <table style="width:100%; border-collapse:collapse; font-size:0.875rem;">
          <thead>
            <tr style="background:var(--crm-muted);">
              <th style="padding:0.55rem 1rem; font-size:0.7rem; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; color:var(--crm-muted-fg); border-bottom:1px solid var(--crm-border);">Name</th>
              <th style="padding:0.55rem 1rem; font-size:0.7rem; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; color:var(--crm-muted-fg); border-bottom:1px solid var(--crm-border);">Type</th>
              <th style="padding:0.55rem 1rem; font-size:0.7rem; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; color:var(--crm-muted-fg); border-bottom:1px solid var(--crm-border);">Project</th>
              <th style="padding:0.55rem 1rem; font-size:0.7rem; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; color:var(--crm-muted-fg); border-bottom:1px solid var(--crm-border);">Deadline</th>
              <th style="padding:0.55rem 1rem; font-size:0.7rem; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; color:var(--crm-muted-fg); border-bottom:1px solid var(--crm-border);">Status</th>
            </tr>
          </thead>
          <tbody>
            <% rdIssues.forEach(t => { %>
              <%
                const overdue = rdIsOverdue(t);
                const sKey = overdue ? 'Overdue' : (t.status || 'To Do');
                const sc = statusColors[sKey] || statusColors['To Do'];
                const itemLink = (typeLinkBase[t._type] || '/tasks/') + t.id;
              %>
              <tr onclick="location.href='<%= itemLink %>'" style="cursor:pointer; border-bottom:1px solid var(--crm-border);" onmouseover="this.style.background='var(--crm-muted)'" onmouseout="this.style.background=''">
                <td style="padding:0.7rem 1rem;">
                  <div style="font-weight:600; color:var(--crm-fg);"><%= t.name %></div>
                  <% if (t.assignees && t.assignees.length) { %>
                    <div style="font-size:0.72rem; color:var(--crm-muted-fg); margin-top:0.15rem;">
                      <i class="bi bi-person"></i> <%= t.assignees.map(a => a.name).join(', ') %>
                    </div>
                  <% } %>
                </td>
                <td style="padding:0.7rem 1rem;">
                  <span style="display:inline-flex; align-items:center; gap:0.25rem; padding:0.15rem 0.45rem; border-radius:6px; font-size:0.68rem; font-weight:700; background:var(--crm-muted); color:var(--crm-muted-fg); border:1px solid var(--crm-border);">
                    <i class="bi <%= typeIcon[t._type] || 'bi-dash' %>"></i> <%= typeLabel[t._type] || '' %>
                  </span>
                </td>
                <td style="padding:0.7rem 1rem; font-size:0.82rem; color:var(--crm-muted-fg);">
                  <% if (t.projectName) { %><i class="bi bi-folder2" style="opacity:0.5;"></i> <%= t.projectName %><% } else { %>—<% } %>
                </td>
                <td style="padding:0.7rem 1rem; font-size:0.82rem; <%= overdue ? 'color:oklch(0.5 0.2 20); font-weight:600;' : 'color:var(--crm-muted-fg);' %>">
                  <%= rdFmtDate(t.deadline) %>
                </td>
                <td style="padding:0.7rem 1rem;">
                  <span style="display:inline-block; padding:0.2rem 0.55rem; border-radius:999px; font-size:0.72rem; font-weight:700; background:<%= sc.bg %>; color:<%= sc.fg %>;"><%= sKey %></span>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span class="dashboard-card-title">Recent comments</span>
        <span class="live-dot ms-2"><span class="dot"></span>Live</span>
      </div>
      <div class="card-body p-0">
        <% if (!recentComments.length) { %>
          <div class="dash-cmt-empty">No comments yet.</div>
        <% } %>
        <% recentComments.forEach(c => { %>
          <div class="dash-cmt-row">
            <div class="dash-cmt-avatar"><%= (c.author || '?').trim().charAt(0).toUpperCase() %></div>
            <div class="dash-cmt-body">
              <div class="dash-cmt-header">
                <span class="dash-cmt-author"><%= c.author || 'Unknown' %></span>
                <span class="dash-cmt-time"><%= c.timeAgo %></span>
              </div>
              <div class="dash-cmt-preview"><%= (c.comment || '').slice(0, 90) %><%= (c.comment || '').length > 90 ? '…' : '' %></div>
              <% if (c.contextLink) { %>
                <a href="<%= c.contextLink %>" class="dash-cmt-context">
                  <i class="bi bi-<%= c.contextType === 'task' ? 'diagram-3' : 'folder2' %>"></i>
                  <%= c.contextLabel %>
                </a>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
</div>

<% } else { %>

<%
  function fmtSalesDate(str) {
    if (!str) return '—';
    const d = new Date(str + 'T00:00:00');
    if (isNaN(d)) return str;
    return d.toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
  }
  const salesToday = new Date(); salesToday.setHours(0,0,0,0);
  function salesDiff(dateStr) {
    if (!dateStr) return null;
    return Math.floor((new Date(dateStr + 'T00:00:00') - salesToday) / 86400000);
  }
%>

<!-- ── Section 1: Header ──────────────────────────────────────────────────── -->
<div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-2">
  <div>
    <div class="text-muted small"><%= new Date().toLocaleDateString(undefined, { weekday: 'long', month: 'long', day: 'numeric' }) %> &middot; Sales Overview</div>
    <h1 class="display-headline mb-0">Sales <em>overview</em></h1>
  </div>
  <a href="/activities/new" class="btn btn-primary btn-sm" style="white-space:nowrap; margin-top:0.6rem; padding:0.45rem 1rem;">
    <i class="bi bi-plus-lg"></i> New Activity
  </a>
</div>

<!-- ── Section 2: KPI Cards ──────────────────────────────────────────────── -->
<div class="row g-3 mb-3">
  <div class="col-6 col-lg-3">
    <a href="/pipeline" class="text-decoration-none">
      <div class="card kpi-card h-100">
        <div class="card-body">
          <div class="kpi-icon kpi-icon-blue"><i class="bi bi-graph-up-arrow"></i></div>
          <div class="kpi-value">$<%= stats.openPipelineTotal.toLocaleString() %></div>
          <div class="kpi-label">Open Pipeline</div>
          <div class="kpi-sub"><%= stats.openDealCount %> active deal<%= stats.openDealCount !== 1 ? 's' : '' %></div>
        </div>
      </div>
    </a>
  </div>
  <div class="col-6 col-lg-3">
    <a href="/pipeline" class="text-decoration-none">
      <div class="card kpi-card h-100">
        <div class="card-body">
          <div class="kpi-icon kpi-icon-purple"><i class="bi bi-briefcase"></i></div>
          <div class="kpi-value"><%= stats.openDealCount %></div>
          <div class="kpi-label">Active Deals</div>
          <div class="kpi-sub"><%= board.filter(b => !b.stage.startsWith('Closed')).length %> pipeline stages</div>
        </div>
      </div>
    </a>
  </div>
  <div class="col-6 col-lg-3">
    <a href="/activities" class="text-decoration-none">
      <div class="card kpi-card h-100<%= overdueCount > 0 ? ' kpi-card-danger' : '' %>">
        <div class="card-body">
          <div class="kpi-icon kpi-icon-<%= overdueCount > 0 ? 'red' : 'gray' %>"><i class="bi bi-exclamation-triangle"></i></div>
          <div class="kpi-value<%= overdueCount > 0 ? ' text-danger' : '' %>"><%= overdueCount %></div>
          <div class="kpi-label">Overdue Follow-ups</div>
          <div class="kpi-sub"><%= overdueCount === 0 ? 'All caught up!' : 'Need attention now' %></div>
        </div>
      </div>
    </a>
  </div>
  <div class="col-6 col-lg-3">
    <a href="/companies" class="text-decoration-none">
      <div class="card kpi-card h-100">
        <div class="card-body">
          <div class="kpi-icon kpi-icon-teal"><i class="bi bi-building"></i></div>
          <div class="kpi-value"><%= stats.companyCount %></div>
          <div class="kpi-label">Companies</div>
          <div class="kpi-sub">Total accounts</div>
        </div>
      </div>
    </a>
  </div>
</div>

<!-- ── Section 3: Needs Attention + Pipeline Summary ─────────────────────── -->
<div class="row g-3 mb-3">
  <div class="col-lg-8">
    <div class="card h-100">
      <div class="card-header d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-2">
          <span class="dashboard-card-title">Needs Attention</span>
          <% if (needsAttention.length) { %>
            <span style="font-size:0.7rem; font-weight:700; padding:0.15rem 0.55rem; border-radius:999px; background:#fbe5e7; color:#c23b4a;"><%= needsAttention.length %></span>
          <% } %>
        </div>
        <a href="/activities" style="font-size:0.78rem; font-weight:600; color:var(--crm-accent); text-decoration:none;">View all <i class="bi bi-arrow-up-right"></i></a>
      </div>
      <div class="card-body p-0">
        <% if (!needsAttention.length) { %>
          <div style="padding:2.5rem; text-align:center; color:var(--crm-muted-fg);">
            <i class="bi bi-check2-circle" style="font-size:2rem; display:block; margin-bottom:0.4rem; color:var(--crm-success);"></i>
            Nothing overdue or due soon — great work!
          </div>
        <% } else { %>
          <% needsAttention.forEach((a, idx) => { %>
            <%
              const diff = salesDiff(a.dueDate);
              const isOD = diff !== null && diff < 0;
              const isTdy = diff === 0;
              let badge = '', bbg = '', bfg = '';
              if (isOD)       { badge = Math.abs(diff) + 'd overdue'; bbg = '#fbe5e7'; bfg = '#c23b4a'; }
              else if (isTdy) { badge = 'Due today';                  bbg = '#fff3cd'; bfg = '#856404'; }
              else if (diff !== null) { badge = 'Due ' + fmtSalesDate(a.dueDate); bbg = '#e7eefc'; bfg = '#2b5fb8'; }
              const barColor = isOD ? '#c23b4a' : isTdy ? '#c8910b' : 'var(--crm-accent)';
            %>
            <div onclick="location.href='/activities/<%= a.id %>'"
              style="display:flex; align-items:center; gap:0.75rem; padding:0.65rem 1rem; border-bottom:<%= idx < needsAttention.length-1 ? '1px solid var(--crm-border)' : 'none' %>; cursor:pointer;"
              onmouseover="this.style.background='var(--crm-muted)'" onmouseout="this.style.background=''">
              <div style="width:3px; align-self:stretch; border-radius:4px; background:<%= barColor %>; flex-shrink:0;"></div>
              <div style="flex:1; min-width:0;">
                <div style="font-weight:600; font-size:0.875rem; color:var(--crm-fg); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"><%= a.name || '(untitled)' %></div>
                <div style="font-size:0.75rem; color:var(--crm-muted-fg); margin-top:0.1rem;">
                  <% if (a.companyNames && a.companyNames.length) { %><i class="bi bi-building" style="opacity:0.55;"></i> <%= a.companyNames[0] %><% if (a.type) { %> &middot; <% } %><% } %><%= a.type || '' %>
                </div>
              </div>
              <% if (badge) { %>
                <span style="display:inline-block; padding:0.18rem 0.6rem; border-radius:999px; font-size:0.7rem; font-weight:700; white-space:nowrap; background:<%= bbg %>; color:<%= bfg %>;"><%= badge %></span>
              <% } %>
            </div>
          <% }) %>
        <% } %>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="card h-100">
      <div class="card-header d-flex justify-content-between align-items-center">
        <div>
          <span class="dashboard-card-title">Pipeline</span>
          <div class="dashboard-card-subtitle">
            <%= board.reduce((s,c) => s+c.deals.length, 0) %> deals &middot; $<%= board.reduce((s,c) => s+c.total, 0).toLocaleString() %>
          </div>
        </div>
        <a href="/pipeline" class="btn btn-sm btn-light-pill">Full view <i class="bi bi-arrow-right"></i></a>
      </div>
      <div class="card-body">
        <% const maxStageTotal = Math.max(1, ...board.map(c => c.total)); %>
        <% board.forEach(col => { %>
          <div class="stage-row">
            <div class="d-flex justify-content-between align-items-center mb-1">
              <div class="d-flex align-items-center">
                <span class="stage-dot stage-dot-<%= col.stage.replace(/\s+/g,'') %>"></span>
                <span class="stage-name"><%= col.stage %></span>
                <span class="stage-count-pill ms-2"><%= col.deals.length %></span>
              </div>
              <div class="stage-total"><%= col.total > 0 ? '$' + col.total.toLocaleString() : '—' %></div>
            </div>
            <div class="stage-track">
              <div class="stage-fill stage-fill-<%= col.stage.replace(/\s+/g,'') %>" style="width:<%= Math.round((col.total/maxStageTotal)*100) %>%"></div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
</div>

<!-- ── Section 4: Recent Activity + Account Updates ──────────────────────── -->
<div class="row g-3">
  <div class="col-lg-8">
    <div class="card h-100">
      <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2">
          <span class="dashboard-card-title">Recent Activity</span>
          <span class="live-dot"><span class="dot"></span>Live</span>
        </div>
        <div class="dash-filter-tabs" id="activityFilterTabs">
          <button class="dash-filter-btn active" data-filter="open">Open</button>
          <button class="dash-filter-btn" data-filter="completed">Completed</button>
          <button class="dash-filter-btn" data-filter="urgent">Urgent</button>
        </div>
      </div>
      <div id="activityList" style="min-height:100px;">
        <div style="padding:1rem 1.25rem; color:var(--crm-muted-fg); font-size:0.875rem;">Loading…</div>
      </div>
      <div style="padding:0.65rem 1rem; border-top:1px solid var(--crm-border);">
        <a href="/activities" class="btn-view-all">View all activity <i class="bi bi-arrow-up-right"></i></a>
      </div>
    </div>
  </div>

  <script>
  (function() {
    var ALL = <%- JSON.stringify(allActivities) %>;
    var today = new Date(); today.setHours(0,0,0,0);

    function fmtDate(str) {
      if (!str) return '';
      var d = new Date(str + 'T00:00:00'); d.setHours(0,0,0,0);
      var diff = Math.floor((d - today) / 86400000);
      if (diff === 0)  return 'Today';
      if (diff === -1) return 'Yesterday';
      return d.toLocaleDateString(undefined, { month:'short', day:'numeric' });
    }
    function isCompleted(a) { return (a.result||'').toLowerCase() === 'completed'; }
    function daysUntilDue(a) {
      if (!a.dueDate) return Infinity;
      return Math.floor((new Date(a.dueDate+'T00:00:00') - today) / 86400000);
    }
    function typeIcon(type) {
      var t = (type||'').toLowerCase();
      if (t.includes('call'))   return 'bi-telephone';
      if (t.includes('email'))  return 'bi-envelope';
      if (t.includes('linkedin')) return 'bi-linkedin';
      if (t.includes('meet')||t.includes('demo')) return 'bi-people';
      return 'bi-clock-history';
    }
    function renderItem(a) {
      var days = daysUntilDue(a);
      var dueHtml = '';
      if (a.dueDate) {
        var cls = days < 0 ? 'due-overdue' : days <= 2 ? 'due-soon' : 'due-ok';
        var lbl = days < 0 ? 'Overdue' : days === 0 ? 'Due today' : fmtDate(a.dueDate);
        dueHtml = '<span class="due-chip '+cls+'">'+lbl+'</span>';
      } else {
        var upd = fmtDate(a.statusDate||a.date);
        dueHtml = upd ? '<span style="font-size:0.72rem; color:var(--crm-muted-fg);">'+upd+'</span>' : '';
      }
      var co = (a.companyNames && a.companyNames.length) ? a.companyNames[0] : '';
      var meta = [co, a.type, a.result].filter(Boolean).join(' · ');
      return '<div style="display:flex;align-items:center;gap:0.65rem;padding:0.6rem 1rem;border-bottom:1px solid var(--crm-border);">' +
        '<i class="bi '+typeIcon(a.type)+'" style="color:var(--crm-accent);font-size:0.95rem;flex-shrink:0;width:18px;text-align:center;"></i>' +
        '<div style="flex:1;min-width:0;">' +
          '<a href="/activities/'+a.id+'" style="font-weight:600;font-size:0.875rem;color:var(--crm-fg);text-decoration:none;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">'+(a.name||'(untitled)')+'</a>' +
          (meta ? '<div style="font-size:0.72rem;color:var(--crm-muted-fg);">'+meta+'</div>' : '') +
        '</div>' +
        '<div style="flex-shrink:0;">'+dueHtml+'</div>' +
      '</div>';
    }
    function render(filter) {
      var list;
      var sortDesc = function(a,b){ return new Date(b.statusDate||b.date||0)-new Date(a.statusDate||a.date||0); };
      if (filter==='open') {
        list = ALL.filter(function(a){ return !isCompleted(a); }).sort(sortDesc).slice(0,12);
      } else if (filter==='completed') {
        list = ALL.filter(function(a){ return isCompleted(a); }).sort(sortDesc).slice(0,12);
      } else {
        list = ALL.filter(function(a){ return !isCompleted(a) && a.dueDate && daysUntilDue(a)<=7; })
          .sort(function(a,b){ return daysUntilDue(a)-daysUntilDue(b); }).slice(0,12);
      }
      var el = document.getElementById('activityList');
      el.innerHTML = list.length
        ? list.map(renderItem).join('')
        : '<div style="padding:2rem;text-align:center;color:var(--crm-muted-fg);font-size:0.875rem;">No activities.</div>';
    }
    document.getElementById('activityFilterTabs').addEventListener('click', function(e) {
      var btn = e.target.closest('.dash-filter-btn');
      if (!btn) return;
      document.querySelectorAll('.dash-filter-btn').forEach(function(b){ b.classList.remove('active'); });
      btn.classList.add('active');
      render(btn.dataset.filter);
    });
    render('open');
  })();
  </script>

  <div class="col-lg-4">
    <div class="card h-100">
      <div class="card-header">
        <span class="dashboard-card-title">Account Updates</span>
        <div class="dashboard-card-subtitle">Latest activity by company</div>
      </div>
      <div class="card-body p-0">
        <% if (!accountUpdates || !accountUpdates.length) { %>
          <div class="dash-cmt-empty">No recent account activity.</div>
        <% } else { %>
          <% accountUpdates.forEach((group, gi) => { %>
            <div style="padding:0.75rem 1rem; border-bottom:<%= gi < accountUpdates.length-1 ? '1px solid var(--crm-border)' : 'none' %>;">
              <a href="/companies/<%= group.companyId %>" style="display:inline-flex; align-items:center; gap:0.3rem; font-size:0.8rem; font-weight:700; color:var(--crm-fg); text-decoration:none; margin-bottom:0.4rem;">
                <i class="bi bi-building" style="color:var(--crm-accent); font-size:0.75rem;"></i>
                <%= group.companyName %>
              </a>
              <% group.comments.forEach(c => { %>
                <div style="display:flex; gap:0.5rem; margin-top:0.3rem;">
                  <div class="dash-cmt-avatar" style="width:22px; height:22px; font-size:0.65rem; flex-shrink:0;"><%= (c.author||'?').trim().charAt(0).toUpperCase() %></div>
                  <div style="flex:1; min-width:0;">
                    <div style="display:flex; align-items:baseline; gap:0.35rem;">
                      <span class="dash-cmt-author"><%= c.author||'Unknown' %></span>
                      <span class="dash-cmt-time"><%= c.timeAgo %></span>
                    </div>
                    <div class="dash-cmt-preview"><%= (c.comment||c.emailSubject||'').slice(0,80) %><%= (c.comment||c.emailSubject||'').length>80?'…':'' %></div>
                    <% if (c.contextLink) { %>
                      <a href="<%= c.contextLink %>" class="dash-cmt-context"><i class="bi bi-clock-history" style="font-size:0.65rem;"></i> <%= c.contextLabel %></a>
                    <% } %>
                  </div>
                </div>
              <% }) %>
            </div>
          <% }) %>
        <% } %>
      </div>
    </div>
  </div>
</div>

<% } %>
