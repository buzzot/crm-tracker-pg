<%
  const v = values || {};
  const me = (typeof currentUser !== 'undefined' && currentUser) || {};
  const preset = companies.find(c => c.id === (v.companyId || presetCompany)) || null;
  const list = x => Array.isArray(x) ? x : x ? [x] : [];
  const pickedProducts = list(v.productIds);
  const status = v.status || 'Active';
  const ownerId = v.ownerId || me.id;
  const backHref = preset ? '/companies/' + preset.id : '/projects';
  const taskRows = list(v.taskName).length ? list(v.taskName).map((n, i) => ({ name: n, due: list(v.taskDue)[i] || '', owner: list(v.taskOwner)[i] || '' })) : [{ name: '', due: '', owner: '' }];
  const STATUS_HINT = { 'Active': 'Work is happening now', 'On Hold': 'Paused, waiting on something', 'Completed': 'Already finished', 'Cancelled': 'Not going ahead' };
%>

<div class="pg npj">
  <nav class="pj-crumbs" aria-label="Breadcrumb">
    <a href="/projects">Projects</a>
    <% if (preset) { %><i class="bi bi-chevron-right" aria-hidden="true"></i><a href="/companies/<%= preset.id %>"><%= preset.name %></a><% } %>
  </nav>
  <h1 class="npj-title">New project</h1>
  <p class="npj-sub">Only the name is required. Add the rest now or later from the project page.</p>

  <% if (error) { %><div class="td-banner td-banner-red"><i class="bi bi-exclamation-circle"></i><span><%= error %></span></div><% } %>

  <form action="/projects" method="POST" enctype="multipart/form-data" id="npjForm" class="npj-card" novalidate>

    <!-- 1. What -->
    <section class="npj-sec">
      <label class="npj-name-label" for="npjName">Project name</label>
      <input type="text" name="name" id="npjName" class="npj-name" value="<%= v.name || '' %>" placeholder="e.g. Rheem heat pump, phase 2" required autofocus autocomplete="off" maxlength="200">
      <p class="npj-err" id="npjNameErr" hidden>Give the project a name.</p>
    </section>

    <!-- 2. Who and where -->
    <section class="npj-sec npj-grid">
      <div class="npj-field npj-span2">
        <label for="npjCompanyInput">Company</label>
        <div class="npj-combo" id="npjCompany">
          <i class="bi bi-building" aria-hidden="true"></i>
          <input type="text" id="npjCompanyInput" placeholder="Search companies…" autocomplete="off" value="<%= preset ? preset.name : '' %>" role="combobox" aria-expanded="false" aria-controls="npjCompanyList">
          <button type="button" class="npj-clear" id="npjCompanyClear" aria-label="Clear company" <%= preset ? '' : 'hidden' %>><i class="bi bi-x"></i></button>
          <input type="hidden" name="companyId" id="npjCompanyId" value="<%= preset ? preset.id : '' %>">
          <ul class="npj-pop" id="npjCompanyList" role="listbox" hidden></ul>
        </div>
        <div class="npj-dupes" id="npjDupes" hidden></div>
      </div>
      <div class="npj-field">
        <label for="npjOwner">Owner</label>
        <select name="ownerId" id="npjOwner">
          <% teamUsers.forEach(u => { %><option value="<%= u.id %>" <%= u.id === ownerId ? 'selected' : '' %>><%= u.name %><%= u.id === me.id ? ' (me)' : '' %></option><% }) %>
        </select>
      </div>
      <div class="npj-field">
        <label for="npjCategory">Type</label>
        <select name="category" id="npjCategory">
          <option value="">Not set</option>
          <% (categoryChoices || []).forEach(c => { %><option value="<%= c %>" <%= v.category === c ? 'selected' : '' %>><%= c %></option><% }) %>
        </select>
      </div>
      <div class="npj-field npj-span2">
        <span class="npj-label">Status</span>
        <div class="npj-seg" role="radiogroup" aria-label="Status">
          <% statusChoices.forEach(s => { %>
            <label class="npj-seg-opt" title="<%= STATUS_HINT[s] || '' %>"><input type="radio" name="status" value="<%= s %>" <%= s === status ? 'checked' : '' %>><span><%= s %></span></label>
          <% }) %>
        </div>
      </div>
      <div class="npj-field">
        <label for="npjStart">Start</label>
        <input type="date" name="startDate" id="npjStart" value="<%= v.startDate || '' %>">
      </div>
      <div class="npj-field">
        <label for="npjEnd">Target finish</label>
        <input type="date" name="endDate" id="npjEnd" value="<%= v.endDate || '' %>">
        <p class="npj-err" id="npjDateErr" hidden>Finish is before start.</p>
      </div>
    </section>

    <!-- 3. Products -->
    <section class="npj-sec">
      <div class="npj-sec-head"><h2>Products</h2><span class="npj-opt">optional</span></div>
      <div class="npj-chips" id="npjPicked"></div>
      <div class="npj-combo npj-combo-sm" id="npjProd">
        <i class="bi bi-search" aria-hidden="true"></i>
        <input type="text" id="npjProdInput" placeholder="Add products: type a name or category" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="npjProdList">
        <ul class="npj-pop" id="npjProdList" role="listbox" hidden></ul>
      </div>
      <div id="npjProdHidden"></div>
    </section>

    <!-- 4. Description -->
    <section class="npj-sec">
      <div class="npj-sec-head"><h2>Brief</h2><span class="npj-opt">optional</span></div>
      <textarea name="description" id="npjDesc" rows="4" maxlength="2000" placeholder="Goal, scope and what the customer needs. The team and the AI email assistant use this."><%= v.description || '' %></textarea>
    </section>

    <!-- 5. First tasks -->
    <section class="npj-sec">
      <div class="npj-sec-head"><h2>First tasks</h2><span class="npj-opt">optional · makes the project trackable from day one</span></div>
      <div class="npj-tasks" id="npjTasks">
        <% taskRows.forEach(t => { %>
          <div class="npj-task">
            <i class="bi bi-circle" aria-hidden="true"></i>
            <input type="text" name="taskName" value="<%= t.name %>" placeholder="e.g. Send quotation" aria-label="Task name">
            <select name="taskOwner" aria-label="Assignee"><option value="">Assignee</option><% teamUsers.forEach(u => { %><option value="<%= u.id %>" <%= t.owner === u.id ? 'selected' : '' %>><%= u.name %></option><% }) %></select>
            <input type="date" name="taskDue" value="<%= t.due %>" aria-label="Due date">
            <button type="button" class="npj-x" data-remove-task aria-label="Remove task"><i class="bi bi-x"></i></button>
          </div>
        <% }) %>
      </div>
      <button type="button" class="pj-link-btn" id="npjAddTask"><i class="bi bi-plus-lg"></i>Add task</button>
    </section>

    <!-- 6. Files -->
    <section class="npj-sec">
      <div class="npj-sec-head"><h2>Files</h2><span class="npj-opt">optional · drawings, specs, RFQs</span></div>
      <label class="td-drop npj-drop" id="npjDrop" for="npjFiles"><i class="bi bi-cloud-arrow-up"></i><span><b>Drop files</b> or <span class="td-browse">browse</span></span></label>
      <input type="file" name="attachments" id="npjFiles" multiple hidden>
      <ul class="npj-files" id="npjFileList"></ul>
    </section>

    <footer class="npj-foot">
      <span class="npj-foot-hint"><kbd>⌘</kbd><kbd>Enter</kbd> to create</span>
      <a href="<%= backHref %>" class="pg-btn">Cancel</a>
      <button type="submit" class="pg-btn pg-btn-primary" id="npjSubmit"><i class="bi bi-check2"></i>Create project</button>
    </footer>
  </form>
</div>

<script>
(function () {
  var COMPANIES = <%- JSON.stringify(companies).replace(/</g, '\\u003c') %>;
  var PRODUCTS = <%- JSON.stringify(products).replace(/</g, '\\u003c') %>;
  var OPEN = <%- JSON.stringify(openProjects).replace(/</g, '\\u003c') %>;
  var picked = <%- JSON.stringify(pickedProducts).replace(/</g, '\\u003c') %>;
  var $ = function (id) { return document.getElementById(id); };
  function esc(t) { return String(t == null ? '' : t).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }

  // Generic combobox
  function combo(input, listEl, source, render, onPick, extra) {
    var active = -1, items = [];
    function close() { listEl.hidden = true; input.setAttribute('aria-expanded', 'false'); active = -1; }
    function draw() {
      var q = input.value.trim().toLowerCase();
      items = source(q);
      var html = items.map(function (it, i) { return '<li role="option" data-i="' + i + '">' + render(it, q) + '</li>'; }).join('');
      var ex = extra ? extra(q, items) : '';
      listEl.innerHTML = html + ex || '<li class="npj-none">No matches</li>';
      listEl.hidden = false; input.setAttribute('aria-expanded', 'true'); active = -1;
    }
    function hl() { listEl.querySelectorAll('li').forEach(function (li, i) { li.classList.toggle('is-active', i === active); }); }
    input.addEventListener('focus', draw);
    input.addEventListener('input', draw);
    input.addEventListener('keydown', function (e) {
      var n = listEl.querySelectorAll('li').length;
      if (e.key === 'ArrowDown') { e.preventDefault(); if (listEl.hidden) draw(); active = Math.min(n - 1, active + 1); hl(); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); active = Math.max(0, active - 1); hl(); }
      else if (e.key === 'Enter') { if (!listEl.hidden) { e.preventDefault(); var li = listEl.querySelectorAll('li')[active < 0 ? 0 : active]; if (li) li.dispatchEvent(new MouseEvent('mousedown', { bubbles: true })); } }
      else if (e.key === 'Escape') close();
    });
    listEl.addEventListener('mousedown', function (e) {
      var li = e.target.closest('li'); if (!li) return; e.preventDefault();
      if (li.dataset.i !== undefined) onPick(items[+li.dataset.i]); else if (li.dataset.action) onPick(null, li.dataset.action);
      close();
    });
    input.addEventListener('blur', function () { setTimeout(close, 120); });
    return { close: close, draw: draw };
  }
  function mark(text, q) {
    if (!q) return esc(text);
    var i = String(text).toLowerCase().indexOf(q);
    return i < 0 ? esc(text) : esc(text.slice(0, i)) + '<b>' + esc(text.slice(i, i + q.length)) + '</b>' + esc(text.slice(i + q.length));
  }

  // Company
  var cInput = $('npjCompanyInput'), cId = $('npjCompanyId'), cClear = $('npjCompanyClear');
  function setCompany(c) {
    cId.value = c ? c.id : ''; cInput.value = c ? c.name : ''; cClear.hidden = !c;
    var dupes = c ? OPEN.filter(function (p) { return p.companyId === c.id; }) : [];
    var box = $('npjDupes');
    if (dupes.length) {
      box.innerHTML = '<i class="bi bi-info-circle"></i><span>' + esc(c.name) + ' already has ' + dupes.length + ' open project' + (dupes.length === 1 ? '' : 's') + ': ' +
        dupes.slice(0, 4).map(function (p) { return '<a href="/projects/' + p.id + '" target="_blank">' + esc(p.name) + '</a>'; }).join(', ') + (dupes.length > 4 ? '…' : '') + '. Check it isn\'t a duplicate.</span>';
      box.hidden = false;
    } else box.hidden = true;
  }
  combo(cInput, $('npjCompanyList'),
    function (q) { return COMPANIES.filter(function (c) { return !q || c.name.toLowerCase().indexOf(q) !== -1; }).slice(0, 40); },
    function (c, q) { return '<i class="bi bi-building"></i>' + mark(c.name, q); },
    function (c, action) { if (action === 'new') { location.href = '/companies/new'; return; } setCompany(c); },
    function (q, items) { return items.length ? '' : '<li data-action="new" class="npj-new"><i class="bi bi-plus-lg"></i>Add a new company</li>'; });
  cClear.addEventListener('click', function () { setCompany(null); cInput.focus(); });
  cInput.addEventListener('change', function () { var m = COMPANIES.find(function (c) { return c.name.toLowerCase() === cInput.value.trim().toLowerCase(); }); if (m) setCompany(m); else if (!cInput.value.trim()) setCompany(null); else if (!cId.value) cInput.value = ''; });
  if (cId.value) setCompany(COMPANIES.find(function (c) { return c.id === cId.value; }) || null);

  // Products
  function drawPicked() {
    $('npjPicked').innerHTML = picked.map(function (id) {
      var p = PRODUCTS.find(function (x) { return x.id === id; }); if (!p) return '';
      return '<span class="npj-chip">' + esc(p.name) + (p.category ? '<small>' + esc(p.category) + '</small>' : '') + '<button type="button" data-unpick="' + esc(id) + '" aria-label="Remove ' + esc(p.name) + '"><i class="bi bi-x"></i></button></span>';
    }).join('');
    $('npjProdHidden').innerHTML = picked.map(function (id) { return '<input type="hidden" name="productIds" value="' + esc(id) + '">'; }).join('');
  }
  $('npjPicked').addEventListener('click', function (e) { var b = e.target.closest('[data-unpick]'); if (!b) return; picked = picked.filter(function (x) { return x !== b.dataset.unpick; }); drawPicked(); });
  var pInput = $('npjProdInput');
  var prodCombo = combo(pInput, $('npjProdList'),
    function (q) { return PRODUCTS.filter(function (p) { return picked.indexOf(p.id) === -1 && (!q || (p.name + ' ' + (p.category || '')).toLowerCase().indexOf(q) !== -1); }).slice(0, 30); },
    function (p, q) { return mark(p.name, q) + (p.category ? '<small>' + esc(p.category) + '</small>' : ''); },
    function (p, action) {
      if (action === 'create') return createProduct(pInput.value.trim());
      picked.push(p.id); pInput.value = ''; drawPicked(); setTimeout(function () { pInput.focus(); }, 0);
    },
    function (q, items) {
      var exact = PRODUCTS.some(function (p) { return p.name.toLowerCase() === q; });
      return q && !exact ? '<li data-action="create" class="npj-new"><i class="bi bi-plus-lg"></i>Create product “' + esc(pInput.value.trim()) + '”</li>' : '';
    });
  function createProduct(name) {
    if (!name) return;
    fetch('/api/products', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name: name }) })
      .then(function (r) { return r.json(); })
      .then(function (d) { if (!d.ok) throw new Error(d.error); PRODUCTS.push({ id: d.product.id, name: d.product.name, category: d.product.category || null }); picked.push(d.product.id); pInput.value = ''; drawPicked(); })
      .catch(function (e) { alert((e && e.message) || 'Could not create the product.'); });
  }
  drawPicked();

  // First tasks
  var tasks = $('npjTasks');
  $('npjAddTask').addEventListener('click', function () {
    var row = tasks.querySelector('.npj-task').cloneNode(true);
    row.querySelectorAll('input').forEach(function (i) { i.value = ''; }); row.querySelector('select').value = '';
    tasks.appendChild(row); row.querySelector('input').focus();
  });
  tasks.addEventListener('click', function (e) {
    var b = e.target.closest('[data-remove-task]'); if (!b) return;
    var rows = tasks.querySelectorAll('.npj-task');
    if (rows.length > 1) b.closest('.npj-task').remove(); else { b.closest('.npj-task').querySelectorAll('input').forEach(function (i) { i.value = ''; }); }
  });
  tasks.addEventListener('keydown', function (e) { if (e.key === 'Enter' && e.target.name === 'taskName') { e.preventDefault(); $('npjAddTask').click(); } });

  // Files
  var fileInput = $('npjFiles'), drop = $('npjDrop'), dt = new DataTransfer();
  function drawFiles() {
    fileInput.files = dt.files;
    $('npjFileList').innerHTML = Array.prototype.map.call(dt.files, function (f, i) {
      return '<li><i class="bi bi-file-earmark"></i><span>' + esc(f.name) + '</span><small>' + Math.max(1, Math.round(f.size / 1024)) + ' KB</small><button type="button" data-rm-file="' + i + '" aria-label="Remove"><i class="bi bi-x"></i></button></li>';
    }).join('');
  }
  function addFiles(list) { Array.prototype.forEach.call(list, function (f) { if (dt.files.length < 10) dt.items.add(f); }); drawFiles(); }
  fileInput.addEventListener('change', function () { var fl = Array.prototype.slice.call(fileInput.files); dt = new DataTransfer(); addFiles(fl); });
  ['dragenter', 'dragover'].forEach(function (ev) { drop.addEventListener(ev, function (e) { e.preventDefault(); drop.classList.add('is-over'); }); });
  ['dragleave', 'drop'].forEach(function (ev) { drop.addEventListener(ev, function (e) { e.preventDefault(); drop.classList.remove('is-over'); }); });
  drop.addEventListener('drop', function (e) { addFiles(e.dataTransfer.files); });
  $('npjFileList').addEventListener('click', function (e) {
    var b = e.target.closest('[data-rm-file]'); if (!b) return;
    var keep = new DataTransfer(); Array.prototype.forEach.call(dt.files, function (f, i) { if (i !== +b.dataset.rmFile) keep.items.add(f); }); dt = keep; drawFiles();
  });

  // Validation + submit
  var form = $('npjForm'), name = $('npjName'), start = $('npjStart'), end = $('npjEnd');
  function datesOk() { var bad = start.value && end.value && start.value > end.value; $('npjDateErr').hidden = !bad; return !bad; }
  start.addEventListener('change', datesOk); end.addEventListener('change', datesOk);
  name.addEventListener('input', function () { if (name.value.trim()) $('npjNameErr').hidden = true; });
  form.addEventListener('submit', function (e) {
    var ok = true;
    if (!name.value.trim()) { $('npjNameErr').hidden = false; name.focus(); ok = false; }
    if (!datesOk()) ok = false;
    if (!ok) { e.preventDefault(); return; }
    $('npjSubmit').disabled = true; $('npjSubmit').innerHTML = '<i class="bi bi-hourglass-split"></i>Creating…';
  });
  document.addEventListener('keydown', function (e) { if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') form.requestSubmit(); });
})();
</script>
