<%
  const _arr = v => [].concat(v || []).map(String);
  const _att = _arr(values.attendeeIds), _prj = _arr(values.projectIds), _par = _arr(values.participantIds);
%>
<div class="al al-form-page">
  <a href="/companies/<%= company.id %>" class="al-back"><i class="bi bi-arrow-left" aria-hidden="true"></i><%= company.name %></a>
  <header class="al-header">
    <div>
      <h1 class="al-title">New activity</h1>
      <p class="al-sub">For <a href="/companies/<%= company.id %>" class="al-co"><%= company.name %></a></p>
    </div>
  </header>

  <% if (error) { %>
    <div class="al-alert" role="alert"><i class="bi bi-exclamation-circle" aria-hidden="true"></i><%= error %></div>
  <% } %>

  <form action="/companies/<%= company.id %>/activities" method="POST" class="al-form">

    <section class="al-fs">
      <h2 class="al-fs-title">Activity</h2>
      <div class="al-field">
        <label for="fName">Title <span class="al-req" aria-hidden="true">*</span></label>
        <input type="text" name="name" id="fName" class="al-input" required minlength="3" maxlength="200"
               value="<%= values.name || '' %>" placeholder="Intro call with plant manager about Q1 order" autofocus>
        <p class="al-hint">Describe what happened or what needs to happen.</p>
      </div>
      <div class="al-row-fields">
        <div class="al-field al-w-sm">
          <label for="fTypeSel">Type</label>
          <select name="type" id="fTypeSel" class="al-input">
            <option value="">Select</option>
            <% typeChoices.forEach(opt => { %><option value="<%= opt %>" <%= values.type === opt ? 'selected' : '' %>><%= opt %></option><% }) %>
          </select>
        </div>
        <div class="al-field al-w-sm">
          <label for="fDue">Follow up by <span class="al-opt">optional</span></label>
          <input type="date" name="dueDate" id="fDue" class="al-input" value="<%= values.dueDate || '' %>">
        </div>
        <div class="al-field al-w-md">
          <label for="fRegarding">Happened at <span class="al-opt">optional</span></label>
          <input type="datetime-local" name="regarding" id="fRegarding" class="al-input" value="<%= values.regarding || '' %>">
        </div>
      </div>
    </section>

    <section class="al-fs">
      <h2 class="al-fs-title">Linked records</h2>

      <fieldset class="al-field">
        <legend>Contacts</legend>
        <% if (persons.length) { %>
          <div class="al-checks">
            <% persons.forEach(p => { %>
              <label class="al-checkpill"><input type="checkbox" name="attendeeIds" value="<%= p.id %>" <%= _att.includes(String(p.id)) ? 'checked' : '' %>><span><%= p.fullName %></span></label>
            <% }) %>
          </div>
        <% } else { %>
          <p class="al-hint">No contacts at <%= company.name %> yet. <a href="/companies/<%= company.id %>/contacts/new" class="al-link-btn">Add a contact</a></p>
        <% } %>
      </fieldset>

      <fieldset class="al-field">
        <legend>Projects</legend>
        <% if (projects.length) { %>
          <div class="al-checks">
            <% projects.forEach(p => { %>
              <label class="al-checkpill"><input type="checkbox" name="projectIds" value="<%= p.id %>" <%= _prj.includes(String(p.id)) ? 'checked' : '' %>><span><%= p.name %></span></label>
            <% }) %>
          </div>
        <% } else { %>
          <p class="al-hint">No projects for this company.</p>
        <% } %>
      </fieldset>

      <% if (typeof teamUsers !== 'undefined' && teamUsers.length) { %>
        <fieldset class="al-field">
          <legend>Share with team <span class="al-opt">they're emailed when it's completed</span></legend>
          <div class="al-checks">
            <% teamUsers.forEach(u => { %>
              <label class="al-checkpill" <% if (u.title) { %>title="<%= u.title %>"<% } %>><input type="checkbox" name="participantIds" value="<%= u.id %>" <%= _par.includes(String(u.id)) ? 'checked' : '' %>><span><%= u.name %></span></label>
            <% }) %>
          </div>
        </fieldset>
      <% } %>
    </section>

    <section class="al-fs">
      <h2 class="al-fs-title">Outcome and notes</h2>
      <div class="al-field al-w-md">
        <label for="fResult">Outcome <span class="al-opt">optional</span></label>
        <select name="result" id="fResult" class="al-input">
          <option value="">No outcome yet</option>
          <% resultChoices.forEach(opt => { %><option value="<%= opt %>" <%= values.result === opt ? 'selected' : '' %>><%= opt %></option><% }) %>
        </select>
        <p class="al-hint">Only "Completed" closes the activity. Other outcomes keep it open.</p>
      </div>
      <div class="al-field">
        <label for="fDetails">Notes</label>
        <textarea name="details" id="fDetails" class="al-input al-textarea" rows="5" placeholder="What was discussed, next steps"><%= values.details || '' %></textarea>
      </div>
    </section>

    <div class="al-form-actions">
      <button type="submit" class="al-btn al-btn-primary"><i class="bi bi-check2" aria-hidden="true"></i>Save activity</button>
      <a href="/companies/<%= company.id %>" class="al-btn">Cancel</a>
    </div>
  </form>
</div>
