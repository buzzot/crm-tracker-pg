<%
  function initials(name) {
    if (!name) return '?';
    const words = name.trim().split(/\s+/);
    if (words.length === 1) return words[0].slice(0, 2).toUpperCase();
    return (words[0][0] + words[1][0]).toUpperCase();
  }
  const AVATAR_COLORS = ['avatar-blue', 'avatar-purple', 'avatar-gold', 'avatar-teal', 'avatar-pink'];
  function avatarColor(i) { return AVATAR_COLORS[i % AVATAR_COLORS.length]; }

  const statusChoices = ['Planned', 'Lead', 'Client'];
  const statusCounts = {};
  statusChoices.forEach(s => { statusCounts[s] = 0; });
  companies.forEach(c => { if (c.status && statusCounts.hasOwnProperty(c.status)) statusCounts[c.status]++; });
%>

<!-- Print-only header (hidden on screen) -->
<div id="print-header">
  <div class="ph-brand">Samyou CRM</div>
  <div class="ph-title">Company Directory</div>
  <div class="ph-meta" id="phMeta">Generated: <span id="phDate"></span> &nbsp;|&nbsp; <span id="phCount"><%= companies.length %></span> companies</div>
  <hr class="ph-rule">
</div>

<div class="companies-page-header">
  <h1 class="companies-page-title">Companies <span class="companies-page-count"><%= companies.length %></span></h1>
  <div style="display:flex; gap:8px; align-items:center;">
    <button onclick="window.print()" class="btn-print-list" title="Print company list">
      <i class="bi bi-printer"></i> Print
    </button>
    <a href="/companies/new" class="btn-add-company">Add Company</a>
  </div>
</div>

<div class="companies-toolbar">
  <div class="status-filter-tabs" id="statusFilterTabs">
    <button type="button" class="filter-tab active" data-status="all">All <span class="filter-tab-count"><%= companies.length %></span></button>
    <% statusChoices.forEach(s => { %>
      <button type="button" class="filter-tab" data-status="<%= s %>"><%= s %> <span class="filter-tab-count"><%= statusCounts[s] %></span></button>
    <% }) %>
  </div>
  <div class="companies-search-wrap">
    <i class="bi bi-search"></i>
    <input type="text" id="companySearch" placeholder="Search companies...">
  </div>
</div>

<div class="companies-table-card">
  <table class="companies-table" id="companiesTable">
    <thead>
      <tr>
        <th>Company</th>
        <th>Industry</th>
        <th>Status</th>
        <th>Website</th>
      </tr>
    </thead>
    <tbody>
      <% companies.forEach((c, i) => { %>
        <tr class="company-row"
          data-status="<%= c.status || '' %>"
          data-search="<%= [c.name, c.industry, c.status, c.web].filter(Boolean).join(' ').toLowerCase() %>"
          onclick="window.location='/companies/<%= c.id %>'">
          <td data-label="Company">
            <div class="company-name-cell">
              <span class="company-avatar <%= avatarColor(i) %>"><%= initials(c.name) %></span>
              <div class="company-name-block">
                <div class="company-name"><%= c.name %></div>
                <div class="company-website-sub"><%= c.web || 'No website on file' %></div>
              </div>
            </div>
          </td>
          <td data-label="Industry">
            <% if (c.industry) { %><span class="industry-tag"><%= c.industry %></span><% } else { %><span class="muted-cell">—</span><% } %>
          </td>
          <td data-label="Status">
            <% if (c.status) { %>
              <span class="badge company-status-<%= c.status.replace(/\s+/g,'') %>"><span class="status-dot"></span><%= c.status %></span>
            <% } else { %><span class="muted-cell">—</span><% } %>
          </td>
          <td data-label="Website">
            <% if (c.web) { %>
              <a href="<%= c.web %>" target="_blank" rel="noopener" class="table-link" onclick="event.stopPropagation()"><%= c.web %> <i class="bi bi-box-arrow-up-right"></i></a>
            <% } else { %><span class="muted-cell">—</span><% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <% if (!companies.length) { %>
    <div class="companies-empty-state">No companies yet.</div>
  <% } %>
</div>

<script>
  (function () {
    const searchInput = document.getElementById('companySearch');
    const tabs = document.querySelectorAll('#statusFilterTabs .filter-tab');
    const rows = document.querySelectorAll('#companiesTable tbody tr');
    let activeStatus = 'all';

    function applyFilters() {
      const q = searchInput.value.toLowerCase();
      rows.forEach((row) => {
        const matchesStatus = activeStatus === 'all' || row.dataset.status === activeStatus;
        const matchesSearch = !q || row.dataset.search.includes(q);
        row.style.display = (matchesStatus && matchesSearch) ? '' : 'none';
      });
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => t.classList.remove('active'));
        tab.classList.add('active');
        activeStatus = tab.dataset.status;
        applyFilters();
      });
    });

    searchInput.addEventListener('input', applyFilters);
  })();

  // Fill print header with current date + visible row count
  document.getElementById('phDate').textContent =
    new Date().toLocaleDateString(undefined, { day: '2-digit', month: 'short', year: 'numeric' });

  window.addEventListener('beforeprint', function () {
    const visible = [...document.querySelectorAll('#companiesTable tbody tr')]
      .filter(r => r.style.display !== 'none').length;
    document.getElementById('phCount').textContent = visible;
  });
</script>

<style>
/* ── Print button (screen only) ── */
.btn-print-list {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 0.45rem 0.9rem;
  border: 1px solid var(--crm-border);
  border-radius: 8px;
  background: var(--crm-muted);
  color: var(--crm-muted-fg);
  font-size: 0.83rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.12s;
}
.btn-print-list:hover { background: var(--crm-fg); color: #fff; border-color: var(--crm-fg); }

/* ── Print-only header (hidden on screen) ── */
#print-header { display: none; }

/* ── Print styles ── */
@media print {
  /* Hide everything that shouldn't print */
  nav, .navbar, .sidebar, header,
  .companies-page-header .btn-add-company,
  .btn-print-list,
  .companies-toolbar,
  .companies-page-header { display: none !important; }

  /* Show print header */
  #print-header {
    display: block !important;
    margin-bottom: 10pt;
    font-family: 'Segoe UI', Arial, sans-serif;
  }
  .ph-brand {
    font-size: 8pt;
    font-weight: 600;
    color: #666;
    text-transform: uppercase;
    letter-spacing: .06em;
  }
  .ph-title {
    font-size: 16pt;
    font-weight: 700;
    color: #1a1a2e;
    margin: 2pt 0 3pt;
  }
  .ph-meta { font-size: 8pt; color: #888; }
  .ph-rule {
    border: none;
    border-top: 2pt solid #1a1a2e;
    margin: 6pt 0 0;
  }

  /* Page setup */
  body { font-size: 8pt; background: #fff !important; color: #1a1a2e !important; }

  /* Clean card */
  .companies-table-card {
    box-shadow: none !important;
    border: none !important;
    border-radius: 0 !important;
  }

  /* Force table back to proper table layout (overrides mobile stacked CSS) */
  .companies-table,
  .companies-table thead,
  .companies-table tbody,
  .companies-table tfoot  { display: table !important; width: 100% !important; }
  .companies-table thead  { display: table-header-group !important; }
  .companies-table tbody  { display: table-row-group !important; }
  .companies-table tr     { display: table-row !important; }
  .companies-table th,
  .companies-table td     { display: table-cell !important; }
  /* Hide data-label pseudo-headers injected by mobile CSS */
  .companies-table td::before { display: none !important; content: none !important; }

  /* Compact fixed-layout table — one tight line per company */
  .companies-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 7.5pt;
    table-layout: fixed;
  }

  /* Column widths */
  .companies-table thead th:nth-child(1) { width: 34%; }  /* Company */
  .companies-table thead th:nth-child(2) { width: 22%; }  /* Industry */
  .companies-table thead th:nth-child(3) { width: 12%; }  /* Status */
  .companies-table thead th:nth-child(4) { width: 32%; }  /* Website */

  .companies-table thead th {
    background: #1a1a2e !important;
    color: #fff !important;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
    padding: 3.5pt 7pt !important;
    font-size: 6.5pt;
    text-transform: uppercase;
    letter-spacing: .06em;
    font-weight: 700;
    border: none !important;
  }

  /* Alternating rows — strong enough to guide the eye */
  .companies-table tbody tr:nth-child(odd)  { background: #fff !important; }
  .companies-table tbody tr:nth-child(even) {
    background: #e8ecf4 !important;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  .companies-table tbody tr:hover { background: inherit !important; }
  .companies-table tbody tr { border-bottom: none !important; cursor: default; page-break-inside: avoid; }

  /* Single tight line per cell */
  .companies-table td {
    padding: 2.5pt 7pt !important;
    vertical-align: middle;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.3;
  }

  /* Company column: hide avatar, show name only */
  .company-avatar    { display: none !important; }
  .company-name-cell { display: block !important; }
  .company-name-block{ display: block !important; }
  .company-name      { font-weight: 700; font-size: 7.5pt; color: #1a1a2e; }
  .company-website-sub { display: none !important; }

  /* Industry */
  .industry-tag { font-size: 7.5pt; background: none !important; padding: 0 !important; border: none !important; color: #333; }
  .muted-cell   { color: #bbb; }

  /* Status badge — text only, no dot, no box */
  .badge        { font-size: 7pt !important; padding: 0 !important; border: none !important;
                  background: none !important; font-weight: 700; }
  .badge.company-status-Client  { color: #15803d !important; }
  .badge.company-status-Lead    { color: #b45309 !important; }
  .badge.company-status-Planned { color: #1d4ed8 !important; }
  .status-dot   { display: none !important; }

  /* Website — plain text, no icon */
  .table-link { font-size: 7pt; color: #555 !important; text-decoration: none !important; }
  .table-link .bi-box-arrow-up-right { display: none !important; }
}
</style>
