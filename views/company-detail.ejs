<%
  // ── Helpers ────────────────────────────────────────────────────────────────
  function d(v) { if (!v) return null; const x = v instanceof Date ? v : new Date(String(v).length <= 10 ? v + 'T00:00:00' : v); return isNaN(x) ? null : x; }
  function fmt(v) { const x = d(v); return x ? x.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : null; }
  function fmtShort(v) { const x = d(v); if (!x) return null; return x.toLocaleDateString('en-US', x.getFullYear() === new Date().getFullYear() ? { month: 'short', day: 'numeric' } : { month: 'short', day: 'numeric', year: 'numeric' }); }
  const today = new Date(); today.setHours(0, 0, 0, 0);
  function daysTo(v) { const x = d(v); if (!x) return null; x.setHours(0, 0, 0, 0); return Math.round((x - today) / 86400000); }
  function money(n) { n = Number(n) || 0; return n >= 1e6 ? '$' + (n / 1e6).toFixed(1).replace(/\.0$/, '') + 'M' : n >= 1e4 ? '$' + Math.round(n / 1e3) + 'K' : '$' + n.toLocaleString('en-US'); }
  function initial(n) { return (n || '?').trim().charAt(0).toUpperCase(); }
  const typeIcon = { Call: 'bi-telephone', Email: 'bi-envelope', LinkedIn: 'bi-linkedin', Meeting: 'bi-people', Demo: 'bi-easel' };

  // ── Deals ──────────────────────────────────────────────────────────────────
  const isClosed = (dl) => String(dl.stage || '').startsWith('Closed');
  const openDeals = deals.filter(dl => !isClosed(dl));
  const pipelineValue = openDeals.filter(dl => dl.amountSet !== false).reduce((s, dl) => s + (dl.amount || 0), 0);
  const noValue = openDeals.filter(dl => dl.amountSet === false).length;
  const wonDeals = deals.filter(dl => dl.stage === 'Closed Won');
  const sortedDeals = deals.slice().sort((a, b) => (isClosed(a) - isClosed(b)) || ((b.amount || 0) - (a.amount || 0)));
  const stageCls = s => ({ 'Closed Won': 'done', 'Closed Lost': 'cancelled', 'Negotiation': 'hold', 'Proposal / Price Quote': 'hold' }[s] || 'active');

  // ── Projects ───────────────────────────────────────────────────────────────
  const isActiveProject = p => !['Completed', 'Cancelled'].includes(p.status);
  const activeProjects = projects.filter(isActiveProject);
  const sortedProjects = projects.slice().sort((a, b) => (isActiveProject(b) - isActiveProject(a)) || String(a.endDate || '9999').localeCompare(String(b.endDate || '9999')));
  const projCls = s => ({ 'Active': 'active', 'On Hold': 'hold', 'Completed': 'done', 'Cancelled': 'cancelled' }[s] || 'none');

  // ── Activities: last touch + next follow-up ────────────────────────────────
  const when = a => a.statusDate || a.date || (a.createdAt ? new Date(a.createdAt).toISOString().slice(0, 10) : '');
  const sortedActs = activities.slice().sort((a, b) => String(when(b)).localeCompare(String(when(a))));
  const lastAct = sortedActs[0] || null;
  const daysSince = lastAct ? -daysTo(when(lastAct)) : null;
  const openActs = activities.filter(a => a.result !== 'Completed');
  const nextFollow = openActs.filter(a => a.dueDate).sort((a, b) => String(a.dueDate).localeCompare(String(b.dueDate)))[0] || null;
  const nextDays = nextFollow ? daysTo(nextFollow.dueDate) : null;
  function dueText(a) {
    if (a.result === 'Completed') return { text: 'Done', cls: 'is-done' };
    const n = daysTo(a.dueDate);
    if (n === null) return { text: '', cls: '' };
    if (n < 0) return { text: (-n) + 'd overdue', cls: 'is-overdue' };
    if (n === 0) return { text: 'Due today', cls: 'is-today' };
    return { text: 'Due ' + fmtShort(a.dueDate), cls: '' };
  }
  const ACT_LIMIT = 8;

  // ── Emails ─────────────────────────────────────────────────────────────────
  const _threads = typeof emailThreads !== 'undefined' ? emailThreads : [];
  const _track = typeof trackingAddress !== 'undefined' ? trackingAddress : null;
  const _mbReady = typeof mailboxReady !== 'undefined' && mailboxReady;
  const tCount = { all: _threads.length, reply: _threads.filter(t => t.state === 'reply').length, waiting: _threads.filter(t => t.state === 'waiting').length, draft: _threads.filter(t => t.state === 'draft' || t.drafts).length };
  function who(addr) { const m = String(addr || '').match(/^\s*"?([^"<]*?)"?\s*<([^>]+)>/); return m ? (m[1].trim() || m[2]) : String(addr || '').split(',')[0].trim(); }
  function ago(v) { const x = d(v); if (!x) return ''; const s = Math.floor((Date.now() - x) / 1000); if (s < 3600) return Math.max(1, Math.floor(s / 60)) + 'm ago'; if (s < 86400) return Math.floor(s / 3600) + 'h ago'; if (s < 86400 * 7) return Math.floor(s / 86400) + 'd ago'; return fmtShort(v); }
  const stateLabel = { reply: 'Needs reply', waiting: 'Awaiting them', draft: 'Draft', quiet: 'Quiet' };
  const statusCls = { 'Client': 'done', 'Prospect': 'active', 'Partner': 'active', 'Active': 'active', 'Inactive': 'cancelled', 'Planned': 'hold', 'Lead': 'hold' }[company.status] || 'none';
  const webHost = company.web ? String(company.web).replace(/^https?:\/\//, '').replace(/\/$/, '') : null;
%>

<div class="pg pj co">

  <nav class="pj-crumbs" aria-label="Breadcrumb">
    <a href="/companies">Companies</a>
    <% if (company.status) { %><i class="bi bi-chevron-right" aria-hidden="true"></i><a href="/companies"><%= company.status %></a><% } %>
  </nav>

  <!-- ── Header ─────────────────────────────────────────────────────────── -->
  <header class="pj-head">
    <div class="co-id">
      <% if (company.logo) { %>
        <span class="co-logo"><img src="<%= company.logo %>" alt="" onerror="this.parentNode.classList.add('is-fallback');this.remove();"><span class="co-logo-fb"><%= initial(company.name) %></span></span>
      <% } else { %>
        <span class="co-logo is-fallback"><span class="co-logo-fb"><%= initial(company.name) %></span></span>
      <% } %>
      <div class="pj-head-main">
        <h1 class="pj-title"><%= company.name %></h1>
        <div class="pj-meta">
          <% if (company.status) { %><span class="pj-status pj-status-<%= statusCls %>"><span class="pj-dot" aria-hidden="true"></span><%= company.status %></span><% } %>
          <% if (company.industry) { %><span class="pj-meta-item"><i class="bi bi-tag" aria-hidden="true"></i><%= company.industry %></span><% } %>
          <% if (webHost) { %><a class="pj-meta-item" href="<%= company.web %>" target="_blank" rel="noopener"><i class="bi bi-globe2" aria-hidden="true"></i><%= webHost %></a><% } %>
          <% if (company.ownerName) { %><span class="pj-meta-item"><span class="pj-av pj-av-xs" style="background:oklch(0.52 0.18 250)"><%= initial(company.ownerName) %></span><%= company.ownerName %></span><% } %>
        </div>
      </div>
    </div>
    <div class="pj-head-actions">
      <button type="button" class="pg-btn ce-ai-btn" data-compose><i class="bi bi-stars" aria-hidden="true"></i>Draft email</button>
      <a href="/companies/<%= company.id %>/activities/new" class="pg-btn"><i class="bi bi-journal-plus" aria-hidden="true"></i>Log activity</a>
      <a href="/companies/<%= company.id %>/edit" class="pg-btn"><i class="bi bi-pencil" aria-hidden="true"></i>Edit</a>
      <div class="dropdown">
        <button type="button" class="pg-btn pg-btn-primary" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-plus-lg" aria-hidden="true"></i>New<i class="bi bi-chevron-down tn-caret" aria-hidden="true"></i></button>
        <ul class="dropdown-menu dropdown-menu-end tn-menu">
          <li><a class="dropdown-item" href="/companies/<%= company.id %>/projects/new"><i class="bi bi-folder2"></i>Project</a></li>
          <li><a class="dropdown-item" href="/companies/<%= company.id %>/deals/new"><i class="bi bi-briefcase"></i>Deal</a></li>
          <li><a class="dropdown-item" href="/companies/<%= company.id %>/contacts/new"><i class="bi bi-person-plus"></i>Contact</a></li>
          <li><a class="dropdown-item" href="/companies/<%= company.id %>/activities/new"><i class="bi bi-journal-plus"></i>Activity</a></li>
        </ul>
      </div>
    </div>
  </header>

  <!-- ── Account health strip ───────────────────────────────────────────── -->
  <section class="pj-strip" aria-label="Account overview">
    <div class="pj-stat">
      <div class="pj-stat-label">Open pipeline</div>
      <div class="pj-stat-value"><%= money(pipelineValue) %></div>
      <div class="pj-stat-sub"><%= openDeals.length %> open deal<%= openDeals.length === 1 ? '' : 's' %><% if (noValue) { %> &middot; <%= noValue %> without value<% } %><% if (wonDeals.length) { %> &middot; <%= wonDeals.length %> won<% } %></div>
    </div>
    <div class="pj-stat">
      <div class="pj-stat-label">Projects</div>
      <div class="pj-stat-value"><%= activeProjects.length %><span> active</span></div>
      <div class="pj-stat-sub"><%= projects.length %> total</div>
    </div>
    <div class="pj-stat <%= daysSince !== null && daysSince > 30 ? 'is-alert' : '' %>">
      <div class="pj-stat-label">Last contact</div>
      <% if (lastAct) { %>
        <div class="pj-stat-value pj-stat-small"><%= daysSince <= 0 ? 'Today' : daysSince === 1 ? 'Yesterday' : daysSince + ' days ago' %></div>
        <a class="pj-stat-sub" href="/activities/<%= lastAct.id %>" title="<%= lastAct.name %>"><%= daysSince > 30 ? 'Going quiet · ' : '' %><%= lastAct.name || '(untitled)' %></a>
      <% } else { %>
        <div class="pj-stat-value pj-muted">Never</div><div class="pj-stat-sub">No activity logged yet</div>
      <% } %>
    </div>
    <div class="pj-stat <%= nextDays !== null && nextDays < 0 ? 'is-alert' : '' %>">
      <div class="pj-stat-label">Next follow-up</div>
      <% if (nextFollow) { %>
        <div class="pj-stat-value pj-stat-small pj-stat-due <%= nextDays < 0 ? 'is-overdue' : nextDays === 0 ? 'is-today' : '' %>"><%= nextDays < 0 ? (-nextDays) + 'd overdue' : nextDays === 0 ? 'Today' : fmtShort(nextFollow.dueDate) %></div>
        <a class="pj-stat-sub" href="/activities/<%= nextFollow.id %>" title="<%= nextFollow.name %>"><%= nextFollow.name || '(untitled)' %></a>
      <% } else { %>
        <div class="pj-stat-value pj-muted">None</div><div class="pj-stat-sub"><a href="/companies/<%= company.id %>/activities/new" class="pj-link-btn">Schedule one</a></div>
      <% } %>
    </div>
  </section>

  <div class="pj-grid">
    <!-- ── Main column ─────────────────────────────────────────────────── -->
    <div class="pj-main">

      <!-- Emails -->
      <section class="pj-card" id="emails" aria-labelledby="coMailTitle">
        <div class="pj-card-head">
          <div>
            <h2 class="pj-card-title" id="coMailTitle">Emails <span class="pj-n"><%= _threads.length %> conversation<%= _threads.length === 1 ? '' : 's' %></span></h2>
            <p class="pj-card-sub"><% if (_track) { %>Replies to <code class="ce-code"><%= _track %></code> are logged here automatically<% } else { %>Email log<% } %></p>
          </div>
          <div class="pj-card-actions"><button type="button" class="pj-link-btn ce-ai-link" data-compose><i class="bi bi-stars" aria-hidden="true"></i>Draft email</button></div>
        </div>
        <% if (typeof emailError !== 'undefined' && emailError) { %>
          <p class="pj-hint"><%= emailError %></p>
        <% } else if (!_threads.length) { %>
          <div class="pj-empty pj-empty-sm"><div>No emails with <%= company.name %> yet. <button type="button" class="pj-link-btn" data-compose>Draft the first one with AI</button></div></div>
        <% } else { %>
          <div class="ce-filter">
            <div class="ce-seg" role="tablist" aria-label="Filter conversations">
              <button type="button" class="is-on" data-ef="all" role="tab" aria-selected="true">All <span><%= tCount.all %></span></button>
              <button type="button" data-ef="reply" role="tab" aria-selected="false">Needs reply <span class="<%= tCount.reply ? 'ce-red' : '' %>"><%= tCount.reply %></span></button>
              <button type="button" data-ef="waiting" role="tab" aria-selected="false">Awaiting them <span><%= tCount.waiting %></span></button>
              <button type="button" data-ef="draft" role="tab" aria-selected="false">Drafts <span><%= tCount.draft %></span></button>
            </div>
            <label class="ce-search"><i class="bi bi-search" aria-hidden="true"></i><input type="search" id="ceSearch" placeholder="Search subject, person or text" aria-label="Search emails"></label>
          </div>
          <ul class="ce-threads" id="ceThreads">
            <% _threads.forEach(t => {
                 const last = t.last || t.messages[t.messages.length - 1];
                 const draft = t.messages.find(m => m.status === 'draft' || m.status === 'failed');
                 const searchText = [t.subject, t.people.join(' '), t.messages.map(m => m.from + ' ' + m.to + ' ' + String(m.body).slice(0, 300)).join(' ')].join(' ').toLowerCase(); %>
              <li class="ce-th ce-th-<%= t.state %>" tabindex="0" role="button" data-key="<%= t.key %>" data-state="<%= t.state %>" data-has-draft="<%= t.drafts ? 1 : 0 %>" <% if (t.state === 'draft' && draft) { %>data-draft="<%= draft.id %>"<% } %> data-search="<%= searchText %>">
                <span class="ce-state ce-st-<%= t.state %>"><%= stateLabel[t.state] %></span>
                <span class="ce-th-main">
                  <span class="ce-th-top"><b><%= t.subject %></b><% if (t.projectName) { %><span class="ce-chip"><%= t.projectName %></span><% } %><% if (t.hasFailed) { %><span class="ce-chip ce-chip-red">Not sent</span><% } else if (t.drafts && t.state !== 'draft') { %><span class="ce-chip ce-chip-ai">Draft reply</span><% } %></span>
                  <span class="ce-th-snip"><% if (last) { %><b><%= last.direction === 'out' ? 'You' : who(last.from) %>:</b> <%= String(last.body || '').replace(/\s+/g, ' ').slice(0, 160) %><% } %></span>
                </span>
                <span class="ce-th-right">
                  <span><%= ago(t.lastAt) %></span>
                  <span class="ce-th-n"><%= t.count %> <i class="bi bi-envelope" aria-hidden="true"></i></span>
                </span>
              </li>
            <% }) %>
          </ul>
          <p class="pj-hint ce-none" id="ceNone" hidden>No conversations match.</p>
        <% } %>
      </section>

      <!-- Projects -->
      <section class="pj-card" aria-labelledby="coProjTitle">
        <div class="pj-card-head">
          <div>
            <h2 class="pj-card-title" id="coProjTitle">Projects <span class="pj-n"><%= projects.length %></span></h2>
            <p class="pj-card-sub"><%= activeProjects.length %> active</p>
          </div>
          <div class="pj-card-actions"><a href="/companies/<%= company.id %>/projects/new" class="pj-link-btn"><i class="bi bi-plus-lg" aria-hidden="true"></i>New project</a></div>
        </div>
        <% if (!projects.length) { %>
          <div class="pj-empty pj-empty-sm"><div>No projects with <%= company.name %> yet.</div></div>
        <% } else { %>
          <ul class="co-list">
            <% sortedProjects.forEach(p => { const end = d(p.endDate); const n = daysTo(p.endDate); %>
              <li class="co-row <%= isActiveProject(p) ? '' : 'is-muted' %>">
                <span class="pj-status pj-status-<%= projCls(p.status) %> co-row-status"><span class="pj-dot" aria-hidden="true"></span><%= p.status || 'No status' %></span>
                <a href="/projects/<%= p.id %>" class="co-row-name" title="<%= p.name %>"><%= p.name %></a>
                <span class="co-row-meta <%= isActiveProject(p) && n !== null && n < 0 ? 'pj-red' : '' %>">
                  <% if (end) { %><%= isActiveProject(p) && n < 0 ? 'Ended ' : 'Ends ' %><%= fmtShort(p.endDate) %><% } else if (p.startDate) { %>Started <%= fmtShort(p.startDate) %><% } else { %><span class="pj-muted">No dates</span><% } %>
                </span>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </section>

      <!-- Activity -->
      <section class="pj-card" aria-labelledby="coActTitle">
        <div class="pj-card-head">
          <div>
            <h2 class="pj-card-title" id="coActTitle">Activity <span class="pj-n"><%= activities.length %></span></h2>
            <p class="pj-card-sub"><%= openActs.length %> open follow-up<%= openActs.length === 1 ? '' : 's' %></p>
          </div>
          <div class="pj-card-actions">
            <% if (activities.length > ACT_LIMIT) { %><a href="/activities?tab=all&company=<%= company.id %>" class="pj-link-btn">View all</a><% } %>
            <a href="/companies/<%= company.id %>/activities/new" class="pj-link-btn"><i class="bi bi-plus-lg" aria-hidden="true"></i>Log activity</a>
          </div>
        </div>
        <% if (!activities.length) { %>
          <div class="pj-empty pj-empty-sm"><div>No calls, emails or meetings logged yet.</div></div>
        <% } else { %>
          <ul class="co-list co-acts">
            <% sortedActs.slice(0, ACT_LIMIT).forEach(a => { const dt = dueText(a); %>
              <li class="co-row">
                <span class="co-act-icon"><i class="bi <%= typeIcon[a.type] || 'bi-clock-history' %>" aria-hidden="true"></i></span>
                <span class="co-act-main">
                  <a href="/activities/<%= a.id %>" class="co-row-name" title="<%= a.name %>"><%= a.name || '(untitled)' %></a>
                  <span class="co-act-sub"><%= [a.type, a.result].filter(Boolean).join(' · ') || 'No outcome yet' %></span>
                </span>
                <span class="co-act-right">
                  <span class="co-act-date"><%= fmtShort(when(a)) || '' %></span>
                  <% if (dt.text) { %><span class="pj-task-due <%= dt.cls %>"><%= dt.text %></span><% } %>
                </span>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </section>

      <!-- Deals -->
      <section class="pj-card" aria-labelledby="coDealTitle">
        <div class="pj-card-head">
          <div>
            <h2 class="pj-card-title" id="coDealTitle">Deals <span class="pj-n"><%= deals.length %></span></h2>
            <p class="pj-card-sub"><%= money(pipelineValue) %> open<% if (wonDeals.length) { %> &middot; <%= money(wonDeals.reduce((s, x) => s + (x.amount || 0), 0)) %> won<% } %></p>
          </div>
          <div class="pj-card-actions"><a href="/companies/<%= company.id %>/deals/new" class="pj-link-btn"><i class="bi bi-plus-lg" aria-hidden="true"></i>New deal</a></div>
        </div>
        <% if (!deals.length) { %>
          <div class="pj-empty pj-empty-sm"><div>No deals yet.</div></div>
        <% } else { %>
          <ul class="co-list">
            <% sortedDeals.forEach(dl => { %>
              <li class="co-row <%= isClosed(dl) ? 'is-muted' : '' %>">
                <span class="pj-status pj-status-<%= stageCls(dl.stage) %> co-row-status" title="<%= dl.stage || '' %>"><span class="pj-dot" aria-hidden="true"></span><%= ({ 'Proposal / Price Quote': 'Proposal', 'Needs Analysis': 'Needs analysis' })[dl.stage] || dl.stage || 'No stage' %></span>
                <a href="/deals/<%= dl.id %>" class="co-row-name" title="<%= dl.name %>"><%= dl.name %></a>
                <span class="co-row-amount"><%= dl.amountSet === false ? '' : '$' + (dl.amount || 0).toLocaleString('en-US') %><% if (dl.amountSet === false) { %><span class="pj-muted">No value</span><% } %></span>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </section>
    </div>

    <!-- ── Sidebar ─────────────────────────────────────────────────────── -->
    <aside class="pj-side">

      <section class="pj-card pj-side-card" aria-labelledby="coPeopleTitle">
        <div class="co-side-head">
          <h2 class="pj-side-title" id="coPeopleTitle">Contacts <span class="pj-n"><%= contacts.length %></span></h2>
          <a href="/companies/<%= company.id %>/contacts/new" class="pj-link-btn"><i class="bi bi-plus-lg" aria-hidden="true"></i>Add</a>
        </div>
        <% if (!contacts.length) { %>
          <p class="pj-hint">No contacts yet. Add the people you work with at <%= company.name %>.</p>
        <% } else { %>
          <ul class="co-contacts">
            <% contacts.forEach(p => { %>
              <li class="co-contact <%= p.status === 'Left' ? 'is-left' : '' %>">
                <span class="pj-av" style="background:oklch(0.55 0.04 260)"><%= initial(p.fullName) %></span>
                <span class="co-contact-main">
                  <a href="/contacts/<%= p.id %>" class="co-contact-name"><%= p.fullName %><% if (p.status === 'Left') { %> <span class="pj-muted">(left)</span><% } %></a>
                  <% if (p.title) { %><span class="co-contact-title" title="<%= p.title %>"><%= p.title %></span><% } %>
                  <span class="co-contact-reach">
                    <% if (p.email) { %><a href="mailto:<%= p.email %>" title="<%= p.email %>"><i class="bi bi-envelope" aria-hidden="true"></i><span><%= p.email %></span></a><% } %>
                    <% if (p.email && p.status !== 'Left') { %><button type="button" class="ce-contact-ai" data-compose data-to="<%= p.fullName %> <<%= p.email %>>"><i class="bi bi-stars" aria-hidden="true"></i>Email with AI</button><% } %>
                    <% if (p.phone) { %><a href="tel:<%= String(p.phone).replace(/[^\d+]/g, '') %>"><i class="bi bi-telephone" aria-hidden="true"></i><span><%= p.phone %></span></a><% } %>
                  </span>
                </span>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </section>

      <section class="pj-card pj-side-card" aria-labelledby="coDetailsTitle">
        <h2 class="pj-side-title" id="coDetailsTitle">Details</h2>
        <dl class="pj-dl">
          <dt>Industry</dt><dd><%= company.industry || '—' %></dd>
          <dt>Status</dt><dd><%= company.status || '—' %></dd>
          <dt>Website</dt><dd><% if (company.web) { %><a href="<%= company.web %>" target="_blank" rel="noopener"><%= webHost %></a><% } else { %>—<% } %></dd>
          <dt>Billing</dt><dd><%= company.billingAddress || '—' %></dd>
          <% if (company.ownerName) { %><dt>Owner</dt><dd><%= company.ownerName %></dd><% } %>
          <% if (company.groupName) { %><dt>Team</dt><dd><%= company.groupName %></dd><% } %>
          <dt>Created</dt><dd><%= fmt(company.createdAt) || '—' %><% if (company.createdByName) { %> <span class="pj-muted">by <%= company.createdByName %></span><% } %></dd>
          <% if (company.updatedAt && company.updatedByName) { %><dt>Last edited</dt><dd><%= fmt(company.updatedAt) %> <span class="pj-muted">by <%= company.updatedByName %></span></dd><% } %>
        </dl>
      </section>

      <% if (company.notes) { %>
        <section class="pj-card pj-side-card" aria-labelledby="coNotesTitle">
          <h2 class="pj-side-title" id="coNotesTitle">Notes</h2>
          <div class="co-notes"><%= company.notes %></div>
        </section>
      <% } %>

      <section class="pj-card pj-side-card" aria-labelledby="coFilesTitle">
        <h2 class="pj-side-title" id="coFilesTitle">Documents <span class="pj-n"><%= (attachments || []).length %></span></h2>
        <% if (attachments && attachments.length) { %>
          <ul class="pj-files">
            <% attachments.forEach(f => {
                 const ext = (f.filename || '').split('.').pop().toLowerCase();
                 const ic = { pdf: 'bi-file-earmark-pdf', doc: 'bi-file-earmark-word', docx: 'bi-file-earmark-word', xls: 'bi-file-earmark-excel', xlsx: 'bi-file-earmark-excel', csv: 'bi-file-earmark-excel', png: 'bi-file-earmark-image', jpg: 'bi-file-earmark-image', jpeg: 'bi-file-earmark-image', gif: 'bi-file-earmark-image', zip: 'bi-file-earmark-zip' }[ext] || 'bi-file-earmark'; %>
              <li><a href="<%= f.url %>" target="_blank" rel="noopener"><i class="bi <%= ic %>" aria-hidden="true"></i><span><%= f.filename %></span><% if (f.sizeBytes) { %><span class="pj-muted co-file-size"><%= f.sizeBytes >= 1048576 ? (f.sizeBytes / 1048576).toFixed(1) + ' MB' : Math.max(1, Math.round(f.sizeBytes / 1024)) + ' KB' %></span><% } %></a></li>
            <% }) %>
          </ul>
        <% } %>
        <form action="/companies/<%= company.id %>/attachments" method="POST" enctype="multipart/form-data" class="pj-upload" id="coUpload">
          <input type="file" name="attachments" id="coAttachInput" multiple required hidden>
          <label for="coAttachInput" class="pj-drop" id="coDrop">
            <i class="bi bi-cloud-arrow-up" aria-hidden="true"></i>
            <span id="coAttachLabel"><strong>Drop files</strong> or click to choose</span>
          </label>
          <button type="submit" class="pg-btn pg-btn-primary" id="coUploadBtn" hidden><i class="bi bi-upload" aria-hidden="true"></i>Upload</button>
        </form>
      </section>
    </aside>
  </div>
</div>

<!-- ── AI email composer ─────────────────────────────────────────────── -->
<dialog class="ce-dialog" id="ceDialog" aria-labelledby="ceTitle">
  <div class="ce-head">
    <h3 id="ceTitle"><i class="bi bi-envelope" aria-hidden="true"></i>New email · <%= company.name %></h3>
    <span class="ce-saved" id="ceSaved"></span>
    <button type="button" class="pj-copy-btn" data-ce-close aria-label="Close"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
  </div>
  <div class="ce-body">
    <!-- AI side -->
    <div class="ce-ai" id="ceAi">
      <div class="ce-ai-title"><i class="bi bi-stars" aria-hidden="true"></i>AI assistant</div>
      <div class="ce-stage" id="ceStage"><span class="ce-stage-dot"></span><div><b id="ceStageTitle">Checking the conversation…</b><span id="ceStageText"></span></div></div>

      <span class="ce-lbl">Goal</span>
      <div class="ce-chips" id="ceGoals" role="radiogroup" aria-label="Goal">
        <button type="button" data-goal="introduce" class="is-on">Introduce Samyou</button>
        <button type="button" data-goal="meeting">Request meeting</button>
        <button type="button" data-goal="quote">Quote</button>
        <button type="button" data-goal="follow_up">Follow up</button>
        <button type="button" data-goal="re_engage">Re-engage</button>
        <button type="button" data-goal="answer" hidden>Answer their questions</button>
      </div>

      <label class="ce-lbl" for="ceInstr">What should it say? <span class="pj-muted">optional</span></label>
      <textarea id="ceInstr" class="mm-input ce-instr" rows="3" placeholder="e.g. Mention we can ship BDQ50 samples in December and ask for their 2027 volumes"></textarea>

      <div class="ce-row2">
        <label><span class="ce-lbl">Tone</span><select id="ceTone" class="pj-select"><option value="professional and warm">Professional, warm</option><option value="formal">Formal</option><option value="friendly and brief">Friendly, brief</option><option value="direct">Direct</option></select></label>
        <label><span class="ce-lbl">Language</span><select id="ceLang" class="pj-select"><option value="en">English</option><option value="zh">中文</option></select></label>
      </div>

      <div class="ce-research" id="ceResearchBox">
        <div class="ce-lbl ce-lbl-row"><span>Research <span class="pj-muted" id="ceResearchAge"></span></span><button type="button" class="pj-link-btn" id="ceResearchBtn"><i class="bi bi-globe2" aria-hidden="true"></i>Research <%= company.name %></button></div>
        <ul class="ce-research-list" id="ceResearchList"><li class="pj-hint">Recent news about the company that the email could mention. Tick what to use.</li></ul>
      </div>

      <div class="ce-ai-actions">
        <button type="button" class="pg-btn pg-btn-primary" id="ceWrite"><i class="bi bi-stars" aria-hidden="true"></i>Write draft</button>
        <span class="ce-revise" id="ceRevise" hidden>
          <button type="button" class="pg-btn" data-revise="Make it shorter (under 100 words).">Shorter</button>
          <button type="button" class="pg-btn" data-revise="Make it more formal.">More formal</button>
          <button type="button" class="pg-btn" data-revise="Make it warmer and friendlier.">Friendlier</button>
        </span>
      </div>
      <p class="ce-ai-msg" id="ceAiMsg" role="status" aria-live="polite"></p>
      <p class="pj-hint">AI can be wrong. Check facts, and fill in anything in [brackets] before sending.</p>
    </div>

    <!-- Email side -->
    <form class="ce-mail" id="ceForm" autocomplete="off">
      <input type="hidden" name="id" id="ceId">
      <input type="hidden" name="inReplyTo" id="ceReplyTo">
      <div class="ce-f"><span>From</span><span id="ceFrom" class="ce-from"></span></div>
      <div class="ce-f"><label for="ceTo">To</label><input id="ceTo" name="to" class="ce-input" list="ceContacts" placeholder="Name <email@company.com>, separate several with commas" required></div>
      <datalist id="ceContacts"></datalist>
      <div class="ce-f"><label for="ceCc">Cc</label><span class="ce-lock" id="ceLock" title="Added automatically so replies are logged in the CRM"><i class="bi bi-lock-fill" aria-hidden="true"></i><span id="ceTrack"><%= _track || '' %></span></span><input id="ceCc" name="cc" class="ce-input" placeholder="Add more"></div>
      <div class="ce-f"><label for="ceSubject">Subject</label><input id="ceSubject" name="subject" class="ce-input ce-subject" required></div>
      <div class="ce-f"><label for="ceProject">Project</label><select id="ceProject" name="projectId" class="pj-select ce-proj"><option value="">Not linked</option></select></div>
      <div class="ce-editor-wrap">
        <textarea id="ceBodyText" name="body" class="ce-editor" placeholder="Write your email, or let the AI draft it."></textarea>
        <div class="ce-sig" id="ceSig" hidden></div>
        <ul class="ce-gaps" id="ceGaps" hidden></ul>
      </div>
      <div class="ce-foot">
        <button type="button" class="pj-link-btn ce-del" id="ceDelete" hidden>Delete draft</button>
        <span class="ce-foot-msg" id="ceMsg" role="status" aria-live="polite"></span>
        <span class="ce-foot-right">
          <button type="button" class="pg-btn" id="ceSave">Save draft</button>
          <button type="button" class="pg-btn" id="ceCopy" title="Copy the text and open a new message in your mail program">Copy to Outlook</button>
          <button type="submit" class="pg-btn pg-btn-primary" id="ceSend"><i class="bi bi-send" aria-hidden="true"></i>Send</button>
        </span>
      </div>
    </form>
  </div>
</dialog>

<!-- ── Conversation drawer ─────────────────────────────────────────── -->
<div class="al-backdrop" id="ceDrawerBg" hidden></div>
<aside class="al-drawer ce-drawer" id="ceDrawer" role="dialog" aria-modal="true" aria-labelledby="ceDrawerTitle" hidden tabindex="-1">
  <button type="button" class="al-drawer-close" id="ceDrawerClose" aria-label="Close"><i class="bi bi-x-lg"></i></button>
  <div id="ceDrawerBody"></div>
</aside>

<script>
(function () {
  var input = document.getElementById('coAttachInput'), label = document.getElementById('coAttachLabel');
  var drop = document.getElementById('coDrop'), btn = document.getElementById('coUploadBtn');
  if (!input) return;
  function show() {
    var n = input.files ? input.files.length : 0;
    label.innerHTML = n ? '<strong>' + n + ' file' + (n === 1 ? '' : 's') + '</strong> ready to upload' : '<strong>Drop files</strong> or click to choose';
    btn.hidden = !n; drop.classList.toggle('has-files', !!n);
  }
  input.addEventListener('change', show);
  ['dragenter', 'dragover'].forEach(function (t) { drop.addEventListener(t, function (e) { e.preventDefault(); drop.classList.add('is-over'); }); });
  ['dragleave', 'drop'].forEach(function (t) { drop.addEventListener(t, function () { drop.classList.remove('is-over'); }); });
  drop.addEventListener('drop', function (e) { e.preventDefault(); if (e.dataTransfer && e.dataTransfer.files.length) { input.files = e.dataTransfer.files; show(); } });
})();
</script>

<%- include('partials/company-email-script') %>
