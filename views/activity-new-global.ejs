<div class="pnew-page" style="max-width:520px; margin:0 auto;">
  <a href="/activities" class="pnew-back-link"><i class="bi bi-arrow-left"></i> Activity</a>

  <div class="pnew-badge"><i class="bi bi-activity"></i> New activity</div>
  <h1 class="pnew-hero">Log an <em>activity</em></h1>
  <p class="pnew-hero-sub">First, choose the company this activity is for.</p>

  <% if (error) { %>
    <div class="alert alert-danger mb-3"><%= error %></div>
  <% } %>

  <div class="pnew-card">
    <label class="pnew-field-label" for="companyPicker"><i class="bi bi-building"></i> Company <span class="pnew-required">*</span></label>
    <div style="position:relative; margin-bottom:0.75rem;">
      <i class="bi bi-search" style="position:absolute; left:0.75rem; top:50%; transform:translateY(-50%); color:var(--crm-muted-fg); font-size:0.85rem; pointer-events:none;"></i>
      <input type="text" id="companySearch" class="pnew-input" style="padding-left:2.1rem;" placeholder="Search companies…" autocomplete="off">
    </div>
    <div id="companyList" style="border:1px solid var(--crm-border); border-radius:0.6rem; overflow:hidden; max-height:320px; overflow-y:auto;">
      <% if (!companies.length) { %>
        <div style="padding:1.25rem; color:var(--crm-muted-fg); font-size:0.875rem; text-align:center;">No companies found.</div>
      <% } %>
      <% companies.forEach((c, i) => { %>
        <a href="/companies/<%= c.id %>/activities/new" class="co-pick-row <%= i > 0 ? 'co-pick-border' : '' %>">
          <div class="co-pick-avatar"><%= (c.name||'?').charAt(0).toUpperCase() %></div>
          <div class="co-pick-info">
            <div class="co-pick-name"><%= c.name %></div>
            <% if (c.industry || c.status) { %>
              <div class="co-pick-meta"><%= [c.industry, c.status].filter(Boolean).join(' · ') %></div>
            <% } %>
          </div>
          <i class="bi bi-arrow-right co-pick-arrow"></i>
        </a>
      <% }) %>
    </div>
  </div>
</div>

<style>
.co-pick-row {
  display: flex; align-items: center; gap: 0.75rem;
  padding: 0.75rem 1rem;
  text-decoration: none;
  transition: background 0.1s;
  background: #fff;
}
.co-pick-row:hover { background: var(--crm-muted); }
.co-pick-border { border-top: 1px solid var(--crm-border); }
.co-pick-avatar {
  width: 32px; height: 32px; border-radius: 8px;
  background: oklch(0.55 0.2 258 / 0.1); color: var(--crm-accent);
  display: flex; align-items: center; justify-content: center;
  font-weight: 700; font-size: 0.85rem; flex-shrink: 0;
}
.co-pick-info { flex: 1; min-width: 0; }
.co-pick-name { font-weight: 600; font-size: 0.875rem; color: var(--crm-fg); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.co-pick-meta { font-size: 0.72rem; color: var(--crm-muted-fg); margin-top: 0.05rem; }
.co-pick-arrow { color: var(--crm-muted-fg); font-size: 0.8rem; flex-shrink: 0; opacity: 0; transition: opacity 0.1s; }
.co-pick-row:hover .co-pick-arrow { opacity: 1; color: var(--crm-accent); }
</style>

<script>
(function() {
  var input = document.getElementById('companySearch');
  var rows = document.querySelectorAll('.co-pick-row');
  input.addEventListener('input', function() {
    var q = this.value.toLowerCase();
    rows.forEach(function(r) {
      var name = r.querySelector('.co-pick-name');
      r.style.display = (!q || (name && name.textContent.toLowerCase().includes(q))) ? '' : 'none';
    });
  });
})();
</script>
