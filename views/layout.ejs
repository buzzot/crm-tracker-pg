<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= typeof title !== 'undefined' ? title + ' · CRM' : 'CRM' %></title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
  <%
    const _role      = currentUser ? currentUser.role : null;
    const _isRd      = ['Head R&D Controllers','Head R&D VFD','Engineering'].includes(_role);
    const _isAdmin   = _role === 'Admin';
    const _canReport = ['Admin','Manager'].includes(_role);
    const _tc        = (typeof taskBadge !== 'undefined' && taskBadge) ? taskBadge : { open: 0, overdue: 0 };
    const _tcTitle   = _tc.overdue ? `${_tc.overdue} overdue of your ${_tc.open} open tasks` : `${_tc.open} open tasks assigned to you`;
    const _navItems  = [
      { href: '/',           label: 'Dashboard', icon: 'bi-speedometer2' },
      ...(_isRd ? [] : [{ href: '/pipeline', label: 'Pipeline', icon: 'bi-funnel' }]),
      { href: '/companies',  label: 'Companies', icon: 'bi-building' },
      { href: '/activities', label: 'Activity',  icon: 'bi-activity' },
      { href: '/tasks',      label: 'Tasks',     icon: 'bi-check2-square', badge: true },
      { href: '/projects',   label: 'Projects',  icon: 'bi-folder2-open' },
    ];
    const _moreItems = [
      { href: '/products', label: 'Products', icon: 'bi-box-seam' },
      ...(_canReport ? [{ href: '/reports/monthly', label: 'Monthly report', icon: 'bi-bar-chart' }] : []),
    ];
    const _newItems = [
      { href: '/tasks/new', label: 'Task', icon: 'bi-check2-square' },
      ...(_isRd ? [] : [{ href: '/companies/new', label: 'Company', icon: 'bi-building' }]),
      { href: '/projects/new', label: 'Project', icon: 'bi-folder2' },
    ];
    const _navColorMap = { indigo:'oklch(0.50 0.20 270)', blue:'oklch(0.52 0.18 250)', teal:'oklch(0.52 0.14 195)', emerald:'oklch(0.52 0.16 160)', amber:'oklch(0.62 0.18 72)', rose:'oklch(0.52 0.20 10)', slate:'oklch(0.35 0.02 265)' };
    const _navBg     = currentUser ? (_navColorMap[currentUser.avatarColor] || null) : null;
    const _initial   = currentUser ? (currentUser.name || currentUser.email || '?').trim().charAt(0).toUpperCase() : '?';
  %>
  <header class="tn" role="banner">
    <div class="tn-inner">
      <% if (currentUser) { %>
        <button class="tn-icon-btn tn-burger" type="button" data-bs-toggle="offcanvas" data-bs-target="#tnDrawer" aria-controls="tnDrawer" aria-label="Open menu">
          <i class="bi bi-list"></i>
        </button>
      <% } %>

      <a class="tn-brand" href="/" aria-label="Samyou home">
        <span class="tn-logo"><i class="bi bi-stars"></i></span>
        <span class="tn-brand-name">Samyou</span>
      </a>

      <% if (currentUser) { %>
        <nav class="tn-tabs" aria-label="Main">
          <% _navItems.forEach(it => { %>
            <a class="tn-tab" href="<%= it.href %>" data-nav="<%= it.href %>">
              <%= it.label %>
              <% if (it.badge && _tc.open > 0) { %>
                <span class="tn-badge <%= _tc.overdue ? 'is-danger' : '' %>" title="<%= _tcTitle %>" aria-label="<%= _tcTitle %>"><%= _tc.overdue || _tc.open %></span>
              <% } %>
            </a>
          <% }) %>
          <div class="dropdown tn-more">
            <button class="tn-tab tn-tab-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" data-nav-group="<%= _moreItems.map(m => m.href).join(' ') %>">
              More <i class="bi bi-chevron-down tn-caret"></i>
            </button>
            <ul class="dropdown-menu tn-menu">
              <% _moreItems.forEach(m => { %>
                <li><a class="dropdown-item" href="<%= m.href %>" data-nav="<%= m.href %>"><i class="bi <%= m.icon %>"></i><%= m.label %></a></li>
              <% }) %>
            </ul>
          </div>
        </nav>

        <div class="tn-actions">
          <div class="dropdown">
            <button class="tn-new" type="button" data-bs-toggle="dropdown" aria-expanded="false">
              <i class="bi bi-plus-lg"></i><span class="tn-new-label">New</span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end tn-menu">
              <li class="tn-menu-label">Create</li>
              <% _newItems.forEach(n => { %>
                <li><a class="dropdown-item" href="<%= n.href %>"><i class="bi <%= n.icon %>"></i><%= n.label %></a></li>
              <% }) %>
              <li><hr class="dropdown-divider"></li>
              <li class="tn-menu-hint">Log activities and deals from a company page</li>
            </ul>
          </div>

          <div class="dropdown">
            <button class="tn-user" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Account menu for <%= currentUser.name || currentUser.email %>">
              <span class="tn-avatar" <% if (_navBg) { %>style="background:<%- _navBg %>;color:#fff"<% } %>><%= _initial %></span>
              <i class="bi bi-chevron-down tn-caret"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end tn-menu tn-user-menu">
              <li class="tn-user-head">
                <div class="tn-user-name"><%= currentUser.name || currentUser.email %></div>
                <div class="tn-user-meta"><%= currentUser.role %><% if (currentUser.email && currentUser.name) { %> &middot; <%= currentUser.email %><% } %></div>
              </li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item" href="/profile"><i class="bi bi-person"></i>Profile</a></li>
              <% if (_isAdmin) { %>
                <li><a class="dropdown-item" href="/admin" data-nav="/admin"><i class="bi bi-gear"></i>Admin settings</a></li>
              <% } %>
              <li><hr class="dropdown-divider"></li>
              <li>
                <form action="/logout" method="POST" class="m-0">
                  <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right"></i>Log out</button>
                </form>
              </li>
            </ul>
          </div>
        </div>
      <% } %>
    </div>
  </header>

  <% if (currentUser) { %>
  <!-- Mobile drawer -->
  <div class="offcanvas offcanvas-start tn-drawer" tabindex="-1" id="tnDrawer" aria-labelledby="tnDrawerTitle">
    <div class="offcanvas-header">
      <a class="tn-brand" href="/" id="tnDrawerTitle"><span class="tn-logo"><i class="bi bi-stars"></i></span><span class="tn-brand-name">Samyou</span></a>
      <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close menu"></button>
    </div>
    <div class="offcanvas-body">
      <%
        const _work    = _navItems.filter(i => ['/', '/activities', '/tasks'].includes(i.href));
        const _records = [..._navItems.filter(i => ['/pipeline', '/companies', '/projects'].includes(i.href)), ..._moreItems];
      %>
      <div class="tn-drawer-label">Work</div>
      <% _work.forEach(it => { %>
        <a class="tn-drawer-link" href="<%= it.href %>" data-nav="<%= it.href %>"><i class="bi <%= it.icon %>"></i><%= it.label %>
          <% if (it.badge && _tc.open > 0) { %><span class="tn-badge <%= _tc.overdue ? 'is-danger' : '' %>" title="<%= _tcTitle %>"><%= _tc.overdue || _tc.open %></span><% } %>
        </a>
      <% }) %>
      <div class="tn-drawer-label">Records</div>
      <% _records.forEach(it => { %>
        <a class="tn-drawer-link" href="<%= it.href %>" data-nav="<%= it.href %>"><i class="bi <%= it.icon %>"></i><%= it.label %></a>
      <% }) %>
      <div class="tn-drawer-label">Account</div>
      <a class="tn-drawer-link" href="/profile" data-nav="/profile"><i class="bi bi-person"></i>Profile</a>
      <% if (_isAdmin) { %><a class="tn-drawer-link" href="/admin" data-nav="/admin"><i class="bi bi-gear"></i>Admin settings</a><% } %>
      <form action="/logout" method="POST" class="m-0">
        <button type="submit" class="tn-drawer-link tn-drawer-btn"><i class="bi bi-box-arrow-right"></i>Log out</button>
      </form>
    </div>
  </div>
  <% } %>

  <main class="container-fluid py-4">
    <%- body %>
  </main>

  <!-- Activity / Project Activity detail modal (populated via AJAX) -->
  <div class="modal fade" id="activityModal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="activityModalTitle">Activity</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body" id="activityModalBody">
          <div class="text-muted">Loading...</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Email preview modal: live, read-only fetch over IMAP — never persisted -->
  <div class="modal fade" id="emailPreviewModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Email preview</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body" id="emailPreviewBody">
          <div class="text-muted">Loading...</div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/app.js"></script>
  <script>
    (function(){
      var path = window.location.pathname;
      function matches(href) { return href === '/' ? path === '/' : path === href || path.indexOf(href + '/') === 0; }
      document.querySelectorAll('[data-nav]').forEach(function(a){
        if (matches(a.getAttribute('data-nav'))) { a.classList.add('active'); a.setAttribute('aria-current', 'page'); }
      });
      document.querySelectorAll('[data-nav-group]').forEach(function(btn){
        var hit = btn.getAttribute('data-nav-group').split(' ').some(matches);
        if (hit) btn.classList.add('active');
      });
    })();
  </script>
</body>
</html>
