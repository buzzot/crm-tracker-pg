<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= typeof title !== 'undefined' ? title + ' · CRM' : 'CRM' %></title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
  <%
    const _role      = currentUser ? currentUser.role : null;
    const _isRd      = ['Head R&D Controllers','Head R&D VFD','Engineering'].includes(_role);
    const _isAdmin   = _role === 'Admin';
    const _canReport = ['Admin','Manager'].includes(_role);
    const _tc        = (typeof taskBadge !== 'undefined' && taskBadge) ? taskBadge : { open: 0, overdue: 0 };
    const _tcTitle   = _tc.overdue ? `${_tc.overdue} overdue of your ${_tc.open} open tasks` : `${_tc.open} open tasks assigned to you`;
    const _navItems  = [
      { href: '/',           label: 'Dashboard', icon: 'bi-speedometer2' },
      ...(_isRd ? [] : [{ href: '/pipeline', label: 'Pipeline', icon: 'bi-funnel' }]),
      { href: '/companies',  label: 'Companies', icon: 'bi-building' },
      { href: '/activities', label: 'Activity',  icon: 'bi-activity' },
      { href: '/tasks',      label: 'Tasks',     icon: 'bi-check2-square', badge: true },
      { href: '/projects',   label: 'Projects',  icon: 'bi-folder2-open' },
    ];
    const _moreItems = [
      { href: '/products', label: 'Products', icon: 'bi-box-seam' },
      ...(_canReport ? [{ href: '/reports/monthly', label: 'Monthly report', icon: 'bi-bar-chart' }] : []),
    ];
    const _newItems = [
      { href: '/tasks/new', label: 'Task', icon: 'bi-check2-square' },
      ...(_isRd ? [] : [{ href: '/companies/new', label: 'Company', icon: 'bi-building' }]),
      { href: '/projects/new', label: 'Project', icon: 'bi-folder2' },
    ];
    const _navColorMap = { indigo:'oklch(0.50 0.20 270)', blue:'oklch(0.52 0.18 250)', teal:'oklch(0.52 0.14 195)', emerald:'oklch(0.52 0.16 160)', amber:'oklch(0.62 0.18 72)', rose:'oklch(0.52 0.20 10)', slate:'oklch(0.35 0.02 265)' };
    const _navBg     = currentUser ? (_navColorMap[currentUser.avatarColor] || null) : null;
    const _initial   = currentUser ? (currentUser.name || currentUser.email || '?').trim().charAt(0).toUpperCase() : '?';
  %>
  <header class="tn" role="banner">
    <div class="tn-inner">
      <% if (currentUser) { %>
        <button class="tn-icon-btn tn-burger" type="button" data-bs-toggle="offcanvas" data-bs-target="#tnDrawer" aria-controls="tnDrawer" aria-label="Open menu">
          <i class="bi bi-list"></i>
        </button>
      <% } %>

      <a class="tn-brand" href="/" aria-label="Samyou home">
        <span class="tn-logo"><i class="bi bi-stars"></i></span>
        <span class="tn-brand-name">Samyou</span>
      </a>

      <% if (currentUser) { %>
        <nav class="tn-tabs" aria-label="Main">
          <% _navItems.forEach(it => { %>
            <a class="tn-tab" href="<%= it.href %>" data-nav="<%= it.href %>">
              <%= it.label %>
              <% if (it.badge && _tc.open > 0) { %>
                <span class="tn-badge <%= _tc.overdue ? 'is-danger' : '' %>" title="<%= _tcTitle %>" aria-label="<%= _tcTitle %>"><%= _tc.overdue || _tc.open %></span>
              <% } %>
            </a>
          <% }) %>
          <div class="dropdown tn-more">
            <button class="tn-tab tn-tab-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" data-nav-group="<%= _moreItems.map(m => m.href).join(' ') %>">
              More <i class="bi bi-chevron-down tn-caret"></i>
            </button>
            <ul class="dropdown-menu tn-menu">
              <% _moreItems.forEach(m => { %>
                <li><a class="dropdown-item" href="<%= m.href %>" data-nav="<%= m.href %>"><i class="bi <%= m.icon %>"></i><%= m.label %></a></li>
              <% }) %>
            </ul>
          </div>
        </nav>

        <div class="tn-actions">
          <button type="button" class="tn-search" id="ksOpen" aria-label="Search (Ctrl+K)" aria-haspopup="dialog">
            <i class="bi bi-search" aria-hidden="true"></i>
            <span class="tn-search-label">Search</span>
            <kbd class="tn-kbd" data-ks-kbd>Ctrl K</kbd>
          </button>
          <div class="dropdown">
            <button class="tn-new" type="button" data-bs-toggle="dropdown" aria-expanded="false">
              <i class="bi bi-plus-lg"></i><span class="tn-new-label">New</span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end tn-menu">
              <li class="tn-menu-label">Create</li>
              <% _newItems.forEach(n => { %>
                <li><a class="dropdown-item" href="<%= n.href %>"><i class="bi <%= n.icon %>"></i><%= n.label %></a></li>
              <% }) %>
              <li><hr class="dropdown-divider"></li>
              <li class="tn-menu-hint">Log activities and deals from a company page</li>
            </ul>
          </div>

          <div class="dropdown">
            <button class="tn-user" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Account menu for <%= currentUser.name || currentUser.email %>">
              <span class="tn-avatar" <% if (_navBg) { %>style="background:<%- _navBg %>;color:#fff"<% } %>><%= _initial %></span>
              <i class="bi bi-chevron-down tn-caret"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end tn-menu tn-user-menu">
              <li class="tn-user-head">
                <div class="tn-user-name"><%= currentUser.name || currentUser.email %></div>
                <div class="tn-user-meta"><%= currentUser.role %><% if (currentUser.email && currentUser.name) { %> &middot; <%= currentUser.email %><% } %></div>
              </li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item" href="/profile"><i class="bi bi-person"></i>Profile</a></li>
              <% if (_isAdmin) { %>
                <li><a class="dropdown-item" href="/admin" data-nav="/admin"><i class="bi bi-gear"></i>Admin settings</a></li>
              <% } %>
              <li><hr class="dropdown-divider"></li>
              <li>
                <form action="/logout" method="POST" class="m-0">
                  <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right"></i>Log out</button>
                </form>
              </li>
            </ul>
          </div>
        </div>
      <% } %>
    </div>
  </header>

  <% if (currentUser) { %>
  <!-- Global search palette (Ctrl/Cmd+K) -->
  <div class="ks" id="ks" hidden>
    <div class="ks-backdrop" data-ks-close></div>
    <div class="ks-panel" role="dialog" aria-modal="true" aria-label="Search">
      <div class="ks-input-row">
        <i class="bi bi-search ks-input-icon" aria-hidden="true"></i>
        <input type="text" id="ksInput" class="ks-input" autocomplete="off" spellcheck="false"
               placeholder="Search companies, contacts, deals and projects"
               role="combobox" aria-expanded="false" aria-controls="ksList" aria-autocomplete="list">
        <span class="ks-spinner" id="ksSpin" hidden aria-hidden="true"></span>
        <button type="button" class="ks-esc" data-ks-close aria-label="Close search">Esc</button>
      </div>
      <div class="ks-body" id="ksList" role="listbox" aria-label="Search results"></div>
      <div class="ks-foot" aria-hidden="true">
        <span><kbd>&uarr;</kbd><kbd>&darr;</kbd> to move</span>
        <span><kbd>Enter</kbd> to open</span>
        <span><kbd>Esc</kbd> to close</span>
      </div>
    </div>
  </div>

  <!-- Mobile drawer -->
  <div class="offcanvas offcanvas-start tn-drawer" tabindex="-1" id="tnDrawer" aria-labelledby="tnDrawerTitle">
    <div class="offcanvas-header">
      <a class="tn-brand" href="/" id="tnDrawerTitle"><span class="tn-logo"><i class="bi bi-stars"></i></span><span class="tn-brand-name">Samyou</span></a>
      <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close menu"></button>
    </div>
    <div class="offcanvas-body">
      <%
        const _work    = _navItems.filter(i => ['/', '/activities', '/tasks'].includes(i.href));
        const _records = [..._navItems.filter(i => ['/pipeline', '/companies', '/projects'].includes(i.href)), ..._moreItems];
      %>
      <div class="tn-drawer-label">Work</div>
      <% _work.forEach(it => { %>
        <a class="tn-drawer-link" href="<%= it.href %>" data-nav="<%= it.href %>"><i class="bi <%= it.icon %>"></i><%= it.label %>
          <% if (it.badge && _tc.open > 0) { %><span class="tn-badge <%= _tc.overdue ? 'is-danger' : '' %>" title="<%= _tcTitle %>"><%= _tc.overdue || _tc.open %></span><% } %>
        </a>
      <% }) %>
      <div class="tn-drawer-label">Records</div>
      <% _records.forEach(it => { %>
        <a class="tn-drawer-link" href="<%= it.href %>" data-nav="<%= it.href %>"><i class="bi <%= it.icon %>"></i><%= it.label %></a>
      <% }) %>
      <div class="tn-drawer-label">Account</div>
      <a class="tn-drawer-link" href="/profile" data-nav="/profile"><i class="bi bi-person"></i>Profile</a>
      <% if (_isAdmin) { %><a class="tn-drawer-link" href="/admin" data-nav="/admin"><i class="bi bi-gear"></i>Admin settings</a><% } %>
      <form action="/logout" method="POST" class="m-0">
        <button type="submit" class="tn-drawer-link tn-drawer-btn"><i class="bi bi-box-arrow-right"></i>Log out</button>
      </form>
    </div>
  </div>
  <% } %>

  <main class="container-fluid py-4">
    <%- body %>
  </main>

  <!-- Activity / Project Activity detail modal (populated via AJAX) -->
  <div class="modal fade" id="activityModal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="activityModalTitle">Activity</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body" id="activityModalBody">
          <div class="text-muted">Loading...</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Email preview modal: live, read-only fetch over IMAP — never persisted -->
  <div class="modal fade" id="emailPreviewModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Email preview</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body" id="emailPreviewBody">
          <div class="text-muted">Loading...</div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/app.js"></script>
  <script>
    (function(){
      var path = window.location.pathname;
      function matches(href) { return href === '/' ? path === '/' : path === href || path.indexOf(href + '/') === 0; }
      document.querySelectorAll('[data-nav]').forEach(function(a){
        if (matches(a.getAttribute('data-nav'))) { a.classList.add('active'); a.setAttribute('aria-current', 'page'); }
      });
      document.querySelectorAll('[data-nav-group]').forEach(function(btn){
        var hit = btn.getAttribute('data-nav-group').split(' ').some(matches);
        if (hit) btn.classList.add('active');
      });
    })();

    // ── Global search palette ────────────────────────────────────────────────
    (function () {
      var root = document.getElementById('ks');
      if (!root) return;
      var input = document.getElementById('ksInput');
      var list = document.getElementById('ksList');
      var spin = document.getElementById('ksSpin');
      var isMac = /Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent);
      document.querySelectorAll('[data-ks-kbd]').forEach(function (k) { k.textContent = isMac ? '⌘K' : 'Ctrl K'; });

      var GROUPS = [
        { key: 'companies', label: 'Companies', icon: 'bi-building' },
        { key: 'contacts',  label: 'Contacts',  icon: 'bi-person' },
        { key: 'deals',     label: 'Deals',     icon: 'bi-briefcase' },
        { key: 'projects',  label: 'Projects',  icon: 'bi-folder2' },
      ];
      var items = [], active = -1, timer = null, ctrl = null, lastFocus = null, seq = 0;

      function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
      function highlight(text, q) {
        var t = String(text || ''), i = t.toLowerCase().indexOf(q.toLowerCase());
        if (!q || i < 0) return esc(t);
        return esc(t.slice(0, i)) + '<mark>' + esc(t.slice(i, i + q.length)) + '</mark>' + esc(t.slice(i + q.length));
      }

      function hint() {
        items = []; active = -1;
        list.innerHTML = '<div class="ks-msg">Type at least 2 letters to search ' +
          GROUPS.map(function (g) { return '<span class="ks-chip"><i class="bi ' + g.icon + '"></i>' + g.label + '</span>'; }).join('') + '</div>';
        input.setAttribute('aria-expanded', 'false');
        input.removeAttribute('aria-activedescendant');
      }
      function message(html) { items = []; active = -1; list.innerHTML = '<div class="ks-msg">' + html + '</div>'; input.setAttribute('aria-expanded', 'false'); }

      function renderResults(q, res) {
        var html = '', n = 0;
        items = [];
        GROUPS.forEach(function (g) {
          var rows = (res && res[g.key]) || [];
          if (!rows.length) return;
          html += '<div class="ks-group" role="presentation">' + g.label + '</div>';
          rows.forEach(function (r) {
            var id = 'ks-opt-' + n;
            items.push(r);
            html += '<a class="ks-item" id="' + id + '" role="option" aria-selected="false" href="' + esc(r.url) + '" data-i="' + n + '">' +
              '<span class="ks-ico"><i class="bi ' + g.icon + '" aria-hidden="true"></i></span>' +
              '<span class="ks-text"><span class="ks-title">' + highlight(r.title, q) + '</span>' +
              (r.sub ? '<span class="ks-sub">' + highlight(r.sub, q) + '</span>' : '') + '</span>' +
              '<i class="bi bi-arrow-return-left ks-enter" aria-hidden="true"></i></a>';
            n++;
          });
        });
        if (!n) return message('No matches for <strong>' + esc(q) + '</strong>.');
        list.innerHTML = html;
        input.setAttribute('aria-expanded', 'true');
        setActive(0);
      }

      function setActive(i) {
        var els = list.querySelectorAll('.ks-item');
        if (!els.length) return;
        active = (i + els.length) % els.length;
        els.forEach(function (el, j) { var on = j === active; el.classList.toggle('is-active', on); el.setAttribute('aria-selected', on); });
        input.setAttribute('aria-activedescendant', els[active].id);
        els[active].scrollIntoView({ block: 'nearest' });
      }

      function search(q) {
        if (ctrl) ctrl.abort();
        if (q.length < 2) { spin.hidden = true; return hint(); }
        ctrl = ('AbortController' in window) ? new AbortController() : null;
        var mine = ++seq;
        spin.hidden = false;
        fetch('/api/search?q=' + encodeURIComponent(q), { credentials: 'same-origin', headers: { 'Accept': 'application/json' }, signal: ctrl ? ctrl.signal : undefined })
          .then(function (r) { return r.ok ? r.json() : Promise.reject(r); })
          .then(function (data) { if (mine !== seq) return; spin.hidden = true; renderResults(q, data.results); })
          .catch(function (e) {
            if (e && e.name === 'AbortError') return;
            if (mine !== seq) return;
            spin.hidden = true;
            message("Search isn't available right now. <button type=\"button\" class=\"ks-retry\" id=\"ksRetry\">Try again</button>");
            var b = document.getElementById('ksRetry'); if (b) b.addEventListener('click', function () { search(input.value.trim()); input.focus(); });
          });
      }

      function open() {
        if (!root.hidden) return;
        lastFocus = document.activeElement;
        root.hidden = false;
        document.body.classList.add('ks-lock');
        input.value = ''; hint();
        setTimeout(function () { input.focus(); }, 0);
      }
      function close() {
        if (root.hidden) return;
        if (ctrl) ctrl.abort();
        root.hidden = true; spin.hidden = true;
        document.body.classList.remove('ks-lock');
        if (lastFocus && document.contains(lastFocus)) lastFocus.focus();
      }

      document.getElementById('ksOpen').addEventListener('click', open);
      root.addEventListener('click', function (e) { if (e.target.closest('[data-ks-close]')) close(); });
      input.addEventListener('input', function () { clearTimeout(timer); var q = input.value.trim(); timer = setTimeout(function () { search(q); }, 160); });
      input.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowDown') { e.preventDefault(); setActive(active + 1); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(active - 1); }
        else if (e.key === 'Enter') {
          var el = list.querySelector('.ks-item.is-active');
          if (el) { e.preventDefault(); if (e.metaKey || e.ctrlKey) window.open(el.href, '_blank'); else location.href = el.href; }
        }
        else if (e.key === 'Escape') { e.preventDefault(); close(); }
        else if (e.key === 'Tab') { e.preventDefault(); setActive(active + (e.shiftKey ? -1 : 1)); }
      });
      list.addEventListener('mousemove', function (e) {
        var el = e.target.closest('.ks-item');
        if (el && +el.getAttribute('data-i') !== active) setActive(+el.getAttribute('data-i'));
      });

      document.addEventListener('keydown', function (e) {
        var k = (e.key || '').toLowerCase();
        if ((e.metaKey || e.ctrlKey) && k === 'k') { e.preventDefault(); root.hidden ? open() : close(); return; }
        if (k === '/' && root.hidden && !e.metaKey && !e.ctrlKey && !e.altKey) {
          var t = e.target, tag = (t && t.tagName) || '';
          if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || (t && t.isContentEditable)) return;
          e.preventDefault(); open();
        }
        if (e.key === 'Escape' && !root.hidden) close();
      });
    })();
  </script>
</body>
</html>
