<%
  /* ── helpers ─────────────────────────────────────────────── */
  function noteTimeAgo(dateStr) {
    if (!dateStr) return '';
    const then = new Date(dateStr);
    if (isNaN(then.getTime())) return dateStr;
    const sec = Math.floor((Date.now() - then.getTime()) / 1000);
    if (sec < 60) return 'just now';
    const min = Math.floor(sec / 60);
    if (min < 60) return min + 'm ago';
    const hr = Math.floor(min / 60);
    if (hr < 24) return hr + 'h ago';
    const day = Math.floor(hr / 24);
    if (day < 30) return day + 'd ago';
    return then.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
  }

  function fmtDateShort(str) {
    if (!str) return '—';
    return new Date(str + 'T00:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
  }

  const noteAvatarClasses = ['note-avatar-blue', 'note-avatar-purple', 'note-avatar-gray'];
  const youInitial = ((typeof currentUser !== 'undefined' && currentUser && (currentUser.name || currentUser.email)) || '?').trim().charAt(0).toUpperCase();
  const orderedComments = activity.comments.slice().reverse();

  const typeIconMap = { Call: 'bi-telephone', Email: 'bi-envelope', LinkedIn: 'bi-linkedin', Meeting: 'bi-people', Demo: 'bi-play-circle' };
  const typeIcon = typeIconMap[activity.type] || 'bi-clock-history';

  const typeBgMap = { Call: 'att-blue', Email: 'att-purple', LinkedIn: 'att-indigo', Meeting: 'att-teal', Demo: 'att-teal' };
  const typeBg = typeBgMap[activity.type] || 'att-gray';

  /* overdue / due logic */
  const _todayDate = new Date(); _todayDate.setHours(0,0,0,0);
  const _isCompleted = (activity.result || '') === 'Completed';
  let _dueLabel = null, _dueCls = null;
  if (activity.dueDate && !_isCompleted) {
    const _days = Math.floor((new Date(activity.dueDate + 'T00:00:00') - _todayDate) / 86400000);
    if (_days < 0)      { _dueLabel = Math.abs(_days) + 'd overdue'; _dueCls = 'adp-chip-overdue'; }
    else if (_days === 0) { _dueLabel = 'Due today';                  _dueCls = 'adp-chip-today'; }
    else if (_days <= 7)  { _dueLabel = 'Due ' + fmtDateShort(activity.dueDate); _dueCls = 'adp-chip-soon'; }
  } else if (_isCompleted) {
    _dueLabel = 'Completed' + (activity.statusDate ? ' ' + fmtDateShort(activity.statusDate) : '');
    _dueCls = 'adp-chip-done';
  }

  const _canManage = currentUser && ['Admin','Manager','Head R&D Controllers','Head R&D VFD'].includes(currentUser.role);
  const _sharedIds = new Set((activity.participants||[]).map(p => p.id));
  const _notShared = (teamUsers||[]).filter(u => !_sharedIds.has(u.id));
  const _actEmail = 'activity-' + activity.id + '@' + (typeof emailDomain !== 'undefined' ? emailDomain : 'mail.samyou.se');
%>

<div class="adp-page">

  <!-- ── COMPACT HEADER ──────────────────────────────────────────────────── -->
  <div class="adp-header">
    <!-- Breadcrumbs -->
    <nav class="adp-breadcrumb">
      <a href="/activities" class="adp-bc-link">Activity</a>
      <% if (activity.companyIds && activity.companyIds.length) { %>
        <i class="bi bi-chevron-right adp-bc-sep"></i>
        <a href="/companies/<%= activity.companyIds[0] %>" class="adp-bc-link"><%= (activity.companyNames && activity.companyNames[0]) || 'Company' %></a>
      <% } %>
    </nav>

    <!-- Title row -->
    <div class="adp-title-row">
      <div class="adp-title-icon-wrap">
        <div class="adp-title-icon act2-icon <%= typeBg %>"><i class="bi <%= typeIcon %>"></i></div>
      </div>
      <h1 class="adp-title"><%= activity.name || '(untitled)' %></h1>
      <div class="adp-header-actions">
        <% if (editMode) { %>
          <a href="/activities/<%= activity.id %>" class="pnew-btn-cancel">Cancel</a>
          <button type="button" class="pnew-btn-save" onclick="document.getElementById('activityForm').submit()"><i class="bi bi-check-lg"></i> Save</button>
        <% } else { %>
          <a href="/activities/<%= activity.id %>?edit=1" class="adp-edit-btn"><i class="bi bi-pencil"></i> Edit</a>
        <% } %>
      </div>
    </div>

    <!-- Meta row -->
    <div class="adp-meta-row">
      <% if (activity.type) { %>
        <span class="adp-meta-chip adp-meta-type"><i class="bi <%= typeIcon %>"></i> <%= activity.type %></span>
      <% } %>
      <% if (activity.result) { %>
        <%
          const _rCls = activity.result === 'Completed' ? 'adp-meta-green'
                       : activity.result === 'Replied' ? 'adp-meta-blue'
                       : activity.result === 'Meeting booked' ? 'adp-meta-teal'
                       : activity.result === 'Not interested' ? 'adp-meta-red'
                       : 'adp-meta-muted';
        %>
        <span class="adp-meta-chip <%= _rCls %>"><i class="bi bi-flag-fill"></i> <%= activity.result %></span>
      <% } %>
      <% if (_dueLabel) { %>
        <span class="adp-meta-chip <%= _dueCls %>"><%= _dueLabel %></span>
      <% } %>
      <% if (activity.companyIds && activity.companyIds.length) { %>
        <a href="/companies/<%= activity.companyIds[0] %>" class="adp-meta-chip adp-meta-co">
          <i class="bi bi-building"></i> <%= (activity.companyNames || []).join(', ') %>
        </a>
      <% } %>
      <% if (activity.date || activity.createdAt) { %>
        <span class="adp-meta-chip adp-meta-muted"><i class="bi bi-calendar3"></i> <%= fmtDateShort(activity.date || (activity.createdAt ? activity.createdAt.split('T')[0] : null)) %></span>
      <% } %>
    </div>
  </div>

  <% if (error) { %>
    <div class="alert alert-danger mb-3"><%= error %></div>
  <% } %>

  <div class="pnew-grid">

    <!-- ── MAIN ──────────────────────────────────────────────────────────── -->
    <div class="pnew-main">

      <!-- Details card -->
      <div class="pnew-card">
        <% if (!editMode) { %>
          <!-- Read-only details -->
          <% if (activity.details) { %>
            <div class="adp-details-body"><%= activity.details %></div>
          <% } else { %>
            <p class="pnew-card-sub mb-0">No details recorded.</p>
          <% } %>

          <% if (activity.attendees && activity.attendees.length) { %>
            <div class="adp-people-section">
              <div class="pnew-field-label"><i class="bi bi-people"></i> Attendees</div>
              <div class="adp-chip-list">
                <% activity.attendees.forEach(att => {
                     const dn = att.name || 'Unknown contact'; %>
                  <span class="adp-person-chip">
                    <span class="adp-person-avatar"><%= dn.trim().charAt(0).toUpperCase() %></span>
                    <%= dn %>
                  </span>
                <% }) %>
              </div>
            </div>
          <% } %>

          <% if (activity.projectIds && activity.projectIds.length) { %>
            <div class="adp-people-section">
              <div class="pnew-field-label"><i class="bi bi-folder2-open"></i> Related projects</div>
              <div class="adp-chip-list">
                <% activity.projectIds.forEach(id => {
                     const pr = projects.find(pp => pp.id === id); %>
                  <a href="/projects/<%= id %>" class="adp-proj-chip">
                    <i class="bi bi-folder2-open" style="font-size:0.7rem;"></i> <%= pr ? pr.name : id %>
                  </a>
                <% }) %>
              </div>
            </div>
          <% } %>

          <% if (activity.participants && activity.participants.length) { %>
            <div class="adp-people-section">
              <div class="pnew-field-label"><i class="bi bi-people-fill"></i> Team participants</div>
              <div class="adp-chip-list">
                <% activity.participants.forEach(p => { %>
                  <span class="adp-person-chip">
                    <span class="adp-person-avatar adp-person-avatar--team"><%= (p.name||'?').trim().charAt(0).toUpperCase() %></span>
                    <%= p.name %>
                  </span>
                <% }) %>
              </div>
            </div>
          <% } %>

        <% } else { %>
          <!-- Edit form -->
          <h2 class="pnew-card-title">Edit activity</h2>
          <p class="pnew-card-sub">Make your changes and save.</p>

          <form id="activityForm" action="/activities/<%= activity.id %>" method="POST">

            <div class="mb-3">
              <label class="pnew-field-label">Activity name <span class="pnew-required">*</span></label>
              <input type="text" name="name" class="pnew-input" value="<%= activity.name || '' %>" required>
            </div>

            <div class="row g-3 mb-3">
              <div class="col-md-6">
                <label class="pnew-field-label"><i class="bi bi-tag"></i> Type</label>
                <select name="type" class="pnew-select">
                  <option value="">— Select —</option>
                  <% typeChoices.forEach(opt => { %>
                    <option value="<%= opt %>" <%= activity.type === opt ? 'selected' : '' %>><%= opt %></option>
                  <% }) %>
                </select>
              </div>
              <div class="col-md-6">
                <label class="pnew-field-label"><i class="bi bi-flag"></i> Result / Status</label>
                <select name="result" class="pnew-select">
                  <option value="">— Select —</option>
                  <% resultChoices.forEach(opt => { %>
                    <option value="<%= opt %>" <%= activity.result === opt ? 'selected' : '' %>><%= opt %></option>
                  <% }) %>
                </select>
              </div>
            </div>

            <div class="row g-3 mb-3">
              <div class="col-md-6">
                <label class="pnew-field-label"><i class="bi bi-calendar-check"></i> Complete before <span class="text-muted fw-normal">(optional)</span></label>
                <input type="date" name="dueDate" class="pnew-input" value="<%= activity.dueDate || '' %>">
              </div>
            </div>

            <div class="mb-3">
              <label class="pnew-field-label"><i class="bi bi-people"></i> Attendees</label>
              <div class="chip-field" id="attendeesChipField">
                <% [].concat(activity.attendees||[]).forEach(att => {
                     const p = persons.find(pp => pp.id === att.id);
                     const displayName = (p && p.fullName) || att.name || 'Unknown contact'; %>
                  <span class="chip" data-id="<%= att.id %>">
                    <span class="chip-avatar"><%= displayName.trim().charAt(0).toUpperCase() %></span>
                    <%= displayName %>
                    <input type="hidden" name="attendeeIds" value="<%= att.id %>">
                    <button type="button" class="chip-remove" aria-label="Remove">&times;</button>
                  </span>
                <% }) %>
                <div class="chip-add-wrap">
                  <button type="button" class="chip-add-btn" data-target="attendeesChipField" data-field="attendeeIds" data-avatar="1">Add attendee</button>
                  <select class="chip-add-select d-none">
                    <option value="">— Select —</option>
                    <% persons.forEach(p => { %><option value="<%= p.id %>" data-name="<%= p.fullName %>"><%= p.fullName %></option><% }) %>
                  </select>
                </div>
                <%
                  const activityCompanyIdForContact = (activity.companyIds || [])[0];
                  const createContactHref = activityCompanyIdForContact ? `/companies/${activityCompanyIdForContact}/contacts/new` : null;
                %>
                <% if (createContactHref) { %>
                  <a href="<%= createContactHref %>" class="chip-add-btn">Create contact</a>
                <% } %>
              </div>
            </div>

            <div class="mb-3">
              <label class="pnew-field-label"><i class="bi bi-people-fill"></i> Team participants <span class="text-muted fw-normal" style="font-size:0.75rem;">(get email when confirmed)</span></label>
              <div class="chip-field" id="participantsChipField">
                <% [].concat((activity.participants||[]).map(p=>p.id)).forEach(uid => {
                     const tu = (typeof teamUsers !== 'undefined' ? teamUsers : []).find(u => u.id === uid); %>
                  <span class="chip" data-id="<%= uid %>">
                    <span class="chip-avatar"><%= ((tu && tu.name) || '?').trim().charAt(0).toUpperCase() %></span>
                    <%= tu ? tu.name : uid %>
                    <input type="hidden" name="participantIds" value="<%= uid %>">
                    <button type="button" class="chip-remove" aria-label="Remove">&times;</button>
                  </span>
                <% }) %>
                <div class="chip-add-wrap">
                  <button type="button" class="chip-add-btn" data-target="participantsChipField" data-field="participantIds" data-avatar="1">Add team member</button>
                  <select class="chip-add-select d-none">
                    <option value="">— Select —</option>
                    <% (typeof teamUsers !== 'undefined' ? teamUsers : []).forEach(u => { %><option value="<%= u.id %>" data-name="<%= u.name %>"><%= u.name %><% if (u.title) { %> — <%= u.title %><% } %></option><% }) %>
                  </select>
                </div>
              </div>
            </div>

            <div class="mb-3">
              <label class="pnew-field-label"><i class="bi bi-kanban"></i> Related project(s)</label>
              <div class="chip-field" id="projectsChipField">
                <% [].concat(activity.projectIds||[]).forEach(id => {
                     const pr = projects.find(pp => pp.id === id); %>
                  <span class="chip chip-link" data-id="<%= id %>">
                    <%= pr ? pr.name : id %>
                    <input type="hidden" name="projectIds" value="<%= id %>">
                    <button type="button" class="chip-remove" aria-label="Remove">&times;</button>
                  </span>
                <% }) %>
                <div class="chip-add-wrap">
                  <button type="button" class="chip-add-btn" data-target="projectsChipField" data-field="projectIds">Link a project</button>
                  <select class="chip-add-select d-none">
                    <option value="">— Select —</option>
                    <% projects.forEach(p => { %><option value="<%= p.id %>" data-name="<%= p.name %>"><%= p.name %></option><% }) %>
                  </select>
                </div>
                <%
                  const activityCompanyId = (activity.companyIds || [])[0];
                  const createProjectHref = activityCompanyId ? `/companies/${activityCompanyId}/projects/new` : '/projects/new';
                %>
                <a href="<%= createProjectHref %>" class="chip-add-btn">Create project</a>
              </div>
            </div>

            <div class="mb-0">
              <label class="pnew-field-label"><i class="bi bi-card-text"></i> Details / notes</label>
              <textarea name="details" class="pnew-input pnew-textarea" rows="6" id="activityDetailsTextarea"><%= activity.details || '' %></textarea>
            </div>

          </form>

          <% if (editMode && typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'Admin') { %>
            <div class="adp-danger-zone">
              <div class="adp-danger-label">Danger zone</div>
              <form action="/activities/<%= activity.id %>/delete" method="POST" onsubmit="return confirm('Delete this activity permanently? This cannot be undone.')">
                <button type="submit" class="act-delete-btn"><i class="bi bi-trash me-1"></i> Delete activity</button>
              </form>
            </div>
          <% } %>

        <% } %> <!-- end editMode -->
      </div>

      <!-- Conversation card -->
      <div class="pnew-card">
        <h2 class="pnew-card-title"><i class="bi bi-chat-text me-1" style="color:var(--crm-accent);font-size:0.9em;"></i> Conversation <span class="adp-count-badge"><%= activity.comments.length %></span></h2>

        <form action="/activities/<%= activity.id %>/comments" method="POST" enctype="multipart/form-data">
          <div class="adp-compose">
            <span class="note-avatar note-avatar-you"><%= youInitial %></span>
            <div class="adp-compose-body">
              <textarea name="comment" class="adp-compose-input" rows="2" placeholder="Add a comment…" required></textarea>
              <div class="adp-compose-footer">
                <label class="adp-attach-label">
                  <i class="bi bi-paperclip"></i>
                  <span id="activityCommentFileLabel">Attach</span>
                  <input type="file" name="attachment" multiple style="display:none;" id="activityCommentFileInput">
                </label>
                <button type="submit" class="adp-send-btn"><i class="bi bi-send-fill me-1"></i>Send</button>
              </div>
            </div>
          </div>
        </form>

        <div class="note-thread" style="margin-top:0.75rem;">
          <% if (!orderedComments.length) { %>
            <p class="text-muted mb-0" style="font-size:0.85rem;">No messages yet.</p>
          <% } %>
          <% orderedComments.forEach((c, i) => { %>
            <% const initial = (c.author || '?').trim().charAt(0).toUpperCase(); %>
            <% if (c.type === 'email') { %>
              <div class="note-item note-item-email">
                <div class="note-item-head">
                  <span class="note-avatar note-avatar-email"><i class="bi bi-envelope-fill"></i></span>
                  <div class="note-email-meta">
                    <span class="note-email-from"><%= c.author %></span>
                    <span class="note-email-subj"><%= c.emailSubject || '(no subject)' %></span>
                  </div>
                  <span class="text-muted small note-item-time"><%= noteTimeAgo(c.postedAt) %></span>
                </div>
                <div class="note-bubble note-email-bubble">
                  <div class="note-text" style="white-space:pre-wrap;"><%= c.comment %></div>
                  <% if (c.attachments && c.attachments.length) { %>
                    <div class="d-flex flex-wrap gap-2 mt-2">
                      <% c.attachments.forEach(file => { %>
                        <a href="<%= file.url %>" target="_blank" rel="noopener" class="note-link-chip"><i class="bi bi-paperclip"></i><%= file.filename %></a>
                      <% }) %>
                    </div>
                  <% } %>
                </div>
              </div>
            <% } else { %>
              <div class="note-item">
                <div class="note-item-head">
                  <span class="note-avatar <%= noteAvatarClasses[i % noteAvatarClasses.length] %>"><%= initial %></span>
                  <span class="fw-semibold note-author"><%= c.author || 'Someone' %></span>
                  <span class="text-muted small note-item-time"><%= noteTimeAgo(c.postedAt) %></span>
                </div>
                <div class="note-bubble">
                  <div class="note-text"><%= c.comment %></div>
                  <% if (c.link) { %>
                    <a href="<%= c.link %>" target="_blank" rel="noopener" class="note-link-chip"><i class="bi bi-link-45deg"></i><%= c.link %></a>
                  <% } %>
                  <% if (c.attachments && c.attachments.length) { %>
                    <div class="d-flex flex-wrap gap-2 mt-2">
                      <% c.attachments.forEach(file => { %>
                        <a href="<%= file.url %>" target="_blank" rel="noopener" class="note-link-chip"><i class="bi bi-paperclip"></i><%= file.filename %></a>
                      <% }) %>
                    </div>
                  <% } %>
                </div>
              </div>
            <% } %>
          <% }) %>
        </div>
      </div>

      <!-- Files card -->
      <div class="pnew-card">
        <h2 class="pnew-card-title"><i class="bi bi-paperclip me-1" style="color:var(--crm-accent);font-size:0.9em;"></i> Files
          <% if (activity.files && activity.files.length) { %><span class="adp-count-badge"><%= activity.files.length %></span><% } %>
        </h2>

        <% if (activity.files && activity.files.length) { %>
          <div class="act-file-list" style="margin-bottom:0.75rem;">
            <% activity.files.forEach(file => {
              const ext = (file.filename || '').split('.').pop().toLowerCase();
              const iconMap = { pdf: 'bi-file-earmark-pdf', doc: 'bi-file-earmark-word', docx: 'bi-file-earmark-word', xls: 'bi-file-earmark-excel', xlsx: 'bi-file-earmark-excel', png: 'bi-file-earmark-image', jpg: 'bi-file-earmark-image', jpeg: 'bi-file-earmark-image', gif: 'bi-file-earmark-image', zip: 'bi-file-earmark-zip' };
              const colorMap = { pdf: 'act-file-pdf', doc: 'act-file-doc', docx: 'act-file-doc', xls: 'act-file-xls', xlsx: 'act-file-xls', png: 'act-file-img', jpg: 'act-file-img', jpeg: 'act-file-img', gif: 'act-file-img' };
              const icon = iconMap[ext] || 'bi-file-earmark';
              const cls  = colorMap[ext] || '';
            %>
              <a href="<%= file.url %>" target="_blank" rel="noopener" class="act-file-row">
                <i class="bi <%= icon %> act-file-icon <%= cls %>"></i>
                <span class="act-file-name"><%= file.filename %></span>
                <i class="bi bi-box-arrow-up-right act-file-open"></i>
              </a>
            <% }) %>
          </div>
        <% } else { %>
          <p class="pnew-card-sub">No files yet.</p>
        <% } %>

        <form action="/activities/<%= activity.id %>/files" method="POST" enctype="multipart/form-data" id="activityFileForm">
          <input type="file" name="file" multiple id="activityFileInput" style="display:none;">
          <div class="act-dropzone" id="activityDropZone">
            <i class="bi bi-upload act-dropzone-icon"></i>
            <p class="act-dropzone-text">Drop files here or <span class="act-dropzone-browse">browse</span></p>
            <p class="act-dropzone-hint">PDF, images, documents — up to 25 MB</p>
          </div>
          <div class="act-drop-filelist d-none" id="activityDropFileList"></div>
          <button type="submit" class="act-drop-submit d-none" id="activityDropSubmit"><i class="bi bi-upload me-1"></i><span id="activityDropSubmitLabel">Upload</span></button>
        </form>
      </div>

    </div> <!-- /pnew-main -->

    <!-- ── SIDEBAR ────────────────────────────────────────────────────────── -->
    <div class="pnew-aside">

      <!-- Metadata overview -->
      <div class="pnew-summary-card">
        <div class="pnew-summary-title">Overview</div>
        <div class="pnew-summary-row"><span>Type</span><span><%= activity.type || '—' %></span></div>
        <div class="pnew-summary-row"><span>Status</span><span><%= activity.result || '—' %></span></div>
        <% if (activity.companyIds && activity.companyIds.length) { %>
          <div class="pnew-summary-row"><span>Company</span>
            <a href="/companies/<%= activity.companyIds[0] %>" style="color:var(--crm-accent);text-decoration:none;font-size:0.82rem;"><%= (activity.companyNames||[]).join(', ') %></a>
          </div>
        <% } %>
        <% if (activity.dueDate) { %>
          <div class="pnew-summary-row"><span>Due date</span><span><%= fmtDateShort(activity.dueDate) %></span></div>
        <% } %>
        <% if (activity.statusDate) { %>
          <div class="pnew-summary-row"><span>Status date</span><span><%= fmtDateShort(activity.statusDate) %></span></div>
        <% } %>
        <div class="pnew-summary-row"><span>Created</span><span><%= activity.createdAt ? new Date(activity.createdAt).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) : '—' %></span></div>
        <% if (activity.ownerName) { %>
          <div class="pnew-summary-row"><span>Owner</span><span><%= activity.ownerName %></span></div>
        <% } %>
        <div class="pnew-summary-row"><span>Attendees</span><span><%= (activity.attendeeIds || []).length %></span></div>
        <div class="pnew-summary-row"><span>Projects</span><span><%= (activity.projectIds || []).length %></span></div>
      </div>

      <!-- Technical details (collapsible) -->
      <details class="adp-tech-card">
        <summary class="adp-tech-summary"><i class="bi bi-gear me-1"></i> Technical details</summary>
        <div class="adp-tech-body">
          <div class="adp-tech-row">
            <span class="adp-tech-label">Activity ID</span>
            <span class="adp-tech-val adp-tech-mono"><%= activity.id %></span>
          </div>
          <div class="adp-tech-row">
            <span class="adp-tech-label">Inbound email</span>
            <span class="project-email-chip" style="margin-top:0.2rem;">
              <span class="project-email-addr" style="font-size:0.72rem;"><%= _actEmail %></span>
              <button type="button" class="project-email-copy" title="Copy" onclick="(function(btn){navigator.clipboard.writeText(btn.previousElementSibling.textContent).then(function(){btn.innerHTML='<i class=\'bi bi-check-lg\'></i>';setTimeout(function(){btn.innerHTML='<i class=\'bi bi-copy\'></i>';},1500)});})(this)"><i class="bi bi-copy"></i></button>
            </span>
          </div>
          <p class="project-email-hint" style="margin-top:0.4rem;">CC this address when emailing clients — replies appear here automatically.</p>
        </div>
      </details>

      <!-- Shared with -->
      <div class="pnew-card adp-share-card">
        <div class="adp-share-header">
          <div class="pnew-card-title" style="margin:0;"><i class="bi bi-people me-1" style="color:var(--crm-accent);font-size:0.9em;"></i> Shared with</div>
          <% if (_canManage && _notShared.length) { %>
            <button type="button" class="adp-manage-btn" onclick="document.getElementById('adpSharePanel').toggleAttribute('hidden')">
              <i class="bi bi-person-plus"></i>
            </button>
          <% } %>
        </div>

        <% if (activity.participants && activity.participants.length) { %>
          <div class="adp-avatar-stack">
            <% activity.participants.slice(0, 5).forEach(p => { %>
              <span class="adp-avatar-tip" title="<%= p.name %>">
                <span class="adp-avatar-sm"><%= (p.name||'?').trim().charAt(0).toUpperCase() %></span>
              </span>
            <% }) %>
            <% if (activity.participants.length > 5) { %>
              <span class="adp-avatar-sm adp-avatar-more">+<%= activity.participants.length - 5 %></span>
            <% } %>
          </div>
          <div class="adp-share-list">
            <% activity.participants.forEach(p => { %>
              <div class="adp-share-row">
                <span class="adp-avatar-sm"><%= (p.name||'?').trim().charAt(0).toUpperCase() %></span>
                <div style="flex:1;min-width:0;">
                  <div class="adp-share-name"><%= p.name %></div>
                  <% if (p.title) { %><div class="adp-share-title"><%= p.title %></div><% } %>
                </div>
                <% if (_canManage) { %>
                  <form action="/activities/<%= activity.id %>/share/remove" method="POST" style="margin:0;">
                    <input type="hidden" name="removeId" value="<%= p.id %>">
                    <button type="submit" class="adp-share-remove" title="Remove" onclick="return confirm('Remove <%= p.name %> from shared access?')"><i class="bi bi-x-lg"></i></button>
                  </form>
                <% } %>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <p class="adp-share-empty">Not shared with anyone yet.</p>
        <% } %>

        <!-- Add people panel (hidden by default) -->
        <% if (_canManage && _notShared.length) { %>
          <div id="adpSharePanel" hidden>
            <form action="/activities/<%= activity.id %>/share" method="POST">
              <div class="act-picker-list" style="margin-top:0.5rem;">
                <% _notShared.forEach(u => { %>
                  <label class="act-picker-row">
                    <input type="checkbox" name="shareWithIds" value="<%= u.id %>">
                    <span class="adp-avatar-sm" style="background:oklch(0.55 0.18 250);"><%= (u.name||'?').trim().charAt(0).toUpperCase() %></span>
                    <span style="flex:1;min-width:0;">
                      <span style="font-size:0.83rem;font-weight:600;"><%= u.name %></span>
                      <% if (u.title) { %><span style="font-size:0.72rem;color:var(--crm-muted-fg);margin-left:0.3rem;"><%= u.title %></span><% } %>
                    </span>
                  </label>
                <% }) %>
              </div>
              <button type="submit" class="act-picker-btn">Share</button>
            </form>
          </div>
        <% } %>
      </div>

      <!-- Quick actions -->
      <div class="adp-quick-actions">
        <% if (_canManage) { %>
          <button type="button" class="adp-quick-btn" onclick="document.getElementById('adpCreateProjectModal').removeAttribute('hidden')">
            <i class="bi bi-kanban"></i> Create project
          </button>
        <% } %>
        <a href="/activities/new" class="adp-quick-btn adp-quick-btn--outline">
          <i class="bi bi-plus-lg"></i> Log follow-up activity
        </a>
      </div>

    </div> <!-- /pnew-aside -->

  </div> <!-- /pnew-grid -->

</div> <!-- /adp-page -->

<!-- ── CREATE PROJECT MODAL ──────────────────────────────────────────────── -->
<% if (_canManage) { %>
<div id="adpCreateProjectModal" class="adp-modal-backdrop" hidden>
  <div class="adp-modal" role="dialog" aria-modal="true" aria-label="Create project">
    <div class="adp-modal-header">
      <div class="adp-modal-title"><i class="bi bi-kanban me-1"></i> Create project</div>
      <button type="button" class="adp-modal-close" onclick="document.getElementById('adpCreateProjectModal').setAttribute('hidden','')" aria-label="Close"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="adp-modal-body">
      <p class="adp-modal-desc">Turn this activity into a tracked project.</p>
      <form action="/activities/<%= activity.id %>/projects/new" method="POST">
        <div class="adp-modal-field">
          <label class="pnew-field-label">Project name <span class="pnew-required">*</span></label>
          <input type="text" name="projectName" required value="<%= activity.name %>" class="pnew-input">
        </div>
        <div class="adp-modal-field">
          <label class="pnew-field-label">Assign to</label>
          <select name="assigneeId" class="pnew-select">
            <option value="">— No one —</option>
            <% (teamUsers||[]).forEach(u => { %>
              <option value="<%= u.id %>"><%= u.name %><%= u.title ? ' · ' + u.title : '' %></option>
            <% }) %>
          </select>
        </div>
        <div class="adp-modal-actions">
          <button type="button" class="pnew-btn-cancel" onclick="document.getElementById('adpCreateProjectModal').setAttribute('hidden','')">Cancel</button>
          <button type="submit" class="pnew-btn-save"><i class="bi bi-kanban me-1"></i>Create project</button>
        </div>
      </form>
    </div>
  </div>
</div>
<% } %>

