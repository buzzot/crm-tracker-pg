<%
  const u = profileUser;
  const initial = (u.name || u.email || '?').trim().charAt(0).toUpperCase();
  const color = u.avatarColor || 'indigo';
  const AVATAR_COLORS = [
    { id:'indigo',  label:'Indigo',  bg:'oklch(0.50 0.20 270)' },
    { id:'blue',    label:'Blue',    bg:'oklch(0.52 0.18 250)' },
    { id:'teal',    label:'Teal',    bg:'oklch(0.52 0.14 195)' },
    { id:'emerald', label:'Emerald', bg:'oklch(0.52 0.16 160)' },
    { id:'amber',   label:'Amber',   bg:'oklch(0.62 0.18 72)'  },
    { id:'rose',    label:'Rose',    bg:'oklch(0.52 0.20 10)'  },
    { id:'slate',   label:'Slate',   bg:'oklch(0.35 0.02 265)' },
  ];
  const colorMap = {}; AVATAR_COLORS.forEach(c => colorMap[c.id] = c.bg);
  const avatarBg = colorMap[color] || colorMap['indigo'];

  const _mb = typeof mailbox !== 'undefined' ? mailbox : null;
  const _prov = typeof providers !== 'undefined' ? providers : {};
  const _mbState = !_mb ? 'none' : _mb.verifiedAt ? 'ok' : _mb.lastError ? 'error' : 'untested';
  const profileDone = !!(u.name && u.title && u.phone);
  const emailLabel = { ok:'Connected', error:'Not working', untested:'Saved, not tested', none:'Not set up' }[_mbState];
  const steps = [
    { id:'profile',  icon:'bi-person',      label:'Profile',  state: profileDone ? 'ok' : 'todo', note: profileDone ? 'Complete' : 'Add title and phone' },
    { id:'email',    icon:'bi-envelope',    label:'Email',    state: _mbState === 'ok' ? 'ok' : _mbState === 'error' ? 'bad' : 'todo', note: emailLabel },
    { id:'security', icon:'bi-shield-lock', label:'Security', state: mustChange ? 'bad' : 'ok', note: mustChange ? 'Change password' : 'Password set' },
  ];
  const doneCount = steps.filter(s => s.state === 'ok').length;
%>

<div class="pf">

  <!-- Header -->
  <header class="pf-head">
    <div class="pf-id">
      <div class="prof-avatar-wrap">
        <div class="prof-avatar" id="profAvatar" style="background:<%= avatarBg %>">
          <% if (u.avatarUrl) { %>
            <img src="<%= u.avatarUrl.startsWith('http') ? u.avatarUrl : '/media/' + u.avatarUrl %>" alt="" onerror="this.remove()">
          <% } %>
          <span id="profInitial"><%= initial %></span>
        </div>
      </div>
      <div class="pf-id-text">
        <h1><%= u.name || u.email %></h1>
        <div class="pf-id-meta">
          <span class="au-badge au-badge-<%= u.role %>"><%= u.role %></span>
          <% if (u.title) { %><span><%= u.title %></span><span class="pf-dot">·</span><% } %>
          <span><%= u.email %></span>
        </div>
      </div>
    </div>
    <div class="pf-setup" aria-label="Account setup">
      <div class="pf-setup-top"><span>Account setup</span><b><%= doneCount %>/<%= steps.length %></b></div>
      <div class="pf-setup-bar"><i style="width:<%= Math.round(doneCount / steps.length * 100) %>%"></i></div>
    </div>
  </header>

  <% if (mustChange) { %>
  <div class="pf-banner pf-banner-warn">
    <i class="bi bi-exclamation-triangle-fill"></i>
    <div><strong>Password change required.</strong> Set a personal password before you continue. <a href="#security">Change it now</a></div>
  </div>
  <% } %>

  <div class="pf-layout">
    <!-- Section nav -->
    <nav class="pf-nav" aria-label="Settings sections">
      <% steps.forEach((s, i) => { %>
        <a href="#<%= s.id %>" class="<%= i === 0 ? 'is-active' : '' %>">
          <i class="bi <%= s.icon %>"></i>
          <span class="pf-nav-text"><b><%= s.label %></b><small><%= s.note %></small></span>
          <span class="pf-state pf-state-<%= s.state %>" aria-hidden="true"></span>
        </a>
      <% }) %>
    </nav>

    <div class="pf-main">
      <% if (flash) { %>
        <div class="pf-banner pf-banner-<%= flash.type === 'error' ? 'error' : 'ok' %>" role="status">
          <i class="bi <%= flash.type === 'error' ? 'bi-exclamation-circle-fill' : 'bi-check-circle-fill' %>"></i>
          <div><%= flash.message %></div>
          <button type="button" class="pf-banner-x" aria-label="Dismiss" onclick="this.parentElement.remove()"><i class="bi bi-x-lg"></i></button>
        </div>
      <% } %>

      <!-- Profile -->
      <section class="pf-card" id="profile" aria-labelledby="pfProfileTitle">
        <div class="pf-card-head">
          <div><h2 id="pfProfileTitle">Profile</h2><p>How you appear to your team on projects, tasks and activity.</p></div>
        </div>
        <form action="/profile" method="POST">
          <div class="pf-body">
            <div class="pf-avatar-row">
              <div class="pf-avatar-mini" id="profAvatarMini" style="background:<%= avatarBg %>"><span><%= initial %></span><% if (u.avatarUrl) { %><img src="<%= u.avatarUrl.startsWith('http') ? u.avatarUrl : '/media/' + u.avatarUrl %>" alt="" onerror="this.remove()"><% } %></div>
              <div>
                <div class="pf-avatar-actions">
                  <label class="pg-btn pf-upload" for="avatarFile"><i class="bi bi-upload"></i>Upload photo</label>
                  <span class="pf-hint">or pick a colour</span>
                </div>
                <div class="prof-color-picker" id="colorPicker" role="radiogroup" aria-label="Avatar colour">
                  <% AVATAR_COLORS.forEach(c => { %>
                    <label class="prof-color-swatch <%= c.id === color ? 'selected' : '' %>" title="<%= c.label %>" style="background:<%= c.bg %>">
                      <input type="radio" name="avatarColor" value="<%= c.id %>" class="visually-hidden" <%= c.id === color ? 'checked' : '' %> onchange="onColorChange(this, '<%= c.bg %>')">
                      <% if (c.id === color) { %><i class="bi bi-check-lg"></i><% } %>
                    </label>
                  <% }) %>
                </div>
              </div>
            </div>

            <div class="em-grid">
              <label class="em-field"><span>Full name <b>*</b></span>
                <input type="text" name="name" class="pnew-input" value="<%= u.name || '' %>" placeholder="Your name" required></label>
              <label class="em-field"><span>Title</span>
                <select name="title" class="pnew-input">
                  <option value="">Choose a title</option>
                  <% Object.values(ROLE_TITLES).flat().forEach(t => { %><option value="<%= t %>" <%= u.title === t ? 'selected' : '' %>><%= t %></option><% }) %>
                </select></label>
              <label class="em-field"><span>Login email</span>
                <input type="email" class="pnew-input pf-readonly" value="<%= u.email %>" readonly tabindex="-1">
                <small class="pf-hint"><i class="bi bi-lock"></i> Only an admin can change this.</small></label>
              <label class="em-field"><span>Phone</span>
                <input type="tel" name="phone" class="pnew-input" value="<%= u.phone || '' %>" placeholder="+1 (555) 000-0000"></label>
            </div>
          </div>
          <div class="pf-foot">
            <button type="submit" class="pg-btn pg-btn-primary"><i class="bi bi-check2"></i>Save profile</button>
          </div>
        </form>
        <form action="/profile/avatar" method="POST" enctype="multipart/form-data" id="avatarForm" hidden>
          <input type="file" name="avatar" id="avatarFile" accept="image/*" onchange="this.form.submit()">
        </form>
      </section>

      <!-- Email -->
      <section class="pf-card em-setup" id="email" aria-labelledby="emTitle">
        <div class="pf-card-head">
          <div>
            <h2 id="emTitle">Email</h2>
            <p>Send emails from the CRM as yourself. Each company's tracking address is added in Cc, so replies are logged on the company page<% if (typeof trackingDomain !== 'undefined') { %> (e.g. <code>aaon@<%= trackingDomain %></code>)<% } %>.</p>
          </div>
          <span class="em-status em-status-<%= _mbState %>">
            <% if (_mbState === 'ok') { %><i class="bi bi-check-circle-fill"></i><% } else if (_mbState === 'error') { %><i class="bi bi-exclamation-circle-fill"></i><% } else if (_mbState === 'untested') { %><i class="bi bi-dash-circle"></i><% } else { %><i class="bi bi-circle"></i><% } %><%= emailLabel %>
          </span>
        </div>
        <div class="pf-body pf-body-flush">
          <% if (typeof mailboxError !== 'undefined' && mailboxError) { %><div class="em-alert"><%= mailboxError %></div><% } %>
          <% if (_mb && _mb.lastError) { %><div class="em-alert"><i class="bi bi-exclamation-circle"></i> Last test failed: <%= _mb.lastError %></div><% } %>
          <% if (_mbState === 'untested') { %><div class="pf-nudge"><i class="bi bi-send"></i> Settings saved. Click <b>Send test email</b> below to confirm everything works.</div><% } %>
        </div>
        <form action="/profile/email" method="POST" id="emForm" autocomplete="off">
        <div class="pf-body">
      <h3 class="pf-step"><span>1</span>Sender</h3>
      <div class="em-grid">
        <label class="em-field em-span2"><span>Your work email <b>*</b></span>
          <input type="email" name="email" id="emEmail" class="pnew-input" required value="<%= _mb ? _mb.email : (profileUser && profileUser.email) || '' %>" placeholder="marsel@samyouusa.com"></label>
        <label class="em-field"><span>Name shown to recipients</span>
          <input type="text" name="displayName" class="pnew-input" value="<%= _mb ? (_mb.displayName || '') : (profileUser && profileUser.name) || '' %>" placeholder="Marsel"></label>
      </div>

      <% var _method = _mb ? _mb.method : 'mailgun'; %>
      <h3 class="pf-step"><span>2</span>Delivery</h3>
      <div class="em-method" role="radiogroup" aria-label="How to send">
        <label class="em-method-opt">
          <input type="radio" name="method" value="mailgun" <%= _method === 'mailgun' ? 'checked' : '' %>>
          <span><b>Send via Mailgun</b><small>Recommended. Works on our server; no mailbox password needed.</small></span>
        </label>
        <label class="em-method-opt">
          <input type="radio" name="method" value="smtp" <%= _method === 'smtp' ? 'checked' : '' %>>
          <span><b>Send via my mailbox (SMTP)</b><small>Uses your mailbox server directly. Blocked on some hosting plans.</small></span>
        </label>
      </div>

      <div id="emMg" class="em-mg" <%= _method === 'mailgun' ? '' : 'hidden' %>>
        <% if (typeof mailgunReady !== 'undefined' && !mailgunReady) { %>
          <div class="em-alert"><i class="bi bi-exclamation-circle"></i> Mailgun is not set up on the server yet. An admin needs to add <code>MAILGUN_API_KEY</code> in Railway → Variables.</div>
        <% } %>
        <div class="em-mg-status" id="emMgStatus" aria-live="polite"><i class="bi bi-hourglass-split"></i> Checking your domain in Mailgun…</div>
        <div class="em-mg-records" id="emMgRecords" hidden>
          <p class="em-help">Add these records in your domain's DNS (for <b>samyouusa.com</b> that is Alibaba Cloud DNS), then click <b>Verify</b> in Mailgun. If the domain already has an SPF record (<code>v=spf1 …</code>), don't add a second one: add <code>include:mailgun.org</code> to the existing one. Don't change MX records.</p>
          <table class="em-dns"><thead><tr><th>Type</th><th>Host</th><th>Value</th><th></th></tr></thead><tbody id="emMgRows"></tbody></table>
        </div>
        <label class="em-check"><input type="checkbox" name="bccSelf" value="1" <%= !_mb || _mb.bccSelf ? 'checked' : '' %>> Bcc me a copy, so sent emails also show up in my own inbox</label>
      </div>

      <div id="emSmtp" <%= _method === 'smtp' ? '' : 'hidden' %>>
      <div class="em-detect" id="emDetect" aria-live="polite">
        <i class="bi bi-magic"></i><span id="emDetectText"><%= _mb && _mb.provider && _prov[_mb.provider] ? _prov[_mb.provider].label : 'We will detect your email provider from the address.' %></span>
      </div>

      <div class="em-grid">
        <label class="em-field"><span>Provider</span>
          <select name="provider" id="emProvider" class="pnew-input">
            <% Object.keys(_prov).forEach(k => { %><option value="<%= k %>" <%= _mb && _mb.provider === k ? 'selected' : '' %>><%= _prov[k].label %></option><% }) %>
          </select></label>
        <label class="em-field"><span>SMTP server <b>*</b></span>
          <input type="text" name="host" id="emHost" class="pnew-input" required value="<%= _mb ? _mb.host : '' %>" placeholder="smtp.office365.com"></label>
        <div class="em-row">
          <label class="em-field"><span>Port</span><input type="number" name="port" id="emPort" class="pnew-input" required value="<%= _mb ? _mb.port : 465 %>" min="1" max="65535"></label>
          <label class="em-field"><span>Security</span>
            <select name="secure" id="emSecure" class="pnew-input">
              <option value="ssl" <%= !_mb || _mb.secure === 'ssl' ? 'selected' : '' %>>SSL (465)</option>
              <option value="starttls" <%= _mb && _mb.secure === 'starttls' ? 'selected' : '' %>>STARTTLS (587)</option>
            </select></label>
        </div>
        <label class="em-field"><span>Username</span>
          <input type="text" name="user" id="emUser" class="pnew-input" value="<%= _mb ? _mb.user : '' %>" placeholder="Usually your full email"></label>
        <label class="em-field"><span>Password or app password <%= _mb && _mb.hasPassword ? '' : '*' %></span>
          <input type="password" name="password" class="pnew-input" autocomplete="new-password" placeholder="<%= _mb && _mb.hasPassword ? 'Saved. Leave empty to keep it' : 'App password recommended' %>"></label>
      </div>
      <p class="em-help" id="emHelp"><%= _mb && _mb.provider && _prov[_mb.provider] ? _prov[_mb.provider].help : '' %></p>
      <p class="em-help"><i class="bi bi-shield-lock"></i> Your password is stored encrypted and is only used to send emails you choose to send.</p>
      </div>

      <h3 class="pf-step"><span>3</span>Signature <span class="em-opt">added below every email</span></h3>
      <label class="em-field"><span class="visually-hidden">Signature</span>
        <textarea name="signature" class="pnew-input em-sig" rows="4" placeholder="Marsel&#10;Samyou USA · +1 …&#10;www.samyouusa.com"><%= _mb ? _mb.signature : '' %></textarea></label>

        </div>
      <div class="pf-foot">
        <% if (_mb) { %><button type="submit" form="emRemoveForm" class="pf-link-danger">Disconnect</button><% } %>
        <span class="em-test-result" id="emTestResult" role="status" aria-live="polite"></span>
        <% if (_mb) { %><button type="button" class="pg-btn" id="emTest"><i class="bi bi-send"></i>Send test email</button><% } %>
        <button type="submit" class="pg-btn pg-btn-primary"><i class="bi bi-check2"></i>Save email settings</button>
      </div>
    </form>
        <% if (_mb) { %><form action="/profile/email/remove" method="POST" id="emRemoveForm" hidden onsubmit="return confirm('Disconnect your email from the CRM? Saved drafts are kept.')"></form><% } %>
      </section>

  <script>
  (function () {
    var form = document.getElementById('emForm'); if (!form) return;
    var email = document.getElementById('emEmail'), prov = document.getElementById('emProvider');
    var host = document.getElementById('emHost'), port = document.getElementById('emPort'), sec = document.getElementById('emSecure');
    var user = document.getElementById('emUser'), help = document.getElementById('emHelp'), dtext = document.getElementById('emDetectText');
    var PROV = <%- JSON.stringify(_prov).replace(/</g, '\\u003c') %>;
    var last = '';
    function apply(key, force) {
      var p = PROV[key]; if (!p) return;
      prov.value = key; help.textContent = p.help || '';
      if (force || !host.value) { if (p.host) host.value = p.host; port.value = p.port; sec.value = p.secure; }
    }
    function detect() {
      var v = email.value.trim(); if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(v) || v === last) return;
      last = v; if (!user.value) user.placeholder = v;
      dtext.textContent = 'Detecting your email provider…';
      fetch('/profile/email/detect?email=' + encodeURIComponent(v), { credentials: 'same-origin' })
        .then(function (r) { return r.json(); })
        .then(function (d) {
          dtext.textContent = d.key === 'other' ? 'Provider not recognised. Enter your SMTP settings below.' : 'Detected: ' + d.label + '. Settings filled in below.';
          apply(d.key, d.key !== 'other');
        })
        .catch(function () { dtext.textContent = 'Could not detect the provider. Enter your SMTP settings below.'; });
    }
    email.addEventListener('blur', function () { if (method() === 'smtp') detect(); });
    email.addEventListener('change', function () { if (method() === 'smtp') detect(); });
    prov.addEventListener('change', function () { apply(prov.value, true); });
    var smtpBox = document.getElementById('emSmtp'), mgBox = document.getElementById('emMg');
    function method() { var r = form.querySelector('input[name=method]:checked'); return r ? r.value : 'mailgun'; }
    function syncMethod() {
      var m = method();
      smtpBox.hidden = m !== 'smtp'; mgBox.hidden = m !== 'mailgun';
      host.required = port.required = m === 'smtp';
      if (m === 'smtp' && !host.value) detect();
      if (m === 'mailgun') mgStatus();
    }
    var mgEl = document.getElementById('emMgStatus'), mgRec = document.getElementById('emMgRecords'), mgRows = document.getElementById('emMgRows');
    var mgFor = '';
    function esc(t) { return String(t == null ? '' : t).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
    function mgStatus() {
      var v = email.value.trim(); if (!/@/.test(v) || v === mgFor) return; mgFor = v;
      mgEl.className = 'em-mg-status'; mgEl.innerHTML = '<i class="bi bi-hourglass-split"></i> Checking your domain in Mailgun…'; mgRec.hidden = true;
      fetch('/profile/email/mailgun-status?email=' + encodeURIComponent(v), { credentials: 'same-origin' })
        .then(function (r) { return r.json(); })
        .then(function (d) {
          var dom = esc(d.domain || v.split('@')[1]);
          if (d.configured === false) { mgEl.className = 'em-mg-status is-warn'; mgEl.innerHTML = '<i class="bi bi-exclamation-circle"></i> Mailgun is not connected on the server yet.'; return; }
          if (d.error || d.ok === false) { mgEl.className = 'em-mg-status is-warn'; mgEl.innerHTML = '<i class="bi bi-exclamation-circle"></i> ' + esc(d.error || 'Could not check Mailgun.'); return; }
          if (d.exists === false) { mgEl.className = 'em-mg-status is-warn'; mgEl.innerHTML = '<i class="bi bi-exclamation-circle"></i> <b>' + dom + '</b> is not added in Mailgun yet. Add it under Mailgun → Sending → Domains, then reload this page to see the DNS records.'; return; }
          if (d.active) { mgEl.className = 'em-mg-status is-ok'; mgEl.innerHTML = '<i class="bi bi-check-circle-fill"></i> <b>' + dom + '</b> is verified in Mailgun. You can send.'; }
          else { mgEl.className = 'em-mg-status is-warn'; mgEl.innerHTML = '<i class="bi bi-exclamation-circle"></i> <b>' + dom + '</b> is added in Mailgun but not verified yet (' + esc(d.state) + '). Add the DNS records below.'; }
          var recs = d.records || [];
          if (recs.length && !d.active) {
            mgRows.innerHTML = recs.map(function (x) {
              return '<tr><td>' + esc(x.type) + '</td><td><code>' + esc(x.name) + '</code></td><td><code class="em-dns-val">' + esc(x.value) + '</code>' + (x.note ? '<small class="em-dns-note">' + esc(x.note) + '</small>' : '') + '</td><td>' + (x.valid ? '<span class="em-ok">✓ found</span>' : '<span class="em-miss">missing</span>') + '</td></tr>';
            }).join('');
            mgRec.hidden = false;
          }
        })
        .catch(function () { mgEl.className = 'em-mg-status is-warn'; mgEl.textContent = 'Could not check Mailgun right now.'; });
    }
    form.querySelectorAll('input[name=method]').forEach(function (r) { r.addEventListener('change', syncMethod); });
    email.addEventListener('blur', function () { if (method() === 'mailgun') mgStatus(); });
    syncMethod();

    var test = document.getElementById('emTest'), out = document.getElementById('emTestResult');
    if (test) test.addEventListener('click', function () {
      test.disabled = true; out.className = 'em-test-result'; out.textContent = 'Sending…';
      fetch('/profile/email/test', { method: 'POST', credentials: 'same-origin', headers: { 'Accept': 'application/json' } })
        .then(function (r) { return r.json().then(function (j) { return r.ok && j.ok ? j : Promise.reject(j); }); })
        .then(function (j) { out.className = 'em-test-result is-ok'; out.textContent = j.message; setTimeout(function () { location.reload(); }, 1800); })
        .catch(function (e) { out.className = 'em-test-result is-error'; out.textContent = (e && e.error) || 'Test failed.'; })
        .then(function () { test.disabled = false; });
    });
  })();
  </script>

      <!-- Security -->
      <section class="pf-card<%= mustChange ? ' pf-card-attn' : '' %>" id="security" aria-labelledby="pfSecTitle">
        <div class="pf-card-head">
          <div><h2 id="pfSecTitle">Security</h2><p>Change the password you use to sign in. Use at least 8 characters with a mix of letters, numbers and symbols.</p></div>
        </div>
        <form action="/profile/password" method="POST" id="pwdForm">
          <div class="pf-body">
            <label class="em-field pf-half"><span>Current password</span>
              <span class="pf-pw"><input type="password" name="currentPassword" id="curPwd" class="pnew-input" required autocomplete="current-password">
              <button type="button" class="prof-eye-btn" onclick="toggleEye('curPwd','curEye')" aria-label="Show password"><i class="bi bi-eye" id="curEye"></i></button></span></label>
            <div class="em-grid">
              <label class="em-field"><span>New password</span>
                <span class="pf-pw"><input type="password" name="newPassword" id="newPwd" class="pnew-input" required autocomplete="new-password" oninput="onPwdInput(this.value)">
                <button type="button" class="prof-eye-btn" onclick="toggleEye('newPwd','newEye')" aria-label="Show password"><i class="bi bi-eye" id="newEye"></i></button></span></label>
              <label class="em-field"><span>Confirm new password</span>
                <span class="pf-pw"><input type="password" name="confirmPassword" id="confPwd" class="pnew-input" required autocomplete="new-password" oninput="onConfirmInput(this.value)">
                <button type="button" class="prof-eye-btn" onclick="toggleEye('confPwd','confEye')" aria-label="Show password"><i class="bi bi-eye" id="confEye"></i></button></span>
                <span class="prof-match-hint" id="matchHint"></span></label>
            </div>
            <div class="prof-strength-wrap" id="strengthWrap" style="display:none;">
              <div class="prof-strength-bar"><div class="prof-strength-fill" id="strengthFill"></div></div>
              <span class="prof-strength-label" id="strengthLabel"></span>
              <ul class="prof-rules" id="pwdRules">
                <li id="rule-len"><i class="bi bi-circle"></i> 8+ characters</li>
                <li id="rule-upper"><i class="bi bi-circle"></i> Uppercase</li>
                <li id="rule-lower"><i class="bi bi-circle"></i> Lowercase</li>
                <li id="rule-num"><i class="bi bi-circle"></i> Number</li>
                <li id="rule-sym"><i class="bi bi-circle"></i> Symbol</li>
              </ul>
            </div>
          </div>
          <div class="pf-foot">
            <button type="submit" class="pg-btn pg-btn-primary" id="pwdSubmit"><i class="bi bi-shield-lock"></i>Change password</button>
          </div>
        </form>
      </section>
    </div>
  </div>
</div>

<script>
// ── Color picker ──────────────────────────────────────────────────────────────
function onColorChange(input, bg) {
  document.getElementById('profAvatar').style.background = bg;
  const mini = document.getElementById('profAvatarMini'); if (mini) mini.style.background = bg;
  document.querySelectorAll('.prof-color-swatch').forEach(s => { s.classList.remove('selected'); const i = s.querySelector('i'); if (i) i.remove(); });
  const sw = input.closest('.prof-color-swatch'); sw.classList.add('selected');
  sw.insertAdjacentHTML('beforeend', '<i class="bi bi-check-lg"></i>');
}

// ── Section nav: highlight the section in view ────────────────────────────────
(function () {
  const links = [...document.querySelectorAll('.pf-nav a')];
  const secs = links.map(a => document.querySelector(a.getAttribute('href'))).filter(Boolean);
  if (!('IntersectionObserver' in window) || !secs.length) return;
  const io = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) links.forEach(a => a.classList.toggle('is-active', a.getAttribute('href') === '#' + e.target.id)); });
  }, { rootMargin: '-30% 0px -60% 0px' });
  secs.forEach(s => io.observe(s));
})();

// ── Password strength ─────────────────────────────────────────────────────────
const STRENGTH_LABELS = ['', 'Weak', 'Fair', 'Good', 'Strong', 'Strong'];
const STRENGTH_COLORS = ['', '#ef4444', '#f59e0b', '#3b82f6', '#22c55e', '#22c55e'];

function evalRules(pwd) {
  return {
    len:   pwd.length >= 8,
    upper: /[A-Z]/.test(pwd),
    lower: /[a-z]/.test(pwd),
    num:   /[0-9]/.test(pwd),
    sym:   /[^A-Za-z0-9]/.test(pwd),
  };
}

function onPwdInput(pwd) {
  const wrap = document.getElementById('strengthWrap');
  wrap.style.display = pwd ? '' : 'none';
  if (!pwd) return;

  const r = evalRules(pwd);
  const passed = Object.values(r).filter(Boolean).length;

  // Bar
  const fill  = document.getElementById('strengthFill');
  const label = document.getElementById('strengthLabel');
  fill.style.width = (passed / 5 * 100) + '%';
  fill.style.background = STRENGTH_COLORS[passed];
  label.textContent = STRENGTH_LABELS[passed];
  label.style.color = STRENGTH_COLORS[passed];

  // Rule list
  const ruleMap = { len:'rule-len', upper:'rule-upper', lower:'rule-lower', num:'rule-num', sym:'rule-sym' };
  Object.entries(ruleMap).forEach(([key, id]) => {
    const li = document.getElementById(id);
    const icon = li.querySelector('i');
    if (r[key]) {
      icon.className = 'bi bi-check-circle-fill';
      li.style.color = '#22c55e';
    } else {
      icon.className = 'bi bi-circle';
      li.style.color = '';
    }
  });

  // Re-check confirm
  onConfirmInput(document.getElementById('confPwd').value);
}

function onConfirmInput(val) {
  const newPwd = document.getElementById('newPwd').value;
  const hint = document.getElementById('matchHint');
  if (!val) { hint.textContent = ''; return; }
  if (val === newPwd) {
    hint.textContent = '✓ Passwords match';
    hint.style.color = '#22c55e';
  } else {
    hint.textContent = '✗ Does not match';
    hint.style.color = '#ef4444';
  }
}

function toggleEye(inputId, iconId) {
  const inp  = document.getElementById(inputId);
  const icon = document.getElementById(iconId);
  if (inp.type === 'password') { inp.type = 'text'; icon.className = 'bi bi-eye-slash'; }
  else { inp.type = 'password'; icon.className = 'bi bi-eye'; }
}

// Auto-focus password section if must_change=1
<% if (mustChange) { %>
window.addEventListener('DOMContentLoaded', () => {
  document.getElementById('curPwd')?.focus();
  document.getElementById('security')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
});
<% } %>
</script>
