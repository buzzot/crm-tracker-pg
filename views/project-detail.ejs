            <p class="pj-hint msg-edit-note" id="meNote"></p>
            <div class="msg-edit-foot">
              <button type="button" class="pg-btn" data-close-dialog>Cancel</button>
              <button type="submit" class="pg-btn pg-btn-primary"><i class="bi bi-check2" aria-hidden="true"></i>Save changes</button>
            </div>
