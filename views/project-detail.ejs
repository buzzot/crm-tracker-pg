        <div class="note-thread">
          <% if (!orderedComments.length) { %>
            <p class="text-muted mb-0">No comments yet.</p>
          <% } %>
          <% orderedComments.forEach((c, i) => { %>
            <% const cInitial = (c.author || '?').trim().charAt(0).toUpperCase(); %>
            <% if (c.manual) { %>
              <%
                const ch = c.manual.channel, out = c.manual.direction === 'out';
                const chLabel = ch === 'email' ? 'Email' : ch === 'wechat' ? 'WeChat' : 'Message';
                const chIcon = ch === 'email' ? 'bi-envelope-fill' : ch === 'wechat' ? 'bi-wechat' : 'bi-chat-dots-fill';
                const when = c.postedAt ? new Date(c.postedAt) : null;
              %>
              <div class="note-item mm-item mm-<%= ch %>" id="msg-<%= c.id %>">
                <div class="note-item-head">
                  <span class="note-avatar mm-avatar mm-avatar-<%= ch %>"><i class="bi <%= chIcon %>" aria-hidden="true"></i></span>
                  <div class="note-email-meta">
                    <span class="note-email-from"><%= c.author %><% if (c.manual.to) { %> <span class="mm-to">&rarr; <%= c.manual.to %></span><% } %></span>
                    <span class="mm-tags">
                      <span class="mm-tag mm-tag-<%= ch %>"><%= chLabel %> &middot; <%= out ? 'sent' : 'received' %></span>
                      <% if (c.emailSubject) { %><span class="note-email-subj"><%= c.emailSubject %></span><% } %>
                    </span>
                  </div>
                  <span class="text-muted small note-item-time" title="<%= when ? when.toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' }) : '' %>"><%= noteTimeAgo(c.postedAt) %></span><%- msgTools(c) %>
                </div>
                <div class="note-bubble mm-bubble mm-bubble-<%= ch %>">
                  <%- msgBody(c) %>
                  <% if (c.attachments && c.attachments.length) { %>
                    <div class="d-flex flex-wrap gap-2 mt-2">
                      <% c.attachments.forEach(file => { %>
                        <a href="<%= file.url %>" target="_blank" rel="noopener" class="note-link-chip"><i class="bi bi-paperclip"></i><%= file.filename %></a>
                      <% }) %>
                    </div>
                  <% } %>
                  <% if (c.manual.loggedBy || c.manual.editedBy) { %><div class="mm-logged"><% if (c.manual.loggedBy) { %>Logged by <%= c.manual.loggedBy %><% } %><% if (c.manual.editedBy) { %><%= c.manual.loggedBy ? ' · ' : '' %>Edited by <%= c.manual.editedBy %><% } %></div><% } %>
                </div>
              </div>
            <% } else if (c.type === 'email') { %>
              <div class="note-item note-item-email" id="msg-<%= c.id %>">
                <div class="note-item-head">
                  <span class="note-avatar note-avatar-email"><i class="bi bi-envelope-fill"></i></span>
                  <div class="note-email-meta">
                    <span class="note-email-from"><%= c.author %></span>
                    <span class="note-email-subj"><%= c.emailSubject || '(no subject)' %></span>
                  </div>
                  <span class="text-muted small note-item-time"><%= noteTimeAgo(c.postedAt) %></span><%- msgTools(c) %>
                </div>
                <div class="note-bubble note-email-bubble">
                  <%- msgBody(c) %>
                </div>
              </div>
            <% } else { %>
              <div class="note-item">
                <div class="note-item-head">
                  <span class="note-avatar <%= noteAvatarClasses[i % noteAvatarClasses.length] %>"><%= cInitial %></span>
                  <span class="fw-semibold note-author"><%= c.author || 'Someone' %></span>
                  <span class="text-muted small note-item-time"><%= noteTimeAgo(c.postedAt) %></span><%- msgTools(c) %>
                </div>
                <div class="note-bubble">
                  <div class="note-text"><%= c.comment %></div>
                  <% if (c.link) { %>
                    <a href="<%= c.link %>" target="_blank" rel="noopener" class="note-link-chip"><i class="bi bi-link-45deg"></i><%= c.link %></a>
                  <% } %>
                  <% if (c.attachments && c.attachments.length) { %>
                    <div class="d-flex flex-wrap gap-2 mt-2">
                      <% c.attachments.forEach(file => { %>
                        <a href="<%= file.url %>" target="_blank" rel="noopener" class="note-link-chip"><i class="bi bi-paperclip"></i><%= file.filename %></a>
                      <% }) %>
                    </div>
                  <% } %>
                </div>
              </div>
            <% } %>
          <% }) %>
        </div>

        <% if (_isAdmin) { %>
        <dialog class="msg-dialog" id="msgEditDialog" aria-labelledby="msgEditTitle">
          <form method="POST" id="msgEditForm" class="msg-edit">
            <div class="msg-edit-head">
              <h3 id="msgEditTitle">Edit message</h3>
              <button type="button" class="pj-copy-btn" data-close-dialog aria-label="Close"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <input type="hidden" name="sentAtIso" id="meSentIso">
            <div class="msg-edit-ext">
              <div class="mm-row">
                <div class="mm-seg" role="radiogroup" aria-label="Channel">
                  <label><input type="radio" name="channel" value="email"><span>Email</span></label>
                  <label><input type="radio" name="channel" value="wechat"><span>WeChat</span></label>
                  <label><input type="radio" name="channel" value="other"><span>Other</span></label>
