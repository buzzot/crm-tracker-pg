            <button type="button" class="pg-btn pg-btn-primary" id="shotSubmit" disabled><i class="bi bi-check2" aria-hidden="true"></i>Submit with this text</button>
          </span>
        </div>
      </dialog>

      <script>
        (function () {
          const input = document.getElementById('projectCommentFileInput');
          const label = document.getElementById('projectCommentFileLabel');
          if (input && label) {
            input.addEventListener('change', function () {
              const n = input.files ? input.files.length : 0;
              label.textContent = n ? (n + ' file' + (n === 1 ? '' : 's')) : 'Attach';
            });
          }
        })();

        // ── Log email / WeChat by hand ──────────────────────────────────────
        (function () {
          var form = document.getElementById('mmForm');
          if (!form) return;
          var commentForm = document.getElementById('mmCommentForm');
          var body = document.getElementById('mmBody');
          var from = document.getElementById('mmFrom');
          var to = document.getElementById('mmTo');
          var subj = document.getElementById('mmSubject');
          var subjWrap = document.getElementById('mmSubjectWrap');
          var sent = document.getElementById('mmSent');
          var sentIso = document.getElementById('mmSentIso');
          var files = document.getElementById('mmFiles');
          var fileLabel = document.getElementById('mmFileLabel');
          var ME = <%- JSON.stringify((typeof currentUser !== 'undefined' && currentUser && (currentUser.name || currentUser.email)) || '').replace(/</g, '\\u003c') %>;

          function pad(n) { return (n < 10 ? '0' : '') + n; }
          function toLocalInput(d) { return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) + 'T' + pad(d.getHours()) + ':' + pad(d.getMinutes()); }
          function val(name) { var el = form.querySelector('input[name="' + name + '"]:checked'); return el ? el.value : ''; }

          function setMode(mode) {
            var msg = mode === 'message';
            form.hidden = !msg; commentForm.hidden = msg;
            document.querySelectorAll('.mm-switch-btn').forEach(function (b) {
              var on = b.getAttribute('data-mm-mode') === mode;
              b.classList.toggle('is-active', on); b.setAttribute('aria-selected', on);
            });
            if (msg) { if (!sent.value) sent.value = toLocalInput(new Date()); sync(); setTimeout(function () { body.focus(); }, 0); }
          }
          document.querySelectorAll('[data-mm-mode]').forEach(function (b) {
            b.addEventListener('click', function () { setMode(b.getAttribute('data-mm-mode')); });
          });

          function sync() {
            var ch = val('channel'), out = val('direction') === 'out';
            subjWrap.hidden = ch !== 'email';
            from.placeholder = ch === 'wechat' ? 'Pick a contact or type a WeChat name' : 'Pick a contact or type a name';
            to.placeholder = ch === 'wechat' ? 'Optional, e.g. a person or group chat' : 'Optional, pick one or more';
            if (out && !from.value && ME) from.value = ME;
            if (!out && from.value === ME) from.value = '';
          }
          form.addEventListener('change', function (e) { if (e.target.name === 'channel' || e.target.name === 'direction') sync(); });

          // Parse a pasted email header block (English + common Chinese mail clients)
          var HEADERS = {
            from: /^(from|sender|发件人|寄件人)\s*[:：]\s*(.+)$/i,
            to: /^(to|收件人)\s*[:：]\s*(.+)$/i,
            subject: /^(subject|主题|主旨)\s*[:：]\s*(.+)$/i,
            date: /^(date|sent|发送时间|日期|时间)\s*[:：]\s*(.+)$/i,
            skip: /^(cc|bcc|抄送|密送|reply-to)\s*[:：]/i
          };
          function parseDate(t) {
            var m = t.match(/(\d{4})\s*[年\-\/.]\s*(\d{1,2})\s*[月\-\/.]\s*(\d{1,2})\s*日?[^\d]*(\d{1,2})?[:：]?(\d{2})?/);
            if (m) return new Date(+m[1], +m[2] - 1, +m[3], +(m[4] || 0), +(m[5] || 0));
            var d = new Date(t.replace(/\(.*?\)/g, '').replace(/\s+at\s+/i, ' '));
            return isNaN(d.getTime()) ? null : d;
          }
          function parseHeaders(text) {
            var lines = text.replace(/\r/g, '').split('\n'), got = {}, i = 0, seen = 0;
            for (; i < lines.length; i++) {
              var line = lines[i].trim();
              if (!line) { if (seen) { i++; break; } else continue; }
              var hit = false;
              for (var k in HEADERS) { var m = line.match(HEADERS[k]); if (m) { if (k !== 'skip') got[k] = m[2].trim(); seen++; hit = true; break; } }
              if (!hit) break;
            }
            return seen >= 2 ? { fields: got, rest: lines.slice(i).join('\n').replace(/^\n+/, '') } : null;
          }

          body.addEventListener('paste', function (e) {
            var cd = e.clipboardData; if (!cd) return;
            var imgs = Array.prototype.filter.call(cd.items || [], function (it) { return it.kind === 'file' && it.type.indexOf('image/') === 0; })
              .map(function (it) { return it.getAsFile(); }).filter(Boolean);
            var text = cd.getData('text/plain');
            if (imgs.length && !text) return;   // screenshots: handled by the attachment drop zone
            var parsed = text && parseHeaders(text);
            if (parsed) {
              e.preventDefault();
              var f = parsed.fields;
              if (f.from && !from.value) from.value = cleanAddr(f.from);
              if (f.to && !to.value) to.value = cleanAddr(f.to);
              if (f.subject) { subj.value = f.subject; var em = form.querySelector('input[name="channel"][value="email"]'); em.checked = true; sync(); }
              if (f.date) { var d = parseDate(f.date); if (d) sent.value = toLocalInput(d); }
              body.setRangeText(parsed.rest, body.selectionStart, body.selectionEnd, 'end');
            }
          });

          function updateFiles() {
            if (!fileLabel) return;
            var n = files.files ? files.files.length : 0;
            fileLabel.textContent = n ? n + ' file' + (n === 1 ? '' : 's') + ' attached' : 'Attach files or screenshots';
          }
          files.addEventListener('change', updateFiles);

          form.addEventListener('submit', function (e) {
            from.value = cleanAddr(from.value).trim();
            to.value = cleanAddr(to.value).replace(/[,;]\s*$/, '').trim();
            var hasFiles = files.files && files.files.length;
            if (!from.value.trim()) { e.preventDefault(); from.focus(); from.setCustomValidity('Enter who the message is from'); from.reportValidity(); return; }
            if (!body.value.trim() && !hasFiles) { e.preventDefault(); body.focus(); body.setCustomValidity('Paste the message text or attach a screenshot'); body.reportValidity(); return; }
            var d = sent.value ? new Date(sent.value) : new Date();   // datetime-local is the user's local time
            sentIso.value = isNaN(d.getTime()) ? '' : d.toISOString();
          });
          [from, body].forEach(function (el) { el.addEventListener('input', function () { el.setCustomValidity(''); }); });

          // ── From / To pickers: project company's contacts + your team ──────────
          var PEOPLE = <%- JSON.stringify(typeof messagePeople !== 'undefined' && messagePeople ? messagePeople : { contacts: [], team: [] }).replace(/</g, '\\u003c') %>;
          function fmtPerson(p) { return p.email ? (p.name ? p.name + ' <' + p.email + '>' : p.email) : p.name; }
          function cleanAddr(v) { return String(v || '').replace(/mailto:/gi, '').replace(/\s{2,}/g, ' '); }
          function escH(t) { return String(t == null ? '' : t).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }

          function setupPicker(input) {
            var pop = document.getElementById(input.getAttribute('aria-controls'));
            var multi = input.getAttribute('data-mm-pick') === 'multi';
            var opts = [], active = -1;

            function token() { return multi ? input.value.split(/[,;]/).pop().trim() : input.value.trim(); }
            function groups() {
              var theirs = { label: 'Contacts' + (PEOPLE.companyName ? ' at ' + PEOPLE.companyName : ''), items: PEOPLE.contacts || [] };
              var ours = { label: 'Your team', items: PEOPLE.team || [] };
              // Received: From = them, To = us.  Sent: the other way round.
              var out = val('direction') === 'out';
              var themFirst = (input === from) !== out;
              return themFirst ? [theirs, ours] : [ours, theirs];
            }
            function render() {
              var q = token().toLowerCase(), html = '', n = 0;
              opts = [];
              groups().forEach(function (g) {
                var items = g.items.filter(function (p) { return !q || (p.name + ' ' + p.email + ' ' + p.title).toLowerCase().indexOf(q) !== -1; }).slice(0, 8);
                if (!items.length) return;
                html += '<div class="mm-pop-group">' + escH(g.label) + '</div>';
                items.forEach(function (p) {
                  opts.push(p);
                  html += '<div class="mm-pop-item" role="option" id="' + input.id + '-o' + n + '" data-i="' + n + '">' +
                    '<span class="mm-pop-avatar" aria-hidden="true">' + escH((p.name || p.email || '?').trim().charAt(0).toUpperCase()) + '</span>' +
                    '<span class="mm-pop-text"><span class="mm-pop-name">' + escH(p.name || p.email) + '</span>' +
                    '<span class="mm-pop-sub">' + escH([p.title, p.email].filter(Boolean).join(' · ')) + '</span></span></div>';
                  n++;
                });
              });
              if (!n) {
                var none = (PEOPLE.contacts || []).length || (PEOPLE.team || []).length
                  ? 'No match. Keep typing to use it as is.'
                  : 'No contacts for this project’s company yet.';
                html = '<div class="mm-pop-empty">' + none + '</div>';
              }
              pop.innerHTML = html;
              setActive(n ? 0 : -1);
            }
            function setActive(i) {
              var els = pop.querySelectorAll('.mm-pop-item');
              active = els.length ? (i + els.length) % els.length : -1;
              els.forEach(function (el, j) { el.classList.toggle('is-active', j === active); el.setAttribute('aria-selected', j === active); });
              if (active >= 0) { input.setAttribute('aria-activedescendant', els[active].id); els[active].scrollIntoView({ block: 'nearest' }); }
              else input.removeAttribute('aria-activedescendant');
            }
            function open() { render(); pop.hidden = false; input.setAttribute('aria-expanded', 'true'); }
            function close() { pop.hidden = true; input.setAttribute('aria-expanded', 'false'); input.removeAttribute('aria-activedescendant'); }
            function choose(i) {
              var p = opts[i]; if (!p) return;
              var v = fmtPerson(p);
              if (multi) {
                var parts = input.value.split(/[,;]/).map(function (x) { return x.trim(); }).filter(Boolean);
                if (token()) parts.pop();
                if (parts.indexOf(v) === -1) parts.push(v);
                input.value = parts.join(', ') + ', ';
              } else {
                input.value = v;
              }
              input.setCustomValidity('');
              close(); input.focus();
              if (multi) { setTimeout(open, 0); }
            }

            input.addEventListener('focus', open);
            input.addEventListener('input', function () {
              if (/mailto:/i.test(input.value)) { var pos = input.selectionStart; input.value = cleanAddr(input.value); try { input.setSelectionRange(pos - 7, pos - 7); } catch (e) {} }
              open();
            });
            input.addEventListener('keydown', function (e) {
              if (pop.hidden && (e.key === 'ArrowDown' || e.key === 'ArrowUp')) { open(); e.preventDefault(); return; }
              if (pop.hidden) return;
              if (e.key === 'ArrowDown') { e.preventDefault(); setActive(active + 1); }
              else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(active - 1); }
              else if (e.key === 'Enter' && active >= 0 && opts.length) { e.preventDefault(); choose(active); }
              else if (e.key === 'Escape') { e.preventDefault(); e.stopPropagation(); close(); }
              else if (e.key === 'Tab') { close(); }
            });
            input.addEventListener('blur', function () {
              setTimeout(close, 120);
              input.value = cleanAddr(input.value).replace(/[,;]\s*$/, '').trim();
            });
            pop.addEventListener('mousedown', function (e) {
              var el = e.target.closest('.mm-pop-item'); if (!el) return;
              e.preventDefault(); choose(+el.getAttribute('data-i'));
            });
            pop.addEventListener('mousemove', function (e) {
              var el = e.target.closest('.mm-pop-item'); if (el && +el.getAttribute('data-i') !== active) setActive(+el.getAttribute('data-i'));
            });
            document.querySelector('[data-mm-open="' + input.id + '"]').addEventListener('mousedown', function (e) {
              e.preventDefault(); if (pop.hidden) { input.focus(); open(); } else close();
            });
          }
          setupPicker(from);
          setupPicker(to);

          if (document.querySelector('.mm-alert') || location.hash === '#log-message') setMode('message');
        })();
      </script>

      <!-- Files -->
      <section class="pj-card" id="files" aria-labelledby="pjFilesTitle">
        <div class="pj-card-head">
          <div>
            <h2 class="pj-card-title" id="pjFilesTitle">Files <span class="pj-n"><%= project.attachments.length %></span></h2>
          </div>
        </div>
        <% if (project.attachments.length) { %>
          <ul class="pj-files">
            <% project.attachments.forEach(file => {
                 const ext = (file.filename || '').split('.').pop().toLowerCase();
                 const ic = { pdf: 'bi-file-earmark-pdf', doc: 'bi-file-earmark-word', docx: 'bi-file-earmark-word', xls: 'bi-file-earmark-excel', xlsx: 'bi-file-earmark-excel', csv: 'bi-file-earmark-excel', png: 'bi-file-earmark-image', jpg: 'bi-file-earmark-image', jpeg: 'bi-file-earmark-image', gif: 'bi-file-earmark-image', zip: 'bi-file-earmark-zip' }[ext] || 'bi-file-earmark'; %>
              <li><a href="<%= file.url %>" target="_blank" rel="noopener"><i class="bi <%= ic %>" aria-hidden="true"></i><span><%= file.filename %></span><i class="bi bi-box-arrow-up-right pj-files-open" aria-hidden="true"></i></a></li>
            <% }) %>
          </ul>
        <% } %>
        <form action="/projects/<%= project.id %>/attachments" method="POST" enctype="multipart/form-data" class="pj-upload" id="pjUpload">
          <input type="file" name="attachments" id="projectAttachInput" multiple required hidden>
          <label for="projectAttachInput" class="pj-drop" id="pjDrop">
            <i class="bi bi-cloud-arrow-up" aria-hidden="true"></i>
            <span id="projectAttachLabel"><strong>Drop files</strong> or click to choose</span>
          </label>
          <button type="submit" class="pg-btn pg-btn-primary" id="pjUploadBtn" hidden><i class="bi bi-upload" aria-hidden="true"></i>Upload</button>
        </form>
      </section>
    </div>

    <!-- ── Sidebar ─────────────────────────────────────────────────────── -->
    <aside class="pj-side">

      <section class="pj-card pj-side-card" aria-labelledby="pjDetailsTitle">
        <h2 class="pj-side-title" id="pjDetailsTitle">Details</h2>
        <dl class="pj-dl">
          <dt>Company</dt>
          <dd><% if ((project.companies || []).length) { %><% project.companies.forEach((c, i) => { %><a href="/companies/<%= c.id %>"><%= c.name %></a><%= i < project.companies.length - 1 ? ', ' : '' %><% }) %><% } else { %><span class="pj-muted">—</span><% } %></dd>
          <% if (project.deals && project.deals.length) { %>
            <dt>Deal</dt><dd><% project.deals.forEach((d, i) => { %><a href="/deals/<%= d.id %>"><%= d.name %></a><%= i < project.deals.length - 1 ? ', ' : '' %><% }) %></dd>
          <% } %>
          <dt>Status</dt><dd><%= project.status || '—' %></dd>
          <dt>Category</dt><dd><%= project.category || '—' %></dd>
          <dt>Window</dt><dd><%= windowLabel || '—' %></dd>
          <dt>Products</dt>
          <dd>
            <% if (project.products.length) { %>
              <span class="pj-tags"><% project.products.forEach(pr => { %><a href="/products/<%= pr.id %>" class="pj-tag" title="<%= pr.category || '' %>"><%= pr.name %></a><% }) %></span>
            <% } else { %><span class="pj-muted">None</span><% } %>
          </dd>
          <dt>Created</dt><dd><%= fmtDate(project.createdAt) || '—' %><% if (project.createdByName) { %> <span class="pj-muted">by <%= project.createdByName %></span><% } %></dd>
          <% if (project.updatedAt && project.updatedByName) { %>
            <dt>Last edited</dt><dd><%= fmtDate(project.updatedAt) %> <span class="pj-muted">by <%= project.updatedByName %></span></dd>
          <% } %>
        </dl>
      </section>

      <section class="pj-card pj-side-card" aria-labelledby="pjPeopleTitle">
        <h2 class="pj-side-title" id="pjPeopleTitle">People</h2>

        <div class="pj-person-row">
          <div class="pj-person-label">Owner</div>
          <div class="pj-person-val">
            <% if (project.ownerId) { %><span class="pj-av" style="background:<%- avatarBg(project.ownerName) %>"><%= initial(project.ownerName) %></span><span><%= project.ownerName %></span><% } else { %><span class="pj-muted">Not set</span><% } %>
          </div>
          <% if (_canManage) { %><button type="button" class="pj-link-btn" data-bs-toggle="collapse" data-bs-target="#projOwnerPicker" aria-expanded="false">Change</button><% } %>
        </div>
        <% if (_canManage) { %>
          <div class="collapse" id="projOwnerPicker">
            <form action="/projects/<%= project.id %>/owner" method="POST" class="pj-inline-form">
              <select name="ownerId" class="pj-select" aria-label="Owner">
                <option value="">No owner</option>
                <% (project.teamUsers || []).forEach(u => { %><option value="<%= u.id %>" <%= project.ownerId === u.id ? 'selected' : '' %>><%= u.name %><% if (u.title) { %> · <%= u.title %><% } %></option><% }) %>
              </select>
              <button type="submit" class="pg-btn pg-btn-primary">Save</button>
            </form>
          </div>
        <% } %>

        <div class="pj-person-row">
          <div class="pj-person-label">Auditor</div>
          <div class="pj-person-val">
            <% if (project.auditorName) { %><span class="pj-av" style="background:<%- avatarBg(project.auditorName) %>"><%= initial(project.auditorName) %></span><span><%= project.auditorName %></span><% } else { %><span class="pj-muted">Not set</span><% } %>
          </div>
          <% if (_canManage) { %><button type="button" class="pj-link-btn" data-bs-toggle="collapse" data-bs-target="#projAuditorPicker" aria-expanded="false">Change</button><% } %>
        </div>
        <% if (_canManage) { %>
          <div class="collapse" id="projAuditorPicker">
            <form action="/projects/<%= project.id %>/auditor" method="POST" class="pj-inline-form">
              <select name="auditorId" class="pj-select" aria-label="Auditor">
                <option value="">No auditor</option>
                <% (project.teamUsers || []).filter(u => ['Admin','Manager','Head R&D Controllers','Head R&D VFD'].includes(u.role)).forEach(u => { %><option value="<%= u.id %>" <%= project.auditorId === u.id ? 'selected' : '' %>><%= u.name %><% if (u.title) { %> · <%= u.title %><% } %></option><% }) %>
              </select>
              <button type="submit" class="pg-btn pg-btn-primary">Save</button>
            </form>
          </div>
        <% } %>

        <div class="pj-person-row pj-person-row-top">
          <div class="pj-person-label">Team</div>
          <div class="pj-person-val pj-team">
            <% if (project.assignees && project.assignees.length) { %>
              <% project.assignees.forEach(a => { %><span class="pj-team-item"><span class="pj-av" style="background:<%- avatarBg(a.name) %>"><%= initial(a.name) %></span><span><%= a.name %></span></span><% }) %>
            <% } else { %><span class="pj-muted">No one assigned</span><% } %>
          </div>
          <% if (_canManage) { %><button type="button" class="pj-link-btn" data-bs-toggle="collapse" data-bs-target="#projAssigneePicker" aria-expanded="false">Edit</button><% } %>
        </div>
        <% if (_canManage) { %>
          <div class="collapse" id="projAssigneePicker">
            <form action="/projects/<%= project.id %>/assignees" method="POST">
              <div class="pj-checklist">
                <% (project.teamUsers || []).forEach(u => { %>
                  <label class="pj-check">
                    <input type="checkbox" name="userIds" value="<%= u.id %>" <%= (project.assigneeIds || []).includes(u.id) ? 'checked' : '' %>>
                    <span class="pj-av pj-av-xs" style="background:<%- avatarBg(u.name) %>"><%= initial(u.name) %></span>
                    <span><%= u.name %><% if (u.title) { %> <span class="pj-muted">· <%= u.title %></span><% } %></span>
                  </label>
                <% }) %>
              </div>
              <button type="submit" class="pg-btn pg-btn-primary pj-full">Save team</button>
            </form>
          </div>
        <% } %>
      </section>

      <section class="pj-card pj-side-card" aria-labelledby="pjEmailTitle">
        <h2 class="pj-side-title" id="pjEmailTitle">Project email</h2>
        <% const _projEmail = 'project-' + project.id + '@' + emailDomain; %>
        <div class="pj-copy">
          <span class="pj-copy-text" id="projEmailAddr" title="<%= _projEmail %>"><%= _projEmail %></span>
          <button type="button" class="pj-copy-btn" id="pjCopyEmail" aria-label="Copy project email address"><i class="bi bi-copy" aria-hidden="true"></i></button>
        </div>
        <p class="pj-hint">Put this address in Reply-To or CC when emailing the client. Their replies appear in the conversation automatically.</p>
      </section>

      <% if (project.linkedActivities && project.linkedActivities.length) { %>
        <section class="pj-card pj-side-card" aria-labelledby="pjSrcTitle">
          <h2 class="pj-side-title" id="pjSrcTitle">Source activities</h2>
          <ul class="pj-links">
            <% project.linkedActivities.forEach(act => { %>
              <li><a href="/activities/<%= act.id %>"><span><%= act.name || '(untitled)' %></span><span class="pj-muted"><%= [act.type, act.result].filter(Boolean).join(' · ') %></span></a></li>
            <% }) %>
          </ul>
        </section>
      <% } %>

      <% if (_canRd) { %>
        <section class="pj-card pj-side-card pj-setting <%= project.isRdIssue ? 'is-on' : '' %>">
          <div class="pj-setting-text">
            <h2 class="pj-side-title"><i class="bi bi-cpu" aria-hidden="true"></i> R&amp;D issue</h2>
            <p class="pj-hint"><%= project.isRdIssue ? 'Visible to Engineering members assigned to a task here.' : 'Turn on to let assigned Engineering members see this project.' %></p>
          </div>
          <form action="/projects/<%= project.id %>/toggle-rd" method="POST">
            <button type="submit" class="pj-switch <%= project.isRdIssue ? 'is-on' : '' %>" role="switch" aria-checked="<%= project.isRdIssue ? 'true' : 'false' %>" aria-label="R&amp;D issue"><span></span></button>
          </form>
        </section>
      <% } %>
    </aside>
  </div>
</div>

<script>
(function () {
  // "Log message" header button opens the composer in log mode
  var logBtn = document.querySelector('[data-pj-log]');
  if (logBtn) logBtn.addEventListener('click', function (e) {
    var sw = document.querySelector('[data-mm-mode="message"]');
    if (sw) { e.preventDefault(); sw.click(); document.getElementById('comments').scrollIntoView({ behavior: 'smooth', block: 'start' }); }
  });

  // Long descriptions collapse to a few lines
  var brief = document.getElementById('pjBrief'), more = document.getElementById('pjBriefMore');
  if (brief && more && brief.scrollHeight > brief.clientHeight + 4) {
    more.hidden = false;
    more.addEventListener('click', function () { var open = brief.classList.toggle('is-open'); more.textContent = open ? 'Show less' : 'Show more'; });
  }

  // Copy project email
  var copy = document.getElementById('pjCopyEmail');
  if (copy) copy.addEventListener('click', function () {
    navigator.clipboard.writeText(document.getElementById('projEmailAddr').textContent.trim()).then(function () {
      copy.innerHTML = '<i class="bi bi-check-lg"></i>'; setTimeout(function () { copy.innerHTML = '<i class="bi bi-copy"></i>'; }, 1500);
    });
  });

  // ── AI: conversation summary ──────────────────────────────────────────
  var PROJECT_ID = <%- JSON.stringify(project.id) %>;
  var aiBtn = document.getElementById('aiSummaryBtn'), aiPanel = document.getElementById('aiPanel');
  function esc(t) { return String(t == null ? '' : t).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
  function ago(iso) { var s = Math.floor((Date.now() - new Date(iso)) / 1000); return s < 60 ? 'just now' : s < 3600 ? Math.floor(s / 60) + 'm ago' : s < 86400 ? Math.floor(s / 3600) + 'h ago' : new Date(iso).toLocaleDateString(); }
  function notSetUp() {
    return aiBtn.getAttribute('data-is-admin') === '1'
      ? 'AI is not set up yet. Add <code>ANTHROPIC_API_KEY</code> in Railway → Variables, then redeploy.'
      : 'AI summaries are not available yet. Ask an admin to turn them on.';
  }
  function post(url) {
    return fetch(url, { method: 'POST', credentials: 'same-origin', headers: { 'Accept': 'application/json' } })
      .then(function (r) { return r.json().catch(function () { return {}; }).then(function (j) { return r.ok && j.ok ? j : Promise.reject(j); }); });
  }
  function renderSummary(d) {
    var sent = { positive: ['Positive', 'is-pos'], neutral: ['Neutral', 'is-neu'], concerned: ['Needs attention', 'is-neg'] }[d.sentiment] || ['Neutral', 'is-neu'];
    var h = '<div class="ai-head"><span class="ai-badge"><i class="bi bi-stars"></i>AI summary</span><span class="ai-tone ' + sent[1] + '">' + sent[0] + '</span>' +
      '<button type="button" class="pj-copy-btn ai-close" aria-label="Close summary"><i class="bi bi-x-lg"></i></button></div>';
    if (d.summary) h += '<p class="ai-summary">' + esc(d.summary) + '</p>';
    if (d.latest) h += '<p class="ai-latest"><strong>Latest:</strong> ' + esc(d.latest) + '</p>';
    if (d.actionItems && d.actionItems.length) {
      h += '<div class="ai-sec"><div class="ai-sec-title">Action items</div><ul class="ai-list">' + d.actionItems.map(function (a) {
        return '<li><span class="ai-owner">' + esc(a.owner || '—') + '</span><span>' + esc(a.item) + (a.due ? ' <span class="ai-due">' + esc(a.due) + '</span>' : '') + '</span></li>';
      }).join('') + '</ul></div>';
    }
    if (d.openQuestions && d.openQuestions.length) {
      h += '<div class="ai-sec"><div class="ai-sec-title">Open questions</div><ul class="ai-list ai-q">' + d.openQuestions.map(function (q) { return '<li>' + esc(q) + '</li>'; }).join('') + '</ul></div>';
    }
    h += '<div class="ai-foot">Generated from ' + d.messageCount + ' message' + (d.messageCount === 1 ? '' : 's') + ' · ' + ago(d.generatedAt) +
      ' · AI can make mistakes, check the messages before acting. <button type="button" class="pj-link-btn ai-regen">Regenerate</button></div>';
    aiPanel.innerHTML = h;
  }
  function loadSummary(force) {
    if (aiBtn.getAttribute('data-ai-on') !== '1') { aiPanel.hidden = false; aiPanel.className = 'ai-panel is-info'; aiPanel.innerHTML = '<i class="bi bi-info-circle"></i> ' + notSetUp(); return; }
    aiPanel.hidden = false; aiPanel.className = 'ai-panel is-loading';
    aiPanel.innerHTML = '<div class="ai-head"><span class="ai-badge"><i class="bi bi-stars"></i>Summarising the conversation…</span></div><i class="ai-sk w90"></i><i class="ai-sk w70"></i><i class="ai-sk w80"></i>';
    aiBtn.disabled = true;
    post('/projects/' + encodeURIComponent(PROJECT_ID) + '/summary' + (force ? '?r=' + Date.now() : ''))
      .then(function (d) { aiPanel.className = 'ai-panel'; renderSummary(d); })
      .catch(function (e) {
        aiPanel.className = 'ai-panel is-error';
        aiPanel.innerHTML = '<i class="bi bi-exclamation-circle"></i> ' + esc((e && e.error) || 'Could not create a summary.') + ' <button type="button" class="pj-link-btn ai-regen">Try again</button>';
      })
      .then(function () { aiBtn.disabled = false; });
  }
  if (aiBtn && aiPanel) {
    aiBtn.addEventListener('click', function () { loadSummary(false); });
    aiPanel.addEventListener('click', function (e) {
      if (e.target.closest('.ai-close')) { aiPanel.hidden = true; return; }
      if (e.target.closest('.ai-regen')) loadSummary(true);
    });
  }

  // ── Message view: Clean / Original, expand, AI clean-up ─────────────────
  document.addEventListener('click', function (e) {
    var tab = e.target.closest('[data-msgv] [data-view]');
    if (tab) {
      var box = tab.closest('[data-msgv]'), view = tab.getAttribute('data-view');
      box.querySelectorAll('[data-view]').forEach(function (t) { var on = t === tab; t.classList.toggle('is-active', on); t.setAttribute('aria-selected', on); });
      box.querySelectorAll('[data-pane]').forEach(function (p) { p.hidden = p.getAttribute('data-pane') !== view; });
      return;
    }
    var ex = e.target.closest('[data-expand]');
    if (ex) {
      var o = ex.closest('[data-msgv]').querySelector('[data-orig]');
      var open = o.classList.toggle('is-collapsed') === false;
      ex.textContent = open ? 'Show less' : 'Show full message';
      return;
    }
    var cl = e.target.closest('[data-ai-clean]');
    if (cl) {
      var id = cl.getAttribute('data-ai-clean');
      var item = document.getElementById('msg-' + id);
      var actions = item && item.querySelector('.msgv-actions');
      if (aiBtn && aiBtn.getAttribute('data-ai-on') !== '1') {
        if (actions) { actions.insertAdjacentHTML('beforeend', '<span class="msgv-note">' + notSetUp() + '</span>'); cl.disabled = true; }
        else alert(notSetUp().replace(/<[^>]+>/g, ''));
        return;
      }
      if (cl.disabled) return;
      if (actions) actions.querySelectorAll('.msgv-note').forEach(function (n) { n.remove(); });   // clear earlier errors
      cl.disabled = true;
      var label = cl.getAttribute('data-label') || cl.innerHTML; cl.setAttribute('data-label', label);
      cl.innerHTML = '<span class="logo-spin" aria-hidden="true"></span>Cleaning up… this can take up to a minute';
      post('/comments/' + encodeURIComponent(id) + '/format')
        .then(function () { location.hash = 'msg-' + id; location.reload(); })
        .catch(function (err) {
          cl.disabled = false; cl.innerHTML = label;
          var msg = (err && err.error) || 'Could not clean up this message.';
          if (actions) actions.insertAdjacentHTML('beforeend', '<span class="msgv-note is-error">' + esc(msg) + '</span>'); else alert(msg);
        });
    }
  });

  // ── Attachment drop zones (drag & drop, paste, browse) ────────────────────
  var MAX_FILES = 10, MAX_BYTES = 25 * 1024 * 1024;
  function fmtSize(b) { return b < 1024 ? b + ' B' : b < 1048576 ? Math.round(b / 1024) + ' KB' : (b / 1048576).toFixed(1) + ' MB'; }
  function fileIcon(f) {
    var t = f.type || '', n = (f.name || '').toLowerCase();
    if (t.indexOf('image/') === 0) return 'bi-file-earmark-image';
    if (/\.pdf$/.test(n)) return 'bi-file-earmark-pdf';
    if (/\.(xlsx?|csv)$/.test(n)) return 'bi-file-earmark-excel';
    if (/\.docx?$/.test(n)) return 'bi-file-earmark-word';
    if (/\.(zip|rar|7z)$/.test(n)) return 'bi-file-earmark-zip';
    return 'bi-file-earmark';
  }
  document.querySelectorAll('[data-dz]').forEach(function (dzEl) {
    var input = dzEl.querySelector('[data-dz-input]'), zone = dzEl.querySelector('[data-dz-zone]');
    var list = dzEl.querySelector('[data-dz-list]'), errEl = dzEl.querySelector('[data-dz-error]');
    var form = dzEl.closest('form'), files = [], urls = [];
    function sync() {
      var dt = new DataTransfer(); files.forEach(function (f) { dt.items.add(f); }); input.files = dt.files;
      urls.forEach(URL.revokeObjectURL); urls = [];
      list.innerHTML = files.map(function (f, i) {
        var thumb = '';
        if ((f.type || '').indexOf('image/') === 0) { var u = URL.createObjectURL(f); urls.push(u); thumb = '<img src="' + u + '" alt="">'; }
        return '<li class="dz-chip">' + (thumb || '<i class="bi ' + fileIcon(f) + '" aria-hidden="true"></i>') +
          '<span class="dz-name" title="' + esc(f.name) + '">' + esc(f.name) + '</span><span class="dz-size">' + fmtSize(f.size) + '</span>' +
          '<button type="button" class="dz-rm" data-i="' + i + '" aria-label="Remove ' + esc(f.name) + '"><i class="bi bi-x"></i></button></li>';
      }).join('');
      dzEl.classList.toggle('has-files', files.length > 0);
    }
    function add(list2) {
      var skipped = [];
      Array.prototype.forEach.call(list2 || [], function (f, i) {
        if (!f) return;
        if (!f.name || f.name === 'image.png') {
          var ext = ((f.type || '').split('/')[1] || 'png').replace('jpeg', 'jpg');
          f = new File([f], 'screenshot-' + new Date().toISOString().slice(0, 19).replace(/[:T]/g, '-') + (i ? '-' + i : '') + '.' + ext, { type: f.type });
        }
        if (f.size > MAX_BYTES) { skipped.push(f.name + ' is over 25 MB'); return; }
        if (files.length >= MAX_FILES) { skipped.push('only ' + MAX_FILES + ' files per message'); return; }
        if (files.some(function (x) { return x.name === f.name && x.size === f.size; })) return;
        files.push(f);
      });
      errEl.hidden = !skipped.length; errEl.textContent = skipped.length ? 'Skipped: ' + skipped.join('; ') + '.' : '';
      sync();
    }
    zone.addEventListener('click', function () { input.click(); });
    zone.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); input.click(); } });
    input.addEventListener('change', function () { var picked = Array.prototype.slice.call(input.files); add(picked); });
    list.addEventListener('click', function (e) { var b = e.target.closest('.dz-rm'); if (!b) return; files.splice(+b.getAttribute('data-i'), 1); errEl.hidden = true; sync(); });
    // Drop anywhere on the form (textarea included), highlight the zone
    ['dragenter', 'dragover'].forEach(function (t) { form.addEventListener(t, function (e) { if (e.dataTransfer && Array.prototype.indexOf.call(e.dataTransfer.types || [], 'Files') !== -1) { e.preventDefault(); zone.classList.add('is-over'); } }); });
    form.addEventListener('dragleave', function (e) { if (!form.contains(e.relatedTarget)) zone.classList.remove('is-over'); });
    form.addEventListener('drop', function (e) { if (!e.dataTransfer || !e.dataTransfer.files.length) return; e.preventDefault(); zone.classList.remove('is-over'); add(e.dataTransfer.files); });
    // Paste screenshots / copied files while typing in this form
    form.addEventListener('paste', function (e) {
      var cd = e.clipboardData; if (!cd) return;
      var pasted = Array.prototype.filter.call(cd.items || [], function (it) { return it.kind === 'file'; }).map(function (it) { return it.getAsFile(); }).filter(Boolean);
      if (!pasted.length) return;
      if (!cd.getData('text/plain')) e.preventDefault();
      add(pasted);
    });
    form.addEventListener('reset', function () { files = []; sync(); });
  });

  // ── Screenshots: read with AI and confirm before submitting ────────────────
  (function () {
    var dlg = document.getElementById('shotDialog');
    if (!dlg) return;
    var aiOn = aiBtn && aiBtn.getAttribute('data-ai-on') === '1';
    var IMG = /^image\/(png|jpe?g|gif|webp)$/i;
    var els = {
      images: document.getElementById('shotImages'), loading: document.getElementById('shotLoading'), loadingText: document.getElementById('shotLoadingText'),
      error: document.getElementById('shotError'), errorText: document.getElementById('shotErrorText'), ready: document.getElementById('shotReady'),
      tldr: document.getElementById('shotTldr'), text: document.getElementById('shotText'), origWrap: document.getElementById('shotOrigWrap'),
      orig: document.getElementById('shotOrig'), skip: document.getElementById('shotSkip'), submit: document.getElementById('shotSubmit'),
      noText: document.getElementById('shotNoText'), retry: document.getElementById('shotRetry')
    };
    var current = null;   // { form, files, result, key }
    var urls = [];

    function imageFiles(form) {
      var input = form.querySelector('[data-dz-input]');
      return input && input.files ? Array.prototype.filter.call(input.files, function (f) { return IMG.test(f.type || ''); }) : [];
    }
    function bodyField(form) { return form.querySelector('textarea[name="comment"], textarea[name="body"]'); }
    function setState(state) {
      els.loading.hidden = state !== 'loading'; els.error.hidden = state !== 'error'; els.ready.hidden = state !== 'ready';
      els.submit.disabled = state !== 'ready';
    }
    function fileKey(files) { return files.map(function (f) { return f.name + ':' + f.size; }).join('|'); }

    function read() {
      setState('loading');
      els.loadingText.textContent = 'Reading ' + current.files.length + ' screenshot' + (current.files.length === 1 ? '' : 's') + '… this can take up to a minute';
      var fd = new FormData();
      current.files.forEach(function (f) { fd.append('images', f, f.name); });
      var form = current.form, ch = form.querySelector('input[name="channel"]:checked'), dir = form.querySelector('input[name="direction"]:checked');
      fd.append('text', (bodyField(form) || {}).value || '');
      fd.append('channel', ch ? ch.value : 'comment');
      fd.append('direction', dir ? dir.value : 'in');
      var fromEl = form.querySelector('input[name="from"]'); fd.append('from', fromEl ? fromEl.value : '');
      fetch('/ai/read-images', { method: 'POST', body: fd, credentials: 'same-origin', headers: { 'Accept': 'application/json' } })
        .then(function (r) { return r.json().catch(function () { return {}; }).then(function (j) { return r.ok && j.ok ? j : Promise.reject(j); }); })
        .then(function (res) {
          current.result = res; current.key = fileKey(current.files);
          els.tldr.innerHTML = res.tldr ? '<span class="msgv-tldr-label"><i class="bi bi-stars" aria-hidden="true"></i>In short</span>' + esc(res.tldr) : '';
          els.tldr.hidden = !res.tldr;
          els.text.value = res.text || '';
          els.origWrap.hidden = !res.hasForeignText; els.orig.checked = !!res.hasForeignText;
          els.skip.hidden = !(res.imagesSkipped && res.imagesSkipped.length);
          els.skip.textContent = res.imagesSkipped && res.imagesSkipped.length ? 'Not read: ' + res.imagesSkipped.join('; ') : '';
          setState('ready');
          setTimeout(function () { els.text.focus(); }, 0);
        })
        .catch(function (err) {
          els.errorText.textContent = (err && err.error) || "Couldn't read the screenshots.";
          setState('error');
        });
    }

    function open(form, files) {
      current = { form: form, files: files, result: (current && current.form === form && current.key === fileKey(files)) ? current.result : null };
      urls.forEach(URL.revokeObjectURL); urls = [];
      els.images.innerHTML = files.map(function (f) { var u = URL.createObjectURL(f); urls.push(u); return '<a href="' + u + '" target="_blank" rel="noopener" class="shot-img"><img src="' + u + '" alt="' + esc(f.name) + '"><span>' + esc(f.name) + '</span></a>'; }).join('');
      dlg.showModal();
      if (current.result) setState('ready'); else read();
    }

    function finish(withText) {
      var form = current.form, field = bodyField(form);
      if (withText && field) {
        var add = els.text.value.trim();
        if (els.orig.checked && current.result && current.result.screenshots && current.result.screenshots.length) {
          add += '\n\n— Original text from screenshot —\n' + current.result.screenshots.map(function (x) { return x.transcript; }).join('\n\n');
        }
        var typed = field.value.trim();
        field.value = (typed ? typed + '\n\n' : '') + add;
      }
      form.querySelector('[data-ai-reviewed]').value = '1';
      form.setAttribute('data-reviewed', '1');
      dlg.close();
      if (form.requestSubmit) form.requestSubmit(); else form.submit();
    }

    els.submit.addEventListener('click', function () { finish(true); });
    els.noText.addEventListener('click', function () { finish(false); });
    els.retry.addEventListener('click', read);
    dlg.addEventListener('click', function (e) { if (e.target === dlg || e.target.closest('[data-shot-cancel]')) dlg.close(); });

    ['mmCommentForm', 'mmForm'].forEach(function (id) {
      var form = document.getElementById(id);
      if (!form) return;
      form.addEventListener('submit', function (e) {
        if (e.defaultPrevented) return;                       // other validation already stopped it
        var field = bodyField(form), files = imageFiles(form);
        var anyFiles = (form.querySelector('[data-dz-input]') || {}).files;
        if (id === 'mmCommentForm' && field && !field.value.trim() && !(anyFiles && anyFiles.length)) {
          e.preventDefault(); field.setCustomValidity('Write a comment or attach a file'); field.reportValidity();
          field.addEventListener('input', function () { field.setCustomValidity(''); }, { once: true });
          return;
        }
        if (!aiOn || !files.length || form.getAttribute('data-reviewed') === '1') return;
        e.preventDefault();
        open(form, files);
      });
    });
  })();

  // ── Admin: edit a message ─────────────────────────────────────────────
  var dlg = document.getElementById('msgEditDialog');
  if (dlg) {
    var ef = document.getElementById('msgEditForm');
    function pad(n) { return (n < 10 ? '0' : '') + n; }
    function localInput(iso) { var d = new Date(iso); if (isNaN(d)) return ''; return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) + 'T' + pad(d.getHours()) + ':' + pad(d.getMinutes()); }
    function syncSubject() { var ch = ef.querySelector('input[name="channel"]:checked'); document.getElementById('meSubjectWrap').hidden = !ch || ch.value !== 'email'; }
    document.addEventListener('click', function (e) {
      var b = e.target.closest('[data-edit-msg]'); if (!b) return;
      var d; try { d = JSON.parse(b.getAttribute('data-edit-msg')); } catch (_) { return; }
      ef.action = '/comments/' + encodeURIComponent(d.id) + '/edit';
      var ext = d.kind !== 'comment';
      ef.querySelector('.msg-edit-ext').hidden = !ext;
      ef.querySelectorAll('.msg-edit-ext input').forEach(function (i) { i.disabled = !ext; });
      document.getElementById('meContent').value = d.content;
      if (ext) {
        document.getElementById('meFrom').value = d.from;
        document.getElementById('meTo').value = d.to;
        document.getElementById('meSubject').value = d.subject;
        document.getElementById('meSent').value = localInput(d.sentAt);
        (ef.querySelector('input[name="channel"][value="' + (d.channel || 'email') + '"]') || {}).checked = true;
        (ef.querySelector('input[name="direction"][value="' + (d.direction || 'in') + '"]') || {}).checked = true;
        syncSubject();
      }
      document.getElementById('meNote').textContent = d.kind === 'comment'
        ? 'Only the text of a comment can be changed; the author stays the same.'
        : 'Changes are saved with your name as the editor.';
      dlg.showModal();
      setTimeout(function () { document.getElementById('meContent').focus(); }, 0);
    });
    ef.addEventListener('change', function (e) { if (e.target.name === 'channel') syncSubject(); });
    ef.addEventListener('submit', function () {
      var v = document.getElementById('meSent').value;
      document.getElementById('meSentIso').value = v ? new Date(v).toISOString() : '';
    });
    dlg.addEventListener('click', function (e) { if (e.target === dlg || e.target.closest('[data-close-dialog]')) dlg.close(); });
  }

  // Files: click or drop, then upload
  var input = document.getElementById('projectAttachInput'), label = document.getElementById('projectAttachLabel');
  var drop = document.getElementById('pjDrop'), btn = document.getElementById('pjUploadBtn');
  function show() {
    var n = input.files ? input.files.length : 0;
    label.innerHTML = n ? '<strong>' + n + ' file' + (n === 1 ? '' : 's') + '</strong> ready to upload' : '<strong>Drop files</strong> or click to choose';
    btn.hidden = !n; drop.classList.toggle('has-files', !!n);
  }
  if (input) {
    input.addEventListener('change', show);
    ['dragenter', 'dragover'].forEach(function (t) { drop.addEventListener(t, function (e) { e.preventDefault(); drop.classList.add('is-over'); }); });
    ['dragleave', 'drop'].forEach(function (t) { drop.addEventListener(t, function () { drop.classList.remove('is-over'); }); });
    drop.addEventListener('drop', function (e) {
      e.preventDefault();
      if (e.dataTransfer && e.dataTransfer.files.length) { input.files = e.dataTransfer.files; show(); }
    });
  }
})();
</script>

