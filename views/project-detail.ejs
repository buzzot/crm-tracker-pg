<%
  // ── Helpers ────────────────────────────────────────────────────────────────
  function dayStr(v) { if (!v) return null; const d = v instanceof Date ? v : new Date(String(v).length <= 10 ? v + 'T00:00:00' : v); return isNaN(d) ? null : d; }
  function fmtDate(v, opts) { const d = dayStr(v); return d ? d.toLocaleDateString('en-US', opts || { month: 'short', day: 'numeric', year: 'numeric' }) : null; }
  function fmtShort(v) { const d = dayStr(v); if (!d) return null; const sameYear = d.getFullYear() === new Date().getFullYear(); return d.toLocaleDateString('en-US', sameYear ? { month: 'short', day: 'numeric' } : { month: 'short', day: 'numeric', year: 'numeric' }); }
  function noteTimeAgo(iso) {
    if (!iso) return '';
    const then = new Date(iso);
    if (isNaN(then.getTime())) return '';
    const sec = Math.floor((Date.now() - then.getTime()) / 1000);
    if (sec < 60) return 'just now';
    const min = Math.floor(sec / 60);
    if (min < 60) return min + 'm ago';
    const hr = Math.floor(min / 60);
    if (hr < 24) return hr + 'h ago';
    const day = Math.floor(hr / 24);
    if (day < 30) return day + 'd ago';
    return then.toLocaleDateString();
  }
  const noteAvatarClasses = ['note-avatar-blue', 'note-avatar-purple', 'note-avatar-gray'];
  const youInitial = ((typeof currentUser !== 'undefined' && currentUser && (currentUser.name || currentUser.email)) || '?').trim().charAt(0).toUpperCase();
  const orderedComments = (project.comments || []).slice().reverse();

  const _avatarPalette = ['oklch(0.50 0.20 270)','oklch(0.52 0.18 250)','oklch(0.48 0.18 300)','oklch(0.52 0.14 195)','oklch(0.52 0.16 160)','oklch(0.55 0.18 25)','oklch(0.52 0.20 10)','oklch(0.48 0.16 230)'];
  function avatarBg(name) { let h = 0; for (let i = 0; i < (name || '').length; i++) h = (name.charCodeAt(i) + ((h << 5) - h)) | 0; return _avatarPalette[Math.abs(h) % _avatarPalette.length]; }
  function initial(n) { return (n || '?').trim().charAt(0).toUpperCase(); }

  // ── Window ─────────────────────────────────────────────────────────────────
  const startLabel = fmtDate(project.startDate), endLabel = fmtDate(project.endDate);
  const windowLabel = startLabel && endLabel ? `${startLabel} – ${endLabel}` : startLabel ? `From ${startLabel}` : endLabel ? `Until ${endLabel}` : null;

  // ── Tasks: progress, next deadline, overdue ───────────────────────────────
  const today = new Date(); today.setHours(0, 0, 0, 0);
  function daysTo(v) { const d = dayStr(v); if (!d) return null; d.setHours(0, 0, 0, 0); return Math.round((d - today) / 86400000); }
  const tasks = (project.subtasks || []).slice();
  const isDone = t => t.status === 'Completed';
  const doneCount = tasks.filter(isDone).length;
  const openTasks = tasks.filter(t => !isDone(t));
  const overdueTasks = openTasks.filter(t => { const n = daysTo(t.deadline); return n !== null && n < 0; });
  // Next upcoming deadline (overdue ones are counted separately in the strip)
  const nextTask = openTasks.filter(t => { const n = daysTo(t.deadline); return n !== null && n >= 0; }).sort((a, b) => String(a.deadline).localeCompare(String(b.deadline)))[0] || null;
  const pct = tasks.length ? Math.round((doneCount / tasks.length) * 100) : 0;
  // Open tasks first (by deadline, undated last), completed last
  tasks.sort((a, b) => {
    if (isDone(a) !== isDone(b)) return isDone(a) ? 1 : -1;
    if (!a.deadline && !b.deadline) return 0;
    if (!a.deadline) return 1; if (!b.deadline) return -1;
    return String(a.deadline).localeCompare(String(b.deadline));
  });
  function dueLabel(t) {
    if (isDone(t)) return { text: 'Done', cls: 'is-done' };
    const n = daysTo(t.deadline);
    if (n === null) return { text: 'No deadline', cls: 'is-muted' };
    if (n < 0) return { text: (-n) + 'd overdue', cls: 'is-overdue' };
    if (n === 0) return { text: 'Due today', cls: 'is-today' };
    if (n === 1) return { text: 'Due tomorrow', cls: '' };
    return { text: 'Due ' + fmtShort(t.deadline), cls: '' };
  }
  const statusCls = { 'To Do': 'todo', 'In Progress': 'progress', 'Blocked': 'blocked', 'Completed': 'done' };

  const lastUpdate = orderedComments[0] || null;
  const subtaskIds = new Set((project.subtasks || []).map(t => t.id));
  const linkableTasks = (typeof allTasks !== 'undefined' ? allTasks : []).filter(t => !subtaskIds.has(t.id));
  const _canManage = currentUser && ['Admin', 'Manager', 'Head R&D Controllers', 'Head R&D VFD'].includes(currentUser.role);
  const _canRd = currentUser && ['Admin', 'Head R&D Controllers', 'Head R&D VFD'].includes(currentUser.role);
  const projStatusCls = { 'Active': 'active', 'On Hold': 'hold', 'Completed': 'done', 'Cancelled': 'cancelled' }[project.status] || 'none';
  const primaryCompany = (project.companies || [])[0] || null;
  const _isAdmin = !!(currentUser && currentUser.role === 'Admin');
  const _aiOn = typeof aiEnabled !== 'undefined' && !!aiEnabled;
  function _esc(v) { return String(v == null ? '' : v).replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch])); }
  // Original text with the worst whitespace removed (no content changes)
  function tidy(t) {
    return String(t || '').replace(/\r/g, '').replace(/[ \t]+\n/g, '\n').replace(/\n{3,}/g, '\n\n').replace(/^\s+|\s+$/g, '');
  }
  // AI clean view (structured blocks) → escaped HTML
  function renderClean(a) {
    let h = '';
    if (a.tldr) h += '<div class="msgv-tldr"><span class="msgv-tldr-label"><i class="bi bi-stars" aria-hidden="true"></i>In short</span>' + _esc(a.tldr) + '</div>';
    if (a.asks && a.asks.length) h += '<div class="msgv-asks"><div class="msgv-asks-title">They ask</div><ul>' + a.asks.map(x => '<li>' + _esc(x) + '</li>').join('') + '</ul></div>';
    h += '<div class="msgv-doc">';
    (a.blocks || []).forEach(b => {
      if (b.type === 'h') h += '<h4>' + _esc(b.text) + '</h4>';
      else if (b.type === 'p') h += '<p>' + _esc(b.text).replace(/\n/g, '<br>') + '</p>';
      else if (b.type === 'ul') h += '<ul>' + b.items.map(x => '<li>' + _esc(x) + '</li>').join('') + '</ul>';
      else if (b.type === 'table') {
        h += '<div class="msgv-table-wrap"><table class="msgv-table">';
        if (b.headers && b.headers.length) h += '<thead><tr>' + b.headers.map(x => '<th>' + _esc(x) + '</th>').join('') + '</tr></thead>';
        h += '<tbody>' + b.rows.map(r => '<tr>' + r.map(x => '<td>' + _esc(x) + '</td>').join('') + '</tr>').join('') + '</tbody></table></div>';
      }
    });
    h += '</div>';
    const shots = Array.isArray(a.screenshots) ? a.screenshots : [];
    if (shots.length) {
      h += '<details class="msgv-shots"><summary><i class="bi bi-image" aria-hidden="true"></i>Text read from ' + shots.length + ' screenshot' + (shots.length === 1 ? '' : 's') + ' (original language)</summary>'
        + shots.map(x => '<div class="msgv-shot"><div class="msgv-shot-name">' + _esc(x.filename) + '</div><div class="msgv-shot-text">' + _esc(x.transcript) + '</div></div>').join('')
        + '</details>';
    }
    if (a.imagesSkipped && a.imagesSkipped.length) h += '<p class="msgv-skip"><i class="bi bi-exclamation-circle" aria-hidden="true"></i>Not read: ' + _esc(a.imagesSkipped.join('; ')) + '</p>';
    return h;
  }
  const _IMG = /^image\/(png|jpe?g|gif|webp)$/i;
  function imageCount(c) { return (c.attachments || []).filter(a => _IMG.test(a.contentType || '')).length; }
  // Body of an email / logged message: clean view + original, or tidied original + clean-up button
  function msgBody(c) {
    const ai = c.manual && c.manual.ai;
    const orig = tidy(c.comment);
    const long = orig.length > 300;
    if (ai) {
      return '<div class="msgv" data-msgv>'
        + '<div class="msgv-switch" role="tablist" aria-label="Message view">'
        + '<button type="button" class="is-active" role="tab" aria-selected="true" data-view="clean"><i class="bi bi-stars" aria-hidden="true"></i>Clean view</button>'
        + '<button type="button" role="tab" aria-selected="false" data-view="orig">Original</button></div>'
        + '<div class="msgv-clean" data-pane="clean">' + renderClean(ai) + '</div>'
        + '<div class="msgv-orig note-text" data-pane="orig" hidden>' + _esc(orig) + '</div>'
        + '</div>';
    }
    const imgs = imageCount(c);
    let h = '<div class="msgv" data-msgv>'
      + '<div class="msgv-orig note-text' + (long ? ' is-collapsed' : '') + '" data-orig>' + _esc(orig) + '</div>';
    if (long || imgs) {
      h += '<div class="msgv-actions">'
        + (long ? '<button type="button" class="pj-link-btn" data-expand>Show full message</button>' : '')
        + '<button type="button" class="msgv-cta" data-ai-clean="' + _esc(c.id) + '"><i class="bi bi-stars" aria-hidden="true"></i>'
        + (imgs ? (long ? 'Make it easy to read + read screenshot' + (imgs > 1 ? 's' : '') : 'Read screenshot' + (imgs > 1 ? 's' : '') + ' as text') : 'Make it easy to read')
        + '</button></div>';
    }
    return h + '</div>';
  }
  // Admin-only message menu
  function msgTools(c) {
    if (!_isAdmin) return '';
    const kind = c.manual ? 'logged' : (c.type === 'email' ? 'email' : 'comment');
    const edit = {
      id: c.id, kind, content: c.comment || '', from: c.author || '', to: c.manual ? (c.manual.to || '') : '',
      subject: c.emailSubject || '', sentAt: c.postedAt ? new Date(c.postedAt).toISOString() : '',
      channel: c.manual ? c.manual.channel : (c.type === 'email' ? 'email' : ''), direction: c.manual ? c.manual.direction : 'in',
    };
    const external = kind !== 'comment';
    return '<span class="msg-tools"><span class="dropdown"><button type="button" class="msg-tool msg-tool-icon" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Message actions"><i class="bi bi-three-dots" aria-hidden="true"></i></button>'
      + '<ul class="dropdown-menu dropdown-menu-end tn-menu">'
      + '<li><button type="button" class="dropdown-item" data-edit-msg="' + _esc(JSON.stringify(edit)) + '"><i class="bi bi-pencil"></i>Edit</button></li>'
      + (external ? '<li><button type="button" class="dropdown-item" data-ai-clean="' + _esc(c.id) + '"><i class="bi bi-stars"></i>' + (c.manual && c.manual.ai ? 'Redo clean view' : 'Create clean view') + '</button></li>' : '')
      + '<li><form action="/comments/' + _esc(c.id) + '/delete" method="POST" class="m-0" onsubmit="return confirm(\'Delete this message permanently? Attachments on it are removed too.\')">'
      + '<button type="submit" class="dropdown-item msg-danger"><i class="bi bi-trash"></i>Delete</button></form></li>'
      + '</ul></span></span>';
  }
%>

<div class="pg pj">

  <!-- ── Header ─────────────────────────────────────────────────────────── -->
  <nav class="pj-crumbs" aria-label="Breadcrumb">
    <a href="/projects">Projects</a>
    <% if (primaryCompany) { %><i class="bi bi-chevron-right" aria-hidden="true"></i><a href="/companies/<%= primaryCompany.id %>"><%= primaryCompany.name %></a><% } %>
  </nav>

  <header class="pj-head">
    <div class="pj-head-main">
      <h1 class="pj-title"><%= project.name %></h1>
      <div class="pj-meta">
        <span class="pj-status pj-status-<%= projStatusCls %>"><span class="pj-dot" aria-hidden="true"></span><%= project.status || 'No status' %></span>
        <% if (project.isRdIssue) { %><span class="pj-chip pj-chip-rd"><i class="bi bi-cpu" aria-hidden="true"></i>R&amp;D issue</span><% } %>
        <% if (primaryCompany) { %><a class="pj-meta-item" href="/companies/<%= primaryCompany.id %>"><i class="bi bi-building" aria-hidden="true"></i><%= (project.companies || []).map(c => c.name).join(', ') %></a><% } %>
        <% if (project.category) { %><span class="pj-meta-item"><i class="bi bi-tag" aria-hidden="true"></i><%= project.category %></span><% } %>
        <% if (project.ownerName) { %><span class="pj-meta-item"><span class="pj-av pj-av-xs" style="background:<%- avatarBg(project.ownerName) %>"><%= initial(project.ownerName) %></span><%= project.ownerName %></span><% } %>
        <% if (windowLabel) { %><span class="pj-meta-item"><i class="bi bi-calendar3" aria-hidden="true"></i><%= windowLabel %></span><% } %>
      </div>
    </div>
    <div class="pj-head-actions">
      <a href="#comments" class="pg-btn" data-pj-log><i class="bi bi-envelope-paper" aria-hidden="true"></i>Log message</a>
      <a href="/projects/<%= project.id %>/edit" class="pg-btn"><i class="bi bi-pencil" aria-hidden="true"></i>Edit</a>
      <a href="/projects/<%= project.id %>/tasks/new" class="pg-btn pg-btn-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i>New task</a>
    </div>
  </header>

  <!-- ── Progress strip ─────────────────────────────────────────────────── -->
  <section class="pj-strip" aria-label="Project progress">
    <div class="pj-stat">
      <div class="pj-stat-label">Tasks</div>
      <div class="pj-stat-value"><%= doneCount %><span>/<%= tasks.length %> done</span></div>
      <div class="pj-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= pct %>" aria-label="<%= pct %>% of tasks done"><span style="width:<%= pct %>%"></span></div>
    </div>
    <div class="pj-stat">
      <div class="pj-stat-label">Next deadline</div>
      <% if (nextTask) { const nl = dueLabel(nextTask); %>
        <div class="pj-stat-value pj-stat-due <%= nl.cls %>"><%= fmtShort(nextTask.deadline) %></div>
        <a class="pj-stat-sub" href="/tasks/<%= nextTask.id %>" title="<%= nextTask.name %>"><%= nextTask.name %></a>
      <% } else { %>
        <div class="pj-stat-value pj-muted">None</div><div class="pj-stat-sub">No upcoming deadlines</div>
      <% } %>
    </div>
    <div class="pj-stat <%= overdueTasks.length ? 'is-alert' : '' %>">
      <div class="pj-stat-label">Overdue</div>
      <div class="pj-stat-value"><%= overdueTasks.length %><span> task<%= overdueTasks.length === 1 ? '' : 's' %></span></div>
      <div class="pj-stat-sub"><%= overdueTasks.length ? 'Needs attention' : 'On track' %></div>
    </div>
    <div class="pj-stat">
      <div class="pj-stat-label">Last update</div>
      <% if (lastUpdate) { %>
        <div class="pj-stat-value pj-stat-small"><%= noteTimeAgo(lastUpdate.postedAt) %></div>
        <a class="pj-stat-sub" href="#comments"><%= lastUpdate.manual ? ({ email: 'Email', wechat: 'WeChat', other: 'Message' }[lastUpdate.manual.channel] || 'Message') + (lastUpdate.manual.direction === 'out' ? ' to ' + (lastUpdate.manual.to || 'contact') : ' from ' + lastUpdate.author) : (lastUpdate.type === 'email' ? 'Email from ' : 'Comment by ') + lastUpdate.author %></a>
      <% } else { %>
        <div class="pj-stat-value pj-muted">None</div><div class="pj-stat-sub">No comments or messages yet</div>
      <% } %>
    </div>
  </section>

  <div class="pj-grid">
    <!-- ── Main column ─────────────────────────────────────────────────── -->
    <div class="pj-main">

      <% if (project.description) { %>
        <section class="pj-card pj-brief" aria-label="Description">
          <div class="pj-brief-text" id="pjBrief"><%= project.description %></div>
          <button type="button" class="pj-link-btn" id="pjBriefMore" hidden>Show more</button>
        </section>
      <% } %>

      <!-- Tasks -->
      <section class="pj-card" id="tasks" aria-labelledby="pjTasksTitle">
        <div class="pj-card-head">
          <div>
            <h2 class="pj-card-title" id="pjTasksTitle">Tasks <span class="pj-n"><%= tasks.length %></span></h2>
            <p class="pj-card-sub"><%= openTasks.length %> open<% if (overdueTasks.length) { %> &middot; <span class="pj-red"><%= overdueTasks.length %> overdue</span><% } %></p>
          </div>
          <div class="pj-card-actions">
            <button type="button" class="pj-link-btn" data-bs-toggle="collapse" data-bs-target="#linkTaskForm" aria-expanded="false" aria-controls="linkTaskForm"><i class="bi bi-link-45deg" aria-hidden="true"></i>Link existing</button>
            <a href="/projects/<%= project.id %>/tasks/new" class="pj-link-btn"><i class="bi bi-plus-lg" aria-hidden="true"></i>New task</a>
          </div>
        </div>

        <div class="collapse" id="linkTaskForm">
          <form action="/projects/<%= project.id %>/tasks/link" method="POST" class="pj-inline-form">
            <select name="taskId" class="pj-select" required aria-label="Task to link">
              <option value="">Select a task to link</option>
              <% linkableTasks.forEach(t => { %><option value="<%= t.id %>"><%= t.name || '(untitled)' %></option><% }) %>
            </select>
            <button type="submit" class="pg-btn pg-btn-primary">Link</button>
          </form>
          <% if (!linkableTasks.length) { %><p class="pj-hint">No other unlinked tasks available.</p><% } %>
        </div>

        <% if (!tasks.length) { %>
          <div class="pj-empty">
            <i class="bi bi-list-check" aria-hidden="true"></i>
            <div><strong>No tasks yet.</strong> Break the project into steps so everyone knows what's next.</div>
            <a href="/projects/<%= project.id %>/tasks/new" class="pg-btn pg-btn-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i>Add first task</a>
          </div>
        <% } else { %>
          <ul class="pj-tasks">
            <% tasks.forEach(t => { const dl = dueLabel(t); const sc = statusCls[t.status] || 'todo'; %>
              <li class="pj-task <%= isDone(t) ? 'is-done' : '' %> <%= dl.cls === 'is-overdue' ? 'is-overdue' : '' %>">
                <span class="pj-task-status pj-ts-<%= sc %>" title="<%= t.status || 'To Do' %>" aria-hidden="true"><% if (isDone(t)) { %><i class="bi bi-check"></i><% } %></span>
                <a href="/tasks/<%= t.id %>" class="pj-task-name" title="<%= t.name %>"><%= t.name || '(untitled)' %></a>
                <span class="pj-task-state pj-ts-text-<%= sc %>"><%= t.status || 'To Do' %></span>
                <span class="pj-task-people">
                  <% (t.assignees || []).slice(0, 3).forEach(a => { %><span class="pj-av pj-av-xs" style="background:<%- avatarBg(a.name) %>" title="<%= a.name %>"><%= initial(a.name) %></span><% }) %>
                  <% if ((t.assignees || []).length > 3) { %><span class="pj-av pj-av-xs pj-av-more">+<%= t.assignees.length - 3 %></span><% } %>
                </span>
                <span class="pj-task-due <%= dl.cls %>"><%= dl.text %></span>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </section>

      <section class="pj-card" id="comments" aria-labelledby="pjConvTitle">
        <div class="pj-card-head"><div><h2 class="pj-card-title" id="pjConvTitle">Conversation <span class="pj-n"><%= (project.comments || []).length %></span></h2>
          <p class="pj-card-sub">Comments, plus emails and WeChat messages logged to this project</p></div>
          <div class="pj-card-actions">
            <button type="button" class="pg-btn ai-btn" id="aiSummaryBtn" data-ai-on="<%= _aiOn ? 1 : 0 %>" data-is-admin="<%= _isAdmin ? 1 : 0 %>" <%= (project.comments || []).length ? '' : 'disabled' %>
                    title="<%= (project.comments || []).length ? 'Summarise this conversation with AI' : 'Nothing to summarise yet' %>">
              <i class="bi bi-stars" aria-hidden="true"></i>Summarize
            </button>
          </div>
        </div>
        <div class="ai-panel" id="aiPanel" hidden aria-live="polite"></div>

        <div class="mm-switch" role="tablist" aria-label="Add to this project">
          <button type="button" class="mm-switch-btn is-active" role="tab" aria-selected="true" data-mm-mode="comment"><i class="bi bi-chat-left-text" aria-hidden="true"></i>Comment</button>
          <button type="button" class="mm-switch-btn" role="tab" aria-selected="false" data-mm-mode="message"><i class="bi bi-envelope-paper" aria-hidden="true"></i>Log email or WeChat</button>
        </div>

        <% if (typeof msgError !== 'undefined' && msgError) { %>
          <div class="mm-alert" role="alert"><i class="bi bi-exclamation-circle" aria-hidden="true"></i><%= msgError %></div>
        <% } %>

        <!-- Log a message by hand -->
        <form action="/projects/<%= project.id %>/messages" method="POST" enctype="multipart/form-data" class="mm-form" id="mmForm" hidden>
          <input type="hidden" name="sentAtIso" id="mmSentIso">
          <input type="hidden" name="aiReviewed" value="0" data-ai-reviewed>
          <div class="mm-row">
            <div class="mm-seg" role="radiogroup" aria-label="Channel">
              <label><input type="radio" name="channel" value="email" checked><span><i class="bi bi-envelope" aria-hidden="true"></i>Email</span></label>
              <label><input type="radio" name="channel" value="wechat"><span><i class="bi bi-wechat" aria-hidden="true"></i>WeChat</span></label>
              <label><input type="radio" name="channel" value="other"><span><i class="bi bi-chat-dots" aria-hidden="true"></i>Other</span></label>
            </div>
            <div class="mm-seg" role="radiogroup" aria-label="Direction">
              <label><input type="radio" name="direction" value="in" checked><span>Received</span></label>
              <label><input type="radio" name="direction" value="out"><span>Sent</span></label>
            </div>
          </div>
          <div class="mm-grid">
            <div class="mm-field">
              <label for="mmFrom"><span>From <b aria-hidden="true">*</b></span></label>
              <div class="mm-combo">
                <input type="text" name="from" id="mmFrom" class="mm-input" maxlength="300" placeholder="Pick a contact or type a name" autocomplete="off"
                       role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="mmFromList" data-mm-pick="single">
                <button type="button" class="mm-combo-btn" tabindex="-1" aria-label="Show contacts" data-mm-open="mmFrom"><i class="bi bi-chevron-down" aria-hidden="true"></i></button>
                <div class="mm-pop" id="mmFromList" role="listbox" hidden></div>
              </div>
            </div>
            <div class="mm-field">
              <label for="mmTo"><span>To</span></label>
              <div class="mm-combo">
                <input type="text" name="to" id="mmTo" class="mm-input" maxlength="300" placeholder="Optional, pick one or more" autocomplete="off"
                       role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="mmToList" data-mm-pick="multi">
                <button type="button" class="mm-combo-btn" tabindex="-1" aria-label="Show contacts" data-mm-open="mmTo"><i class="bi bi-chevron-down" aria-hidden="true"></i></button>
                <div class="mm-pop" id="mmToList" role="listbox" hidden></div>
              </div>
            </div>
            <label class="mm-field mm-field-date"><span>Date and time</span>
              <input type="datetime-local" id="mmSent" class="mm-input"></label>
          </div>
          <label class="mm-field" id="mmSubjectWrap"><span>Subject</span>
            <input type="text" name="subject" id="mmSubject" class="mm-input" maxlength="500" autocomplete="off"></label>
          <label class="mm-field"><span>Message</span>
            <textarea name="body" id="mmBody" class="mm-input mm-textarea" rows="6"
              placeholder="Paste the email or WeChat text here. Pasted email headers (From, To, Subject, Date) fill the fields above. Paste a screenshot to attach it."></textarea></label>
          <div class="mm-foot">
<div class="dz" data-dz>
              <input type="file" name="attachment" id="mmFiles" multiple hidden data-dz-input>
              <div class="dz-zone" data-dz-zone tabindex="0" role="button" aria-label="Add attachments: drop files, paste a screenshot, or press Enter to browse">
                <i class="bi bi-cloud-arrow-up" aria-hidden="true"></i>
                <span><strong>Drop files</strong> or paste a screenshot · <span class="dz-browse">browse</span></span>
                <span class="dz-limit">up to 10 files, 25 MB each</span>
              </div>
              <ul class="dz-list" data-dz-list></ul>
              <p class="dz-error" data-dz-error hidden></p>
            </div>
            <div class="mm-actions">
              <button type="button" class="pg-btn" data-mm-mode="comment">Cancel</button>
              <button type="submit" class="pg-btn pg-btn-primary"><i class="bi bi-check2" aria-hidden="true"></i>Save to project</button>
