      <dialog class="shot-dialog" id="shotDialog" aria-labelledby="shotTitle">
        <div class="shot-head">
          <div>
            <h3 id="shotTitle"><i class="bi bi-stars" aria-hidden="true"></i>Check the text read from your screenshot</h3>
            <p>Edit anything that's wrong, then submit. The text is saved with the message; the screenshot stays attached.</p>
          </div>
          <button type="button" class="pj-copy-btn" data-shot-cancel aria-label="Close"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
        </div>
        <div class="shot-body">
          <div class="shot-images" id="shotImages"></div>
          <div class="shot-result">
            <div class="shot-state" id="shotLoading"><span class="logo-spin" aria-hidden="true"></span><span id="shotLoadingText">Reading screenshot…</span></div>
            <div class="shot-state shot-error" id="shotError" hidden><i class="bi bi-exclamation-circle" aria-hidden="true"></i><span id="shotErrorText"></span><button type="button" class="pj-link-btn" id="shotRetry">Try again</button></div>
            <div id="shotReady" hidden>
              <div class="shot-tldr" id="shotTldr"></div>
