        <form action="/projects/<%= project.id %>/comments" method="POST" enctype="multipart/form-data" id="mmCommentForm">
          <input type="hidden" name="aiReviewed" value="0" data-ai-reviewed>
          <div class="note-compose-box">
            <div class="d-flex gap-2">
              <span class="note-avatar note-avatar-you"><%= youInitial %></span>
              <textarea name="comment" class="note-textarea" rows="2" placeholder="Add a comment, or paste a screenshot"></textarea>
            </div>
            <div class="note-compose-footer">
<div class="dz" data-dz>
                <input type="file" name="attachment" id="projectCommentFileInput" multiple hidden data-dz-input>
                <div class="dz-zone" data-dz-zone tabindex="0" role="button" aria-label="Add attachments: drop files, paste a screenshot, or press Enter to browse">
                  <i class="bi bi-cloud-arrow-up" aria-hidden="true"></i>
                  <span><strong>Drop files</strong> or paste a screenshot · <span class="dz-browse">browse</span></span>
                  <span class="dz-limit">up to 10 files, 25 MB each</span>
                </div>
                <ul class="dz-list" data-dz-list></ul>
                <p class="dz-error" data-dz-error hidden></p>
            </div>
              <button type="submit" class="pg-btn pg-btn-primary pj-send"><i class="bi bi-send" aria-hidden="true"></i>Send</button>
            </div>
          </div>
