<%
  const STATUS_TABS = ['Active', 'On Hold', 'Completed', 'Cancelled'];
  const counts = {}; STATUS_TABS.forEach(s => counts[s] = 0);
  projects.forEach(p => { counts[p.statusLabel] = (counts[p.statusLabel] || 0) + 1; });
  const attention = projects.filter(p => p.flags.length).length;
  const mineCount = projects.filter(p => p.mine).length;
  const sKey = s => String(s || '').replace(/[^A-Za-z0-9]/g, '');
  const esc = s => String(s == null ? '' : s);
  function initials(name) {
    if (!name) return '?';
    const w = name.trim().split(/\s+/);
    return (w.length > 1 ? w[0][0] + w[1][0] : w[0].slice(0, 2)).toUpperCase();
  }
  function ago(days) {
    if (days === null || days === undefined) return '—';
    if (days <= 0) return 'Today';
    if (days === 1) return 'Yesterday';
    if (days < 7) return days + 'd ago';
    if (days < 60) return Math.round(days / 7) + 'w ago';
    return Math.round(days / 30) + 'mo ago';
  }
  function due(days) {
    if (days === null || days === undefined) return null;
    if (days < 0) return { cls: 'is-late', text: (-days) + 'd overdue' };
    if (days === 0) return { cls: 'is-soon', text: 'Due today' };
    if (days === 1) return { cls: 'is-soon', text: 'Tomorrow' };
    if (days <= 3) return { cls: 'is-soon', text: 'In ' + days + ' days' };
    return { cls: '', text: 'In ' + days + ' days' };
  }
  function fmtDate(iso) {
    if (!iso) return '';
    const d = new Date(String(iso).length === 10 ? iso + 'T00:00:00' : iso);
    return isNaN(d) ? '' : d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
  }
  const CH_ICON = { email: 'bi-envelope', wechat: 'bi-wechat', message: 'bi-chat-left-text', comment: 'bi-chat-left' };
%>

<div class="pg pl">

  <div class="pg-header">
    <div class="pg-heading">
      <h1 class="pg-title">Projects</h1>
      <span class="pg-count"><%= projects.length %></span>
    </div>
    <div class="pg-actions">
      <a href="/projects/new" class="pg-btn pg-btn-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i>New project</a>
    </div>
  </div>

  <div class="pg-toolbar pl-toolbar">
    <div class="pg-tabs" id="plTabs" role="tablist" aria-label="Filter by status">
      <% STATUS_TABS.forEach((s, i) => { %>
        <button type="button" class="pg-tab<%= i === 0 ? ' is-active' : '' %>" role="tab" aria-selected="<%= i === 0 %>" data-status="<%= s %>"><%= s %> <span class="pg-tab-n"><%= counts[s] || 0 %></span></button>
      <% }) %>
      <button type="button" class="pg-tab" role="tab" aria-selected="false" data-status="all">All <span class="pg-tab-n"><%= projects.length %></span></button>
    </div>
    <label class="pg-search">
      <i class="bi bi-search" aria-hidden="true"></i>
      <input type="search" id="projectSearch" placeholder="Search projects, companies, products, tasks" autocomplete="off" aria-label="Search projects">
    </label>
  </div>

  <div class="pl-filters">
    <button type="button" class="pl-chip" id="plAttn" aria-pressed="false"><i class="bi bi-exclamation-circle"></i>Needs attention <b><%= attention %></b></button>
    <button type="button" class="pl-chip" id="plMine" aria-pressed="false"><i class="bi bi-person"></i>My projects <b><%= mineCount %></b></button>
    <span class="pl-spacer"></span>
    <label class="pl-select"><span>Group</span>
      <select id="plGroup"><option value="none">None</option><option value="company">Company</option><option value="owner">Owner</option><option value="category">Type</option></select></label>
    <label class="pl-select"><span>Sort</span>
      <select id="plSort">
        <option value="activity">Last update</option>
        <option value="due">Next due date</option>
        <option value="attention">Needs attention first</option>
        <option value="name">Name A–Z</option>
        <option value="created">Newest first</option>
      </select></label>
  </div>

  <div class="pl-table-wrap">
    <table class="pl-table" id="plTable">
      <colgroup><col class="pl-c-name"><col class="pl-c-status"><col class="pl-c-tasks"><col class="pl-c-due"><col class="pl-c-upd"><col class="pl-c-owner"><col class="pl-c-x"></colgroup>
      <thead>
        <tr><th>Project</th><th>Status</th><th>Tasks</th><th>Next due</th><th>Last update</th><th>Owner</th><th><span class="visually-hidden">Open tasks</span></th></tr>
      </thead>
      <% projects.forEach(p => {
           const company = p.companies && p.companies[0];
           const d = due(p.nextDueDays);
           const pct = p.taskTotal ? Math.round(p.taskDone / p.taskTotal * 100) : 0;
           const lm = p.lastMessage;
           const search = [p.name, p.category, p.statusLabel, company && company.name, p.ownerName,
                           (p.products || []).map(x => x.name).join(' '), (p.tasks || []).map(t => t.name).join(' ')].join(' ').toLowerCase();
      %>
      <tbody class="pl-proj<%= p.flags.length ? ' has-flag' : '' %>"
             data-id="<%= p.id %>" data-status="<%= p.statusLabel %>" data-search="<%= search %>"
             data-mine="<%= p.mine ? 1 : 0 %>" data-flag="<%= p.flags.length %>"
             data-name="<%= esc(p.name).toLowerCase() %>" data-created="<%= p.createdAt ? new Date(p.createdAt).toISOString() : '' %>"
             data-last="<%= p.lastAt || '' %>" data-due="<%= p.nextTask ? p.nextTask.deadline : '' %>"
             data-company="<%= company ? company.name : '' %>" data-owner="<%= p.ownerName || '' %>" data-category="<%= p.category || '' %>">
        <tr class="pl-row">
          <td class="pl-name">
            <a href="/projects/<%= p.id %>" class="pl-title"><%= p.name || '(untitled project)' %></a>
            <div class="pl-sub">
              <% if (company) { %>
                <a href="/companies/<%= company.id %>" class="pl-company">
                  <% if (p.companyLogo) { %><img src="<%= p.companyLogo %>" alt="" loading="lazy" onerror="this.remove()"><% } %><%= company.name %></a>
              <% } else { %><span class="pl-muted">No company</span><% } %>
              <% if (p.category) { %><span class="pl-sep">·</span><span><%= p.category %></span><% } %>
              <% if (p.products && p.products.length) { %><span class="pl-sep">·</span><span class="pl-products" title="<%= p.products.map(x => x.name).join(', ') %>"><%= p.products.map(x => x.name).join(', ') %></span><% } %>
            </div>
            <% if (p.flags.length) { %>
              <div class="pl-flags">
                <% if (p.flags.includes('overdue')) { %><span class="pl-flag is-late"><i class="bi bi-alarm"></i><%= p.overdueCount %> overdue</span><% } %>
                <% if (p.flags.includes('blocked')) { %><span class="pl-flag is-late"><i class="bi bi-slash-circle"></i><%= p.blockedCount %> blocked</span><% } %>
                <% if (p.flags.includes('quiet')) { %><span class="pl-flag is-quiet"><i class="bi bi-moon"></i>No update for <%= p.idleDays %> days</span><% } %>
              </div>
            <% } %>
          </td>
          <td><span class="pl-status pl-status-<%= sKey(p.statusLabel) %>"><%= p.statusLabel %></span></td>
          <td>
            <% if (p.taskTotal) { %>
              <div class="pl-progress" title="<%= p.taskDone %> of <%= p.taskTotal %> tasks done">
                <div class="pl-bar"><i style="width:<%= pct %>%"></i></div>
                <span><%= p.taskDone %>/<%= p.taskTotal %></span>
              </div>
            <% } else { %>
              <a href="/projects/<%= p.id %>/tasks/new" class="pl-add">+ Add task</a>
            <% } %>
          </td>
          <td>
            <% if (p.nextTask) { %>
              <div class="pl-due <%= d.cls %>"><%= d.text %></div>
              <div class="pl-small" title="<%= p.nextTask.name %>"><%= p.nextTask.name %></div>
            <% } else { %><span class="pl-muted">—</span><% } %>
          </td>
          <td>
            <div class="pl-upd<%= p.flags.includes('quiet') ? ' is-quiet' : '' %>"><%= ago(p.idleDays) %></div>
            <% if (lm) { %><div class="pl-small"><i class="bi <%= CH_ICON[lm.channel] || 'bi-chat-left' %>"></i> <%= lm.channel === 'wechat' ? 'WeChat' : lm.channel === 'email' ? 'Email' : 'Message' %><%= lm.by ? ' · ' + lm.by : '' %></div><% } %>
          </td>
          <td>
            <% if (p.ownerName) { %><span class="pl-owner"><span class="pl-avatar"><%= initials(p.ownerName) %></span><span><%= p.ownerName %></span></span>
            <% } else { %><span class="pl-muted">Unassigned</span><% } %>
          </td>
          <td class="pl-x">
            <% if (p.taskTotal) { %>
              <button type="button" class="pl-toggle" aria-expanded="false" aria-controls="plt-<%= p.id %>" title="Show open tasks"><i class="bi bi-chevron-down"></i></button>
            <% } %>
          </td>
        </tr>
        <% if (p.taskTotal) { %>
        <tr class="pl-tasks" id="plt-<%= p.id %>" hidden>
          <td colspan="7">
            <ul class="pl-task-list">
              <% p.openTasks.forEach(t => { const td = due(t.deadline ? Math.round((new Date(t.deadline + 'T00:00:00Z') - new Date(new Date().toISOString().slice(0,10) + 'T00:00:00Z')) / 86400000) : null); %>
                <li>
                  <span class="pl-tstat pl-tstat-<%= sKey(t.status) %>" title="<%= t.status %>"></span>
                  <a href="/tasks/<%= t.id %>" class="pl-tname"><%= t.name || '(untitled)' %></a>
                  <span class="pl-tmeta"><%= t.status %></span>
                  <span class="pl-tmeta"><%= (t.assignees && t.assignees.length ? t.assignees.map(a => a.name).join(', ') : t.ownerName) || '' %></span>
                  <span class="pl-tmeta <%= td ? td.cls : '' %>"><%= t.deadline ? fmtDate(t.deadline) : '' %></span>
                </li>
              <% }) %>
              <% if (!p.openTasks.length) { %><li class="pl-tempty">All <%= p.taskTotal %> tasks are done.</li><% } %>
            </ul>
            <div class="pl-task-foot">
              <a href="/projects/<%= p.id %>/tasks/new" class="pl-add">+ Add task</a>
              <% if (p.taskDone) { %><span class="pl-muted"><%= p.taskDone %> completed</span><% } %>
              <a href="/projects/<%= p.id %>" class="pl-open">Open project <i class="bi bi-arrow-right"></i></a>
            </div>
          </td>
        </tr>
        <% } %>
      </tbody>
      <% }) %>
    </table>
    <div class="pl-empty" id="plEmpty" hidden>
      <i class="bi bi-kanban"></i>
      <p>No projects match these filters.</p>
      <button type="button" class="pg-btn" id="plReset">Clear filters</button>
    </div>
  </div>
</div>

<script>
(function () {
  var table = document.getElementById('plTable');
  var rows = Array.prototype.slice.call(table.querySelectorAll('tbody.pl-proj'));
  var tabs = document.getElementById('plTabs'), search = document.getElementById('projectSearch');
  var attnBtn = document.getElementById('plAttn'), mineBtn = document.getElementById('plMine');
  var groupSel = document.getElementById('plGroup'), sortSel = document.getElementById('plSort');
  var empty = document.getElementById('plEmpty');
  var KEY = 'crm.projects.view';
  var st = { status: 'Active', q: '', attn: false, mine: false, group: 'none', sort: 'activity' };
  try { Object.assign(st, JSON.parse(localStorage.getItem(KEY) || '{}'), { q: '' }); } catch (e) {}

  function save() { try { localStorage.setItem(KEY, JSON.stringify({ status: st.status, attn: st.attn, mine: st.mine, group: st.group, sort: st.sort })); } catch (e) {} }

  var SORTS = {
    activity: function (a, b) { return (b.dataset.last || '').localeCompare(a.dataset.last || ''); },
    due: function (a, b) { var x = a.dataset.due || '9999', y = b.dataset.due || '9999'; return x.localeCompare(y); },
    attention: function (a, b) { return (b.dataset.flag - a.dataset.flag) || SORTS.due(a, b); },
    name: function (a, b) { return a.dataset.name.localeCompare(b.dataset.name); },
    created: function (a, b) { return (b.dataset.created || '').localeCompare(a.dataset.created || ''); },
  };
  var GROUP_ATTR = { company: 'company', owner: 'owner', category: 'category' };
  var GROUP_EMPTY = { company: 'No company', owner: 'Unassigned', category: 'No type' };

  function esc(t) { return String(t).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }

  function render() {
    // controls
    Array.prototype.forEach.call(tabs.children, function (b) { var on = b.dataset.status === st.status; b.classList.toggle('is-active', on); b.setAttribute('aria-selected', on); });
    attnBtn.setAttribute('aria-pressed', st.attn); mineBtn.setAttribute('aria-pressed', st.mine);
    groupSel.value = st.group; sortSel.value = st.sort;

    var q = st.q.trim().toLowerCase();
    var visible = rows.filter(function (r) {
      var ok = (st.status === 'all' || r.dataset.status === st.status)
        && (!st.attn || r.dataset.flag !== '0')
        && (!st.mine || r.dataset.mine === '1')
        && (!q || r.dataset.search.indexOf(q) !== -1);
      r.hidden = !ok;
      return ok;
    });
    visible.sort(SORTS[st.sort] || SORTS.activity);

    table.querySelectorAll('tbody.pl-group').forEach(function (g) { g.remove(); });
    var attr = GROUP_ATTR[st.group];
    if (attr) {
      var groups = {}, order = [];
      visible.forEach(function (r) { var k = r.dataset[attr] || ''; if (!groups[k]) { groups[k] = []; order.push(k); } groups[k].push(r); });
      order.sort(function (a, b) { return !a ? 1 : !b ? -1 : a.localeCompare(b); });
      order.forEach(function (k) {
        var h = document.createElement('tbody'); h.className = 'pl-group';
        h.innerHTML = '<tr><td colspan="7"><span>' + esc(k || GROUP_EMPTY[st.group]) + '</span><b>' + groups[k].length + '</b></td></tr>';
        table.appendChild(h);
        groups[k].forEach(function (r) { table.appendChild(r); });
      });
    } else {
      visible.forEach(function (r) { table.appendChild(r); });
    }
    rows.filter(function (r) { return r.hidden; }).forEach(function (r) { table.appendChild(r); });
    empty.hidden = visible.length > 0;
    table.querySelector('thead').hidden = !visible.length;
    save();
  }

  tabs.addEventListener('click', function (e) { var b = e.target.closest('.pg-tab'); if (!b) return; st.status = b.dataset.status; render(); });
  attnBtn.addEventListener('click', function () { st.attn = !st.attn; render(); });
  mineBtn.addEventListener('click', function () { st.mine = !st.mine; render(); });
  groupSel.addEventListener('change', function () { st.group = groupSel.value; render(); });
  sortSel.addEventListener('change', function () { st.sort = sortSel.value; render(); });
  var t; search.addEventListener('input', function () { clearTimeout(t); t = setTimeout(function () { st.q = search.value; render(); }, 120); });
  document.getElementById('plReset').addEventListener('click', function () { st = { status: 'all', q: '', attn: false, mine: false, group: st.group, sort: st.sort }; search.value = ''; render(); });

  // Expand open tasks; click anywhere on the row (except links/buttons) opens the project
  table.addEventListener('click', function (e) {
    var tg = e.target.closest('.pl-toggle');
    if (tg) {
      var row = document.getElementById(tg.getAttribute('aria-controls'));
      var open = tg.getAttribute('aria-expanded') !== 'true';
      tg.setAttribute('aria-expanded', open); row.hidden = !open;
      return;
    }
    var tr = e.target.closest('tr.pl-row');
    if (tr && !e.target.closest('a,button')) {
      var link = tr.querySelector('.pl-title');
      if (e.metaKey || e.ctrlKey) window.open(link.href, '_blank'); else location.href = link.href;
    }
  });

  render();
})();
</script>
