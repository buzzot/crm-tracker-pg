<%
  const who = selectedUser ? selectedUser.name : 'Whole team';
  const pct = (a, b) => b ? Math.round(a / b * 100) : 0;
  const short = n => { n = Math.round(n || 0); return n >= 1e6 ? '$' + (n / 1e6).toFixed(1) + 'M' : n >= 1e4 ? '$' + Math.round(n / 1e3) + 'k' : n ? '$' + n.toLocaleString('en-US') : '$0'; };
  const plural = (n, w) => n + ' ' + w + (n === 1 ? '' : 's');
  function trend(k) {
    if (k.prev === 0 && k.now === 0) return '<span class="tr tr-flat">no change</span>';
    if (k.diff === 0) return '<span class="tr tr-flat">same as before</span>';
    const up = k.diff > 0;
    return '<span class="tr ' + (up ? 'tr-up' : 'tr-down') + '">' + (up ? '▲ ' : '▼ ') + Math.abs(k.diff) + ' vs previous</span>';
  }
  function daysLate(d) { return Math.round((new Date(today + 'T00:00:00Z') - new Date(String(d instanceof Date ? d.toISOString() : d).slice(0, 10) + 'T00:00:00Z')) / 86400000); }
  function ago(d) { if (!d) return 'never'; const n = Math.floor((Date.now() - new Date(d)) / 86400000); return n <= 0 ? 'today' : n === 1 ? 'yesterday' : n + ' days ago'; }
  const noteKey = 'report-notes:' + period + ':' + (filterUserId || 'team') + ':' + W.from.toISOString().slice(0, 10);
  function notes(id, label) { %>
    <div class="notes">
      <label for="n-<%= id %>"><%= label %></label>
      <textarea id="n-<%= id %>" data-note="<%= id %>" rows="2" placeholder="Type your notes here; they're kept in this browser and included when you print."></textarea>
      <div class="notes-print" data-for="<%= id %>"></div>
    </div>
  <% }
  function section(n, title, sub) { %>
    <header class="sec-head"><span class="sec-n"><%= n %></span><div><h2><%= title %></h2><p><%= sub %></p></div></header>
  <% }
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= W.label %> report · <%= who %> · Samyou CRM</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    :root { --fg: #0f172a; --muted: #64748b; --line: #e2e8f0; --soft: #f8fafc; --accent: #2563eb; --red: #c2410c; --red-bg: #fef2f2; --amber: #b45309; --amber-bg: #fffbeb; --green: #15803d; --green-bg: #f0fdf4; }
    body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif; font-size: 13px; line-height: 1.5; color: var(--fg); background: #f1f5f9; }
    a { color: inherit; text-decoration: none; }
    a:hover { color: var(--accent); }

    /* Toolbar */
    .bar { position: sticky; top: 0; z-index: 10; background: #fff; border-bottom: 1px solid var(--line); }
    .bar-in { max-width: 960px; margin: 0 auto; padding: 10px 24px; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .bar a.back { display: inline-flex; align-items: center; gap: 6px; color: var(--muted); font-weight: 500; margin-right: 6px; }
    .bar form { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .bar select { height: 32px; border: 1px solid var(--line); border-radius: 8px; background: #fff; padding: 0 28px 0 10px; font-size: 13px; color: var(--fg); }
    .bar .sp { flex: 1; }
    .btn { display: inline-flex; align-items: center; gap: 6px; height: 32px; padding: 0 12px; border-radius: 8px; border: 1px solid var(--line); background: #fff; font-size: 13px; font-weight: 500; color: var(--fg); cursor: pointer; }
    .btn:hover { background: var(--soft); }
    .btn-primary { background: var(--accent); border-color: var(--accent); color: #fff; }
    .btn-primary:hover { background: #1d4ed8; }

    /* Document */
    .doc { max-width: 960px; margin: 20px auto 60px; background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 36px 44px; box-shadow: 0 1px 3px rgba(15,23,42,.05); }
    .cover { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; padding-bottom: 18px; border-bottom: 2px solid var(--fg); margin-bottom: 24px; }
    .eyebrow { font-size: 11px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
    .cover h1 { font-size: 26px; font-weight: 700; margin: 4px 0 2px; letter-spacing: -.01em; }
    .cover .period { color: #334155; }
    .cover .meta { text-align: right; font-size: 11px; color: var(--muted); }

    /* Highlights */
    .kpis { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 8px; margin-bottom: 18px; }
    .kpi { border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; }
    .kpi b { display: block; font-size: 22px; font-weight: 700; line-height: 1.15; font-variant-numeric: tabular-nums; }
    .kpi span { display: block; font-size: 11.5px; color: var(--muted); }
    .kpi.is-red { background: var(--red-bg); border-color: #fecaca; } .kpi.is-red b { color: var(--red); }
    .tr { display: block; font-size: 10.5px; margin-top: 3px; }
    .tr-up { color: var(--green); } .tr-down { color: var(--red); } .tr-flat { color: #94a3b8; }
    .attn { border: 1px solid #fde68a; background: var(--amber-bg); border-radius: 10px; padding: 12px 14px; margin-bottom: 28px; }
    .attn h3 { margin: 0 0 6px; font-size: 12.5px; color: var(--amber); display: flex; align-items: center; gap: 6px; }
    .attn ul { margin: 0; padding-left: 18px; }
    .attn li { margin: 2px 0; }
    .ok { color: var(--green); font-size: 12.5px; margin: 0 0 28px; display: flex; align-items: center; gap: 6px; }

    /* Sections */
    .sec { margin: 0 0 34px; }
    .sec-head { display: flex; gap: 12px; align-items: flex-start; padding-bottom: 8px; margin-bottom: 14px; border-bottom: 1px solid var(--line); }
    .sec-n { flex-shrink: 0; width: 26px; height: 26px; border-radius: 7px; background: var(--fg); color: #fff; font-size: 12px; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; margin-top: 1px; }
    .sec-head h2 { font-size: 16px; font-weight: 700; margin: 0; letter-spacing: -.005em; }
    .sec-head p { margin: 1px 0 0; font-size: 12px; color: var(--muted); }
    .stats { display: flex; gap: 22px; flex-wrap: wrap; margin: 0 0 14px; }
    .stat b { font-size: 18px; font-weight: 700; font-variant-numeric: tabular-nums; }
    .stat span { display: block; font-size: 11.5px; color: var(--muted); }
    .stat.is-red b { color: var(--red); } .stat.is-amber b { color: var(--amber); } .stat.is-green b { color: var(--green); }
    h4 { font-size: 11.5px; font-weight: 600; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); margin: 16px 0 6px; }
    .cols { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
    .empty { color: #94a3b8; font-style: italic; font-size: 12.5px; margin: 4px 0 8px; }
    .more { color: var(--muted); font-size: 12px; margin-top: 4px; }

    table { width: 100%; border-collapse: collapse; font-size: 12.5px; }
    th { text-align: left; font-size: 10.5px; font-weight: 600; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); padding: 6px 8px; border-bottom: 1px solid var(--line); background: var(--soft); }
    td { padding: 7px 8px; border-bottom: 1px solid #f1f5f9; vertical-align: top; }
    tr:last-child td { border-bottom: 0; }
    .num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .sub { display: block; color: var(--muted); font-size: 11.5px; }
    .red { color: var(--red); font-weight: 600; } .amber { color: var(--amber); font-weight: 500; } .muted { color: var(--muted); }
    .pill { display: inline-block; padding: 1px 7px; border-radius: 999px; font-size: 10.5px; font-weight: 600; background: #f1f5f9; color: #475569; white-space: nowrap; }
    .pill-green { background: var(--green-bg); color: var(--green); } .pill-amber { background: var(--amber-bg); color: var(--amber); } .pill-blue { background: #eff6ff; color: #1d4ed8; }

    .bars { display: grid; gap: 6px; }
    .barrow { display: grid; grid-template-columns: 150px 1fr 90px; gap: 10px; align-items: center; font-size: 12px; }
    .barrow .track { height: 8px; border-radius: 999px; background: #f1f5f9; overflow: hidden; }
    .barrow .fill { height: 100%; background: #334155; border-radius: inherit; }
    .barrow .v { text-align: right; color: var(--muted); font-variant-numeric: tabular-nums; }
    .funnel .fill { background: var(--accent); }

    .chips { display: flex; flex-wrap: wrap; gap: 6px; }
    .chip { border: 1px solid var(--line); border-radius: 999px; padding: 2px 10px; font-size: 12px; }
    .chip b { font-weight: 600; margin-left: 4px; }

    .notes { margin-top: 14px; }
    .notes label { display: block; font-size: 11.5px; font-weight: 600; color: #334155; margin-bottom: 4px; }
    .notes textarea { width: 100%; min-height: 54px; resize: vertical; border: 1px dashed #cbd5e1; border-radius: 8px; padding: 8px 10px; font: inherit; color: var(--fg); background: #fcfdfe; }
    .notes textarea:focus { outline: none; border-style: solid; border-color: var(--accent); background: #fff; }
    .notes-print { display: none; }

    .foot { display: flex; justify-content: space-between; border-top: 1px solid var(--line); padding-top: 10px; margin-top: 10px; font-size: 11px; color: #94a3b8; }

    @media (max-width: 760px) {
      .doc { padding: 22px 18px; border-radius: 0; margin: 0; }
      .kpis { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .cols { grid-template-columns: 1fr; }
      .cover { flex-direction: column; align-items: flex-start; } .cover .meta { text-align: left; }
      .barrow { grid-template-columns: 110px 1fr 70px; }
    }
    @media print {
      @page { size: A4; margin: 14mm 12mm; }
      body { background: #fff; font-size: 10.5pt; }
      .bar { display: none; }
      .doc { max-width: none; margin: 0; padding: 0; border: 0; box-shadow: none; }
      .sec { break-inside: auto; } .sec-head, .kpis, .attn, table tr { break-inside: avoid; }
      .notes textarea { display: none; }
      .notes-print { display: block; white-space: pre-wrap; border: 1px solid var(--line); border-radius: 6px; padding: 6px 8px; min-height: 40px; }
      .notes-print:empty::after { content: ''; display: block; height: 28px; }
      a { color: inherit !important; }
      .kpi, .attn, th, .pill, .fill, .sec-n { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    }
  </style>
</head>
<body>

<div class="bar">
  <div class="bar-in">
    <a href="/" class="back"><i class="bi bi-arrow-left"></i>Back</a>
    <form method="GET" action="/reports/monthly" id="rf">
      <% if (canSeeTeam) { %>
        <select name="userId" aria-label="Person" onchange="this.form.submit()">
          <option value="">Whole team</option>
          <% users.forEach(u => { %><option value="<%= u.id %>" <%= filterUserId === u.id ? 'selected' : '' %>><%= u.name %></option><% }) %>
        </select>
      <% } %>
      <select name="period" aria-label="Period" onchange="this.form.submit()">
        <option value="month" <%= period === 'month' ? 'selected' : '' %>>This month</option>
        <option value="lastmonth" <%= period === 'lastmonth' ? 'selected' : '' %>>Last month</option>
        <option value="7" <%= period === '7' ? 'selected' : '' %>>Last 7 days</option>
        <option value="30" <%= period === '30' ? 'selected' : '' %>>Last 30 days</option>
        <option value="90" <%= period === '90' ? 'selected' : '' %>>Last 90 days</option>
      </select>
      <noscript><button class="btn" type="submit">Apply</button></noscript>
    </form>
    <span class="sp"></span>
    <button type="button" class="btn btn-primary" onclick="window.print()"><i class="bi bi-printer"></i>Print / Save PDF</button>
  </div>
</div>

<main class="doc">

  <div class="cover">
    <div>
      <div class="eyebrow">Samyou · Business report</div>
      <h1><%= W.label %> · <%= who %></h1>
      <div class="period"><%= W.range %><% if (selectedUser && selectedUser.title) { %> · <%= selectedUser.title %><% } %></div>
    </div>
    <div class="meta">Generated <%= generatedAt %><br>Changes compared with the previous period of the same length</div>
  </div>

  <!-- Highlights -->
  <div class="kpis">
    <div class="kpi"><b><%= kpis.tasksDone.now %></b><span>Tasks completed</span><%- trend(kpis.tasksDone) %></div>
    <div class="kpi"><b><%= kpis.actsDone.now %></b><span>Activities done</span><%- trend(kpis.actsDone) %></div>
    <div class="kpi"><b><%= kpis.conversations.now %></b><span>Customer emails &amp; WeChats</span><%- trend(kpis.conversations) %></div>
    <div class="kpi"><b><%= kpis.newContacts.now %></b><span>New contacts</span><%- trend(kpis.newContacts) %></div>
    <div class="kpi"><b><%= kpis.newDeals.now %></b><span>New deals</span><%- trend(kpis.newDeals) %></div>
    <div class="kpi<%= kpis.overdue ? ' is-red' : '' %>"><b><%= kpis.overdue %></b><span>Overdue tasks now</span><span class="tr tr-flat">as of today</span></div>
  </div>

  <% const attnItems = [];
     if (overdue.length) attnItems.push(plural(overdue.length, 'overdue task') + ', oldest ' + daysLate(overdue[0].deadline) + ' days late (' + overdue[0].name + ')');
     if (projQuiet.length) attnItems.push(plural(projQuiet.length, 'active project') + ' with no update for 14+ days');
     if (stalledDeals.length) attnItems.push(plural(stalledDeals.length, 'open deal') + ' not updated for 21+ days');
     if (dealsNoAmount) attnItems.push(plural(dealsNoAmount, 'open deal') + ' without an amount, so the forecast is understated');
     if (dueSoon.length) attnItems.push(plural(dueSoon.length, 'task') + ' due in the next 14 days'); %>
  <% if (attnItems.length) { %>
    <div class="attn"><h3><i class="bi bi-exclamation-triangle"></i>Needs attention</h3><ul><% attnItems.forEach(t => { %><li><%= t %></li><% }) %></ul></div>
  <% } else { %>
    <p class="ok"><i class="bi bi-check-circle"></i>Nothing overdue or stalled.</p>
  <% } %>

  <!-- 1 -->
  <section class="sec">
    <% section(1, 'Customer overview', selectedUser ? 'Accounts owned by ' + selectedUser.name + ' and who was engaged this period' : 'Portfolio and the customers we engaged with this period') %>
    <div class="cols">
      <div>
        <h4>Portfolio · <%= companies.length %> companies</h4>
        <div class="chips">
          <% Object.entries(statusCount).sort((a, b) => b[1] - a[1]).forEach(([s, n]) => { %><span class="chip"><%= s %><b><%= n %></b></span><% }) %>
        </div>
        <h4>By industry</h4>
        <% const ind = Object.entries(industryCount).sort((a, b) => b[1] - a[1]).slice(0, 6); const maxI = Math.max(1, ...ind.map(x => x[1])); %>
        <div class="bars">
          <% ind.forEach(([k, v]) => { %><div class="barrow"><span><%= k %></span><div class="track"><div class="fill" style="width:<%= pct(v, maxI) %>%"></div></div><span class="v"><%= v %></span></div><% }) %>
        </div>
      </div>
      <div>
        <h4>Most engaged this period</h4>
        <% if (engaged.length) { %>
          <table>
            <thead><tr><th>Company</th><th class="num">Activities</th><th class="num">Messages</th></tr></thead>
            <tbody>
              <% engaged.slice(0, 8).forEach(c => { %><tr><td><a href="/companies/<%= c.id %>"><%= c.name %></a></td><td class="num"><%= c.acts %></td><td class="num"><%= c.msgs + c.emails %></td></tr><% }) %>
            </tbody>
          </table>
          <% if (engaged.length > 8) { %><div class="more">+ <%= engaged.length - 8 %> more companies</div><% } %>
        <% } else { %><p class="empty">No customer activity or messages logged this period.</p><% } %>
      </div>
    </div>
  </section>

  <!-- 2 -->
  <section class="sec">
    <% section(2, 'Key performance', 'What was finished this period') %>
    <div class="stats">
      <div class="stat is-green"><b><%= tasksDone.length %></b><span>Tasks completed</span></div>
      <div class="stat is-green"><b><%= actsDone.length %></b><span>Activities done</span></div>
      <div class="stat"><b><%= actsCur.length %></b><span>Activities logged</span></div>
      <div class="stat"><b><%= projCompleted.length %></b><span>Projects completed</span></div>
    </div>
    <div class="cols">
      <div>
        <h4>Completed tasks</h4>
        <% if (tasksDone.length) { %>
          <table><tbody>
            <% tasksDone.slice(0, 10).forEach(t => { %><tr><td><a href="/tasks/<%= t.id %>"><%= t.name %></a><span class="sub"><%= t.project_name || 'No project' %> · <%= t.assignee_names || t.owner_name || '—' %></span></td><td class="num muted"><%= fmtDate(t.completed_at || t.updated_at) %></td></tr><% }) %>
          </tbody></table>
          <% if (tasksDone.length > 10) { %><div class="more">+ <%= tasksDone.length - 10 %> more</div><% } %>
        <% } else { %><p class="empty">No tasks completed this period.</p><% } %>
      </div>
      <div>
        <h4>Activities done</h4>
        <% if (actsDone.length) { %>
          <table><tbody>
            <% actsDone.slice(0, 10).forEach(a => { %><tr><td><a href="/activities/<%= a.id %>"><%= a.name %></a><span class="sub"><%= a.type || 'Activity' %> · <%= a.company_name || 'No company' %></span></td><td class="num muted"><%= fmtDate(a.status_date || a.created_at) %></td></tr><% }) %>
          </tbody></table>
          <% if (actsDone.length > 10) { %><div class="more">+ <%= actsDone.length - 10 %> more</div><% } %>
        <% } else { %><p class="empty">No activities marked done this period<%= actsCur.length ? ' (' + actsCur.length + ' logged, still open)' : '' %>.</p><% } %>
      </div>
    </div>
    <% notes('performance', 'Key achievements') %>
  </section>

  <!-- 3 -->
  <section class="sec">
    <% section(3, 'New customers & contacts', 'Companies and people added this period') %>
    <div class="stats">
      <div class="stat"><b><%= newCompanies.length %></b><span>New companies</span></div>
      <div class="stat"><b><%= newContacts.length %></b><span>New contacts</span></div>
    </div>
    <% if (newCompanies.length) { %>
      <table>
        <thead><tr><th>Company</th><th>Industry</th><th>Status</th><th>Owner</th><th class="num">Added</th></tr></thead>
        <tbody><% newCompanies.forEach(c => { %><tr><td><a href="/companies/<%= c.id %>"><b><%= c.name %></b></a></td><td><%= c.industry || '—' %></td><td><span class="pill<%= c.status === 'Active' || c.status === 'Client' ? ' pill-green' : c.status === 'Prospect' ? ' pill-amber' : '' %>"><%= c.status || '—' %></span></td><td><%= c.owner_name || '—' %></td><td class="num muted"><%= fmtDate(c.created_at) %></td></tr><% }) %></tbody>
      </table>
    <% } else { %><p class="empty">No new companies this period.</p><% } %>
    <% if (newContacts.length) {
         const byCo = {}; newContacts.forEach(c => { const k = c.company_name || 'No company'; (byCo[k] = byCo[k] || []).push(c); }); %>
      <h4>New contacts by company</h4>
      <table>
        <tbody>
          <% Object.entries(byCo).forEach(([co, list]) => { %>
            <tr><td style="width:28%"><b><%= co %></b><span class="sub"><%= plural(list.length, 'contact') %></span></td>
                <td><% list.forEach((c, i) => { %><%= i ? ' · ' : '' %><a href="/contacts/<%= c.id %>"><%= c.full_name %></a><% if (c.title) { %> <span class="muted">(<%= c.title %>)</span><% } %><% }) %></td></tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </section>

  <!-- 4 -->
  <section class="sec">
    <% section(4, 'Risk analysis', 'Overdue work, stalled deals and quiet projects, as of today') %>
    <div class="stats">
      <div class="stat<%= overdue.length ? ' is-red' : '' %>"><b><%= overdue.length %></b><span>Overdue tasks</span></div>
      <div class="stat"><b><%= openTasks.length %></b><span>Open tasks</span></div>
      <div class="stat<%= stalledDeals.length ? ' is-amber' : '' %>"><b><%= stalledDeals.length %></b><span>Stalled deals (21+ days)</span></div>
      <div class="stat<%= projQuiet.length ? ' is-amber' : '' %>"><b><%= projQuiet.length %></b><span>Quiet projects (14+ days)</span></div>
      <div class="stat"><b><%= lostCur.length %></b><span>Deals lost this period</span></div>
    </div>
    <% if (overdue.length) { %>
      <h4>Overdue tasks</h4>
      <table>
        <thead><tr><th>Task</th><th>Project</th><th>Assignee</th><th class="num">Due</th><th class="num">Late</th></tr></thead>
        <tbody><% overdue.slice().sort((a, b) => daysLate(b.deadline) - daysLate(a.deadline)).slice(0, 12).forEach(t => { %>
          <tr><td><a href="/tasks/<%= t.id %>"><%= t.name %></a></td><td><%= t.project_name || '—' %></td><td><%= t.assignee_names || t.owner_name || '—' %></td><td class="num muted"><%= fmtDate(t.deadline) %></td><td class="num red"><%= daysLate(t.deadline) %>d</td></tr>
        <% }) %></tbody>
      </table>
      <% if (overdue.length > 12) { %><div class="more">+ <%= overdue.length - 12 %> more overdue tasks</div><% } %>
    <% } %>
    <% if (projQuiet.length) { %>
      <h4>Active projects with no recent update</h4>
      <table><tbody><% projQuiet.slice(0, 8).forEach(p => { %>
        <tr><td><a href="/projects/<%= p.id %>"><%= p.name %></a><span class="sub"><%= p.company_name || 'No company' %></span></td><td><%= p.owner_name || '—' %></td><td class="num amber">last update <%= ago(p.last) %></td></tr>
      <% }) %></tbody></table>
      <% if (projQuiet.length > 8) { %><div class="more">+ <%= projQuiet.length - 8 %> more</div><% } %>
    <% } %>
    <% if (stalledDeals.length) { %>
      <h4>Stalled deals</h4>
      <table><tbody><% stalledDeals.slice(0, 8).forEach(d => { %>
        <tr><td><a href="/deals/<%= d.id %>"><%= d.name %></a><span class="sub"><%= d.company_name || 'No company' %> · <%= d.stage %></span></td><td class="num"><%= fmtMoney(d.amount) %></td><td class="num amber"><%= ago(d.updated_at) %></td></tr>
      <% }) %></tbody></table>
    <% } %>
    <% if (!overdue.length && !projQuiet.length && !stalledDeals.length) { %><p class="empty">No overdue tasks, stalled deals or quiet projects.</p><% } %>
    <% notes('risk', 'Risks and how we are handling them') %>
  </section>

  <!-- 5 -->
  <section class="sec">
    <% section(5, 'Business opportunities', 'Open pipeline by stage and deals closed this period') %>
    <div class="stats">
      <div class="stat"><b><%= short(pipelineValue) %></b><span>Open pipeline · <%= plural(openDeals.length, 'deal') %></span></div>
      <div class="stat"><b><%= short(weighted) %></b><span>Weighted forecast</span></div>
      <div class="stat is-green"><b><%= wonCur.length %></b><span>Won this period<%= wonCur.length ? ' · ' + short(wonCur.reduce((s, d) => s + (Number(d.amount) || 0), 0)) : '' %></span></div>
      <div class="stat"><b><%= lostCur.length %></b><span>Lost this period</span></div>
    </div>
    <h4>Pipeline by stage</h4>
    <% const maxS = Math.max(1, ...pipeline.map(s => s.count)); %>
    <div class="bars funnel">
      <% pipeline.forEach(s => { %><div class="barrow"><span><%= s.stage %> <span class="muted">· <%= Math.round(s.prob * 100) %>%</span></span><div class="track"><div class="fill" style="width:<%= pct(s.count, maxS) %>%"></div></div><span class="v"><%= s.count %> · <%= s.amount ? short(s.amount) : '—' %></span></div><% }) %>
    </div>
    <% if (openDeals.length) { %>
      <h4>Top open deals</h4>
      <table>
        <thead><tr><th>Deal</th><th>Stage</th><th>Owner</th><th class="num">Amount</th><th class="num">Updated</th></tr></thead>
        <tbody><% openDeals.slice(0, 8).forEach(d => { %>
          <tr><td><a href="/deals/<%= d.id %>"><%= d.name %></a><span class="sub"><%= d.company_name || 'No company' %></span></td><td><span class="pill pill-blue"><%= d.stage || 'Prospecting' %></span></td><td><%= d.owner_name || '—' %></td><td class="num"><%= fmtMoney(d.amount) %></td><td class="num muted"><%= ago(d.updated_at) %></td></tr>
        <% }) %></tbody>
      </table>
    <% } else { %><p class="empty">No open deals.</p><% } %>
    <% notes('opportunities', 'Opportunity notes and next steps') %>
  </section>

  <!-- 6 -->
  <section class="sec">
    <% section(6, 'Product learning', 'Products involved in active projects') %>
    <% if (productsInPlay.length) { %>
      <div class="chips">
        <% productsInPlay.slice(0, 20).forEach(p => { %><span class="chip"><%= p.name %><b><%= p.projects %></b></span><% }) %>
      </div>
      <p class="more">Number = active projects using the product.</p>
    <% } else { %><p class="empty">No products linked to active projects yet. Link products on the project page to see them here.</p><% } %>
    <% notes('products', 'Product knowledge gained / gaps to close') %>
  </section>

  <!-- 7 -->
  <section class="sec">
    <% section(7, 'Market & information gathering', 'Customer conversations, company research and outreach mix') %>
    <div class="stats">
      <div class="stat"><b><%= channelCount.email || 0 %></b><span>Emails logged</span></div>
      <div class="stat"><b><%= channelCount.wechat || 0 %></b><span>WeChats logged</span></div>
      <div class="stat"><b><%= sentCur.length %></b><span>Emails sent from CRM</span></div>
      <div class="stat"><b><%= research.length %></b><span>Companies researched (AI)</span></div>
    </div>
    <div class="cols">
      <div>
        <h4>Activity mix</h4>
        <% const at = Object.entries(actTypes).sort((a, b) => b[1] - a[1]); const maxA = Math.max(1, ...at.map(x => x[1])); %>
        <% if (at.length) { %><div class="bars"><% at.forEach(([k, v]) => { %><div class="barrow"><span><%= k %></span><div class="track"><div class="fill" style="width:<%= pct(v, maxA) %>%"></div></div><span class="v"><%= v %></span></div><% }) %></div>
        <% } else { %><p class="empty">No activities this period.</p><% } %>
      </div>
      <div>
        <h4>Companies researched</h4>
        <% if (research.length) { %><div class="chips"><% research.forEach(r => { %><a class="chip" href="/companies/<%= r.company_id %>"><%= r.company_name %></a><% }) %></div>
        <% } else { %><p class="empty">No AI company research this period.</p><% } %>
      </div>
    </div>
    <% notes('market', 'Market trends and insights') %>
  </section>

  <!-- 8 -->
  <section class="sec">
    <% section(8, 'Projects & cross-department work', 'Projects worked on this period (tasks, messages, updates)') %>
    <div class="stats">
      <div class="stat"><b><%= projTouched.length %></b><span>Projects worked on</span></div>
      <div class="stat"><b><%= projActive.length %></b><span>Active projects</span></div>
      <div class="stat is-green"><b><%= projCompleted.length %></b><span>Completed this period</span></div>
    </div>
    <% if (projTouched.length) { %>
      <table>
        <thead><tr><th>Project</th><th>Status</th><th class="num">Tasks done</th><th class="num">Open</th><th class="num">Messages</th><th class="num">Last update</th></tr></thead>
        <tbody><% projTouched.slice(0, 15).forEach(p => { %>
          <tr><td><a href="/projects/<%= p.id %>"><%= p.name %></a><span class="sub"><%= p.company_name || 'No company' %><%= p.owner_name ? ' · ' + p.owner_name : '' %></span></td>
              <td><span class="pill<%= p.status === 'Active' ? ' pill-green' : p.status === 'On Hold' ? ' pill-amber' : '' %>"><%= p.status %></span></td>
              <td class="num"><%= p.done || '—' %></td><td class="num<%= p.late ? ' red' : '' %>"><%= p.open || '—' %><%= p.late ? ' (' + p.late + ' late)' : '' %></td><td class="num"><%= p.msgs || '—' %></td><td class="num muted"><%= ago(p.last) %></td></tr>
        <% }) %></tbody>
      </table>
      <% if (projTouched.length > 15) { %><div class="more">+ <%= projTouched.length - 15 %> more projects</div><% } %>
    <% } else { %><p class="empty">No project updates this period.</p><% } %>
    <% notes('internal', 'Internal coordination (orders, production, finance, after-sales)') %>
  </section>

  <!-- 9 -->
  <section class="sec">
    <% section(9, 'Business development', 'New deals and outreach') %>
    <div class="stats">
      <div class="stat"><b><%= newDeals.length %></b><span>New deals</span></div>
      <div class="stat"><b><%= outreach.length %></b><span>Outreach activities</span></div>
      <div class="stat"><b><%= newCompanies.length %></b><span>New companies</span></div>
      <div class="stat"><b><%= newContacts.length %></b><span>New contacts</span></div>
    </div>
    <% if (newDeals.length) { %>
      <table>
        <thead><tr><th>New deal</th><th>Stage</th><th>Owner</th><th class="num">Amount</th></tr></thead>
        <tbody><% newDeals.forEach(d => { %><tr><td><a href="/deals/<%= d.id %>"><%= d.name %></a><span class="sub"><%= d.company_name || 'No company' %></span></td><td><span class="pill pill-blue"><%= d.stage || 'Prospecting' %></span></td><td><%= d.owner_name || '—' %></td><td class="num"><%= fmtMoney(d.amount) %></td></tr><% }) %></tbody>
      </table>
    <% } else { %><p class="empty">No new deals this period.</p><% } %>
    <% notes('bd', 'Lead generation and business development') %>
  </section>

  <!-- 10 -->
  <section class="sec">
    <% section(10, selectedUser ? 'Contribution & improvement' : 'Team contribution & improvement', 'Who did what this period, and improvement ideas') %>
    <% if (people.length) { %>
      <table>
        <thead><tr><th>Person</th><th class="num">Tasks done</th><th class="num">Activities done</th><th class="num">Messages</th><th class="num">New deals</th><th class="num">Open</th><th class="num">Overdue</th></tr></thead>
        <tbody><% people.forEach(p => { %>
          <tr><td><b><%= p.name %></b><span class="sub"><%= p.title || p.role %></span></td><td class="num"><%= p.tasksDone %></td><td class="num"><%= p.actsDone %><span class="muted"> / <%= p.acts %></span></td><td class="num"><%= p.msgs %></td><td class="num"><%= p.deals %></td><td class="num"><%= p.open %></td><td class="num<%= p.late ? ' red' : '' %>"><%= p.late %></td></tr>
        <% }) %></tbody>
      </table>
      <p class="more">Activities: done / logged. Messages: emails and WeChats logged plus emails sent from the CRM.</p>
    <% } else { %><p class="empty">No recorded work this period.</p><% } %>
    <% notes('improve', 'Improvement initiatives and proactive actions') %>
  </section>

  <div class="foot"><span>Samyou CRM · Confidential</span><span><%= W.range %></span><span>Generated <%= generatedAt %></span></div>
</main>

<script>
(function () {
  var KEY = <%- JSON.stringify(noteKey) %>;
  var saved = {};
  try { saved = JSON.parse(localStorage.getItem(KEY) || '{}'); } catch (e) {}
  document.querySelectorAll('textarea[data-note]').forEach(function (ta) {
    var id = ta.dataset.note, out = document.querySelector('.notes-print[data-for="' + id + '"]');
    function grow() { ta.style.height = 'auto'; ta.style.height = Math.max(54, ta.scrollHeight + 2) + 'px'; }
    ta.value = saved[id] || ''; out.textContent = ta.value; grow();
    ta.addEventListener('input', function () {
      saved[id] = ta.value; out.textContent = ta.value; grow();
      try { localStorage.setItem(KEY, JSON.stringify(saved)); } catch (e) {}
    });
  });
})();
</script>
</body>
</html>
