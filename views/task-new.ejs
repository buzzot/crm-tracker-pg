<%
  const v = values || {};
  const me = (typeof currentUser !== 'undefined' && currentUser) || {};
  const preset = projects.find(p => p.id === (v.projectId || presetProject)) || null;
  const list = x => Array.isArray(x) ? x : x ? [x] : [];
  const assignees = v.name !== undefined ? list(v.assigneeIds) : [me.id];
  const status = v.status || 'To Do';
  const backHref = preset ? '/projects/' + preset.id : '/tasks';
  const reviewers = teamUsers.filter(u => u.role === 'Admin' || u.role === 'Manager');
%>

<div class="pg pj fm">
  <nav class="pj-crumbs" aria-label="Breadcrumb">
    <a href="/tasks">Tasks</a>
    <% if (preset) { %><i class="bi bi-chevron-right" aria-hidden="true"></i><a href="/projects/<%= preset.id %>"><%= preset.name %></a><% } %>
  </nav>

  <form action="/tasks/new" method="POST" enctype="multipart/form-data" id="ntkForm" novalidate>
    <input type="hidden" name="returnTo" value="<%= preset ? 'project' : '' %>">

    <header class="pj-head">
      <div class="pj-head-main">
        <h1 class="pj-title">New task</h1>
        <div class="pj-meta"><span class="pj-meta-item pj-muted">Name it, assign it and set a due date. Everything else is optional.</span></div>
      </div>
      <div class="pj-head-actions">
        <label class="ntk-another"><input type="checkbox" name="another" value="1" <%= created ? 'checked' : '' %>> Create another</label>
        <a href="<%= backHref %>" class="pg-btn">Cancel</a>
        <button type="submit" class="pg-btn pg-btn-primary" id="ntkSubmit"><i class="bi bi-check2" aria-hidden="true"></i>Create task</button>
      </div>
    </header>

    <% if (created) { %><div class="td-banner ntk-ok"><i class="bi bi-check-circle-fill"></i><span>Task created. <a href="/tasks/<%= created %>">Open it</a>, or add the next one.</span></div><% } %>
    <% if (error) { %><div class="td-banner td-banner-red"><i class="bi bi-exclamation-circle"></i><span><%= error %></span></div><% } %>

    <div class="pj-grid">
      <div class="pj-main">
        <section class="pj-card" aria-labelledby="fmWhat">
          <div class="pj-card-head"><h2 class="pj-card-title" id="fmWhat">Task</h2></div>
          <label class="fm-field"><span>Name <b>*</b></span>
            <input type="text" name="name" id="ntkName" class="fm-input fm-input-lg" value="<%= v.name || '' %>" placeholder="What needs to get done?" required autofocus autocomplete="off" maxlength="300"></label>
          <p class="npj-err" id="ntkNameErr" hidden>Give the task a name.</p>
          <label class="fm-field"><span>Details <i>optional</i></span>
            <textarea name="description" class="fm-input" rows="6" maxlength="4000" placeholder="Context and what &quot;done&quot; looks like, e.g. Quote for 500 pcs BDQ100, delivery to Dallas, valid 30 days."><%= v.description || '' %></textarea></label>
        </section>

        <section class="pj-card" aria-labelledby="fmFiles">
          <div class="pj-card-head"><div><h2 class="pj-card-title" id="fmFiles">Files</h2><p class="pj-card-sub">Optional. Drawings, specs, screenshots.</p></div></div>
          <label class="td-drop npj-drop" id="ntkDrop" for="ntkFiles"><i class="bi bi-cloud-arrow-up"></i><span><b>Drop files</b>, paste a screenshot, or <span class="td-browse">browse</span></span></label>
          <input type="file" name="attachments" id="ntkFiles" multiple hidden>
          <ul class="npj-files" id="ntkFileList"></ul>
        </section>
      </div>

      <aside class="pj-side">
        <section class="pj-card pj-side-card" aria-labelledby="fmProj">
          <h2 class="pj-side-title" id="fmProj">Project</h2>
          <div class="npj-combo">
            <i class="bi bi-kanban" aria-hidden="true"></i>
            <input type="text" id="ntkProjInput" placeholder="Search projects…" autocomplete="off" value="<%= preset ? preset.name : '' %>" role="combobox" aria-expanded="false" aria-controls="ntkProjList">
            <button type="button" class="npj-clear" id="ntkProjClear" aria-label="Clear project" <%= preset ? '' : 'hidden' %>><i class="bi bi-x"></i></button>
            <input type="hidden" name="projectId" id="ntkProjId" value="<%= preset ? preset.id : '' %>">
            <ul class="npj-pop" id="ntkProjList" role="listbox" hidden></ul>
          </div>
          <p class="pj-hint" id="ntkProjCo"><%= preset && preset.company ? preset.company : 'Optional' %></p>
        </section>

        <section class="pj-card pj-side-card" aria-labelledby="fmSched">
          <h2 class="pj-side-title" id="fmSched">Schedule</h2>
          <span class="fm-label">Status</span>
          <div class="npj-seg fm-seg" role="radiogroup" aria-label="Status">
            <% statusChoices.filter(s => s !== 'Completed').forEach(s => { %>
              <label class="npj-seg-opt"><input type="radio" name="status" value="<%= s %>" <%= s === status ? 'checked' : '' %>><span><%= s %></span></label>
            <% }) %>
          </div>
          <div class="fm-two">
            <label class="fm-field"><span>Start</span><input type="date" name="startDate" id="ntkStart" class="fm-input" value="<%= v.startDate || new Date().toISOString().slice(0, 10) %>"></label>
            <label class="fm-field"><span>Due</span><input type="date" name="deadline" id="ntkDue" class="fm-input" value="<%= v.deadline || '' %>"></label>
          </div>
          <div class="ntk-quick" id="ntkQuick">
            <button type="button" data-days="0">Today</button>
            <button type="button" data-days="1">Tomorrow</button>
            <button type="button" data-friday>Friday</button>
            <button type="button" data-days="7">1 week</button>
            <button type="button" data-days="14">2 weeks</button>
          </div>
          <p class="npj-err" id="ntkDateErr" hidden>Due date is before the start date.</p>
        </section>

        <section class="pj-card pj-side-card" aria-labelledby="fmPeople">
          <h2 class="pj-side-title" id="fmPeople">People</h2>
          <span class="fm-label">Assigned to</span>
          <div class="ntk-people" id="ntkPeople">
            <% teamUsers.forEach(u => { %>
              <label class="ntk-person" title="<%= u.title || '' %>">
                <input type="checkbox" name="assigneeIds" value="<%= u.id %>" <%= assignees.includes(u.id) ? 'checked' : '' %>>
                <span><b><%= String(u.name || '?').charAt(0).toUpperCase() %></b><%= u.name %><%= u.id === me.id ? ' (me)' : '' %></span>
              </label>
            <% }) %>
          </div>
          <label class="fm-field fm-gap"><span>Reviewer <i>checks the result</i></span>
            <select name="auditorId" id="ntkReviewer" class="fm-input">
              <option value="">No reviewer</option>
              <% reviewers.forEach(u => { %><option value="<%= u.id %>" <%= v.auditorId === u.id ? 'selected' : '' %>><%= u.name %></option><% }) %>
            </select></label>
        </section>
      </aside>
    </div>
  </form>
</div>

<script>
(function () {
  var PROJECTS = <%- JSON.stringify(projects).replace(/</g, '\\u003c') %>;
  var $ = function (id) { return document.getElementById(id); };
  function esc(t) { return String(t == null ? '' : t).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
  function ymd(d) { return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); }

  // Project combobox
  var input = $('ntkProjInput'), hid = $('ntkProjId'), pop = $('ntkProjList'), clear = $('ntkProjClear'), co = $('ntkProjCo');
  var items = [], active = -1;
  function setProject(p) { hid.value = p ? p.id : ''; input.value = p ? p.name : ''; co.textContent = p && p.company ? p.company : 'Optional'; clear.hidden = !p; }
  function draw() {
    var q = input.value.trim().toLowerCase();
    items = PROJECTS.filter(function (p) { return !q || (p.name + ' ' + (p.company || '')).toLowerCase().indexOf(q) !== -1; }).slice(0, 40);
    pop.innerHTML = items.length ? items.map(function (p, i) { return '<li role="option" data-i="' + i + '"><i class="bi bi-kanban"></i>' + esc(p.name) + (p.company ? '<small>' + esc(p.company) + '</small>' : '') + '</li>'; }).join('') : '<li class="npj-none">No matching open projects</li>';
    pop.hidden = false; active = -1;
  }
  input.addEventListener('focus', draw); input.addEventListener('input', function () { hid.value = ''; co.textContent = 'Optional'; draw(); });
  input.addEventListener('keydown', function (e) {
    var lis = pop.querySelectorAll('li[data-i]');
    if (e.key === 'ArrowDown') { e.preventDefault(); active = Math.min(lis.length - 1, active + 1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); active = Math.max(0, active - 1); }
    else if (e.key === 'Enter') { e.preventDefault(); if (items[active < 0 ? 0 : active]) { setProject(items[active < 0 ? 0 : active]); pop.hidden = true; } return; }
    else if (e.key === 'Escape') { pop.hidden = true; return; } else return;
    lis.forEach(function (li, i) { li.classList.toggle('is-active', i === active); });
  });
  pop.addEventListener('mousedown', function (e) { var li = e.target.closest('li[data-i]'); if (!li) return; e.preventDefault(); setProject(items[+li.dataset.i]); pop.hidden = true; });
  input.addEventListener('blur', function () { setTimeout(function () { pop.hidden = true; if (!hid.value) input.value = ''; }, 120); });
  clear.addEventListener('click', function () { setProject(null); input.focus(); });

  // Due date shortcuts
  var due = $('ntkDue'), start = $('ntkStart');
  $('ntkQuick').addEventListener('click', function (e) {
    var b = e.target.closest('button'); if (!b) return;
    var d = new Date(); d.setHours(0, 0, 0, 0);
    if (b.hasAttribute('data-friday')) { var add = (5 - d.getDay() + 7) % 7; d.setDate(d.getDate() + (add || 7)); }
    else d.setDate(d.getDate() + (+b.dataset.days));
    due.value = ymd(d); syncQuick(); checkDates();
  });
  function syncQuick() { $('ntkQuick').querySelectorAll('button').forEach(function (b) { var d = new Date(); d.setHours(0, 0, 0, 0); if (b.hasAttribute('data-friday')) { var add = (5 - d.getDay() + 7) % 7; d.setDate(d.getDate() + (add || 7)); } else d.setDate(d.getDate() + (+b.dataset.days)); b.classList.toggle('is-on', due.value === ymd(d)); }); }
  function checkDates() { var bad = start.value && due.value && start.value > due.value; $('ntkDateErr').hidden = !bad; return !bad; }
  due.addEventListener('change', function () { syncQuick(); checkDates(); }); start.addEventListener('change', checkDates); syncQuick();

  // Files (drop / paste / browse)
  var fileInput = $('ntkFiles'), drop = $('ntkDrop'), dt = new DataTransfer();
  function drawFiles() {
    fileInput.files = dt.files;
    $('ntkFileList').innerHTML = Array.prototype.map.call(dt.files, function (f, i) { return '<li><i class="bi bi-file-earmark"></i><span>' + esc(f.name) + '</span><small>' + Math.max(1, Math.round(f.size / 1024)) + ' KB</small><button type="button" data-rm="' + i + '" aria-label="Remove"><i class="bi bi-x"></i></button></li>'; }).join('');
  }
  function addFiles(fl) { Array.prototype.forEach.call(fl, function (f) { if (dt.files.length < 10) dt.items.add(f); }); drawFiles(); }
  fileInput.addEventListener('change', function () { var fl = Array.prototype.slice.call(fileInput.files); dt = new DataTransfer(); addFiles(fl); });
  ['dragenter', 'dragover'].forEach(function (ev) { drop.addEventListener(ev, function (e) { e.preventDefault(); drop.classList.add('is-over'); }); });
  ['dragleave', 'drop'].forEach(function (ev) { drop.addEventListener(ev, function (e) { e.preventDefault(); drop.classList.remove('is-over'); }); });
  drop.addEventListener('drop', function (e) { addFiles(e.dataTransfer.files); });
  document.addEventListener('paste', function (e) {
    var fl = Array.prototype.filter.call((e.clipboardData && e.clipboardData.files) || [], function (f) { return /^image\//.test(f.type); });
    if (!fl.length) return; e.preventDefault();
    addFiles(fl.map(function (f, i) { return new File([f], 'screenshot-' + Date.now() + (i ? '-' + i : '') + '.png', { type: f.type }); }));
  });
  $('ntkFileList').addEventListener('click', function (e) { var b = e.target.closest('[data-rm]'); if (!b) return; var keep = new DataTransfer(); Array.prototype.forEach.call(dt.files, function (f, i) { if (i !== +b.dataset.rm) keep.items.add(f); }); dt = keep; drawFiles(); });

  // Submit
  var form = $('ntkForm'), name = $('ntkName');
  name.addEventListener('input', function () { if (name.value.trim()) $('ntkNameErr').hidden = true; });
  form.addEventListener('submit', function (e) {
    var ok = true;
    if (!name.value.trim()) { $('ntkNameErr').hidden = false; name.focus(); ok = false; }
    if (!checkDates()) ok = false;
    if (!ok) { e.preventDefault(); return; }
    $('ntkSubmit').disabled = true; $('ntkSubmit').innerHTML = '<i class="bi bi-hourglass-split"></i>Creating…';
  });
  document.addEventListener('keydown', function (e) { if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') form.requestSubmit(); });
})();
</script>
