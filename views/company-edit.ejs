<div class="pnew-page">
  <a href="/companies/<%= company.id %>" class="pnew-back-link"><i class="bi bi-arrow-left"></i> <%= company.name %></a>

  <div class="pnew-badge"><i class="bi bi-pencil-square"></i> Edit company</div>
  <h1 class="pnew-hero">Edit <em><%= company.name %></em></h1>
  <p class="pnew-hero-sub">Update company information — changes save immediately.</p>

  <% if (error) { %>
    <div class="alert alert-danger mb-3"><%= error %></div>
  <% } %>

  <form action="/companies/<%= company.id %>" method="POST">
    <div class="pnew-grid">

      <div class="pnew-main">

        <div class="pnew-card">
          <h2 class="pnew-card-title">Identity</h2>
          <p class="pnew-card-sub">Name and online presence.</p>

          <div class="mb-3">
            <label class="pnew-field-label">Company name <span class="pnew-required">*</span></label>
            <input type="text" name="name" class="pnew-input" value="<%= company.name || '' %>" required autofocus>
          </div>

          <div class="mb-0">
            <label class="pnew-field-label"><i class="bi bi-globe2"></i> Website</label>
            <input type="url" name="web" class="pnew-input" placeholder="https://" value="<%= company.web || '' %>">
          </div>
        </div>

        <div class="pnew-card">
          <h2 class="pnew-card-title">Classification</h2>
          <p class="pnew-card-sub">Industry and relationship status.</p>

          <div class="row g-3">
            <div class="col-md-6">
              <label class="pnew-field-label"><i class="bi bi-tag"></i> Industry</label>
              <select name="industry" class="pnew-select">
                <option value="">— Select —</option>
                <% industryChoices.forEach(opt => { %>
                  <option value="<%= opt %>" <%= company.industry === opt ? 'selected' : '' %>><%= opt %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-6">
              <label class="pnew-field-label"><i class="bi bi-activity"></i> Status</label>
              <select name="status" class="pnew-select">
                <option value="">— Select —</option>
                <% statusChoices.forEach(opt => { %>
                  <option value="<%= opt %>" <%= company.status === opt ? 'selected' : '' %>><%= opt %></option>
                <% }) %>
              </select>
            </div>
          </div>
        </div>

        <div class="pnew-card">
          <h2 class="pnew-card-title">Additional info</h2>
          <p class="pnew-card-sub">Billing details and internal notes.</p>

          <div class="mb-3">
            <label class="pnew-field-label"><i class="bi bi-geo-alt"></i> Billing address</label>
            <textarea name="billingAddress" class="pnew-input pnew-textarea" rows="2"><%= company.billingAddress || '' %></textarea>
          </div>

          <div class="mb-0">
            <label class="pnew-field-label"><i class="bi bi-sticky"></i> Notes</label>
            <textarea name="notes" class="pnew-input pnew-textarea" rows="3"><%= company.notes || '' %></textarea>
          </div>
        </div>

        <div class="d-flex gap-2">
          <button type="submit" class="pnew-btn-save"><i class="bi bi-check-lg"></i> Save changes</button>
          <a href="/companies/<%= company.id %>" class="pnew-btn-cancel">Cancel</a>
        </div>

      </div>

      <div class="pnew-aside">
        <div class="pnew-card">
          <h2 class="pnew-card-title">Logo</h2>
          <!-- Not a <form>: this card sits inside the main edit form, and nested forms are
               discarded by browsers. Uploads go through fetch; the file input has no name
               so it is never sent with the company fields. -->
          <div class="logo-drop <%= company.logo ? 'has-logo' : '' %>" id="logoDrop" tabindex="0" role="button"
               aria-label="Company logo. Drop an image, paste it, or press Enter to choose a file."
               data-upload-url="/companies/<%= company.id %>/logo">
            <img class="logo-drop-img" id="logoImg" alt="<%= company.name %> logo" <% if (company.logo) { %>src="<%= company.logo %>"<% } else { %>hidden<% } %>>
            <div class="logo-drop-empty" id="logoEmpty" <% if (company.logo) { %>hidden<% } %>>
              <i class="bi bi-image" aria-hidden="true"></i>
              <span><strong>Drop or paste</strong> an image</span>
              <span class="logo-drop-or">or <span class="logo-drop-link">choose a file</span></span>
            </div>
            <div class="logo-drop-over" aria-hidden="true">Drop to upload</div>
            <div class="logo-drop-busy" id="logoBusy" hidden><span class="logo-spin" aria-hidden="true"></span>Uploading…</div>
            <input type="file" id="logoFile" accept="image/png,image/jpeg,image/webp,image/gif,image/svg+xml" hidden>
          </div>
          <div class="logo-drop-foot">
            <span id="logoMsg" class="logo-msg" role="status" aria-live="polite">PNG, JPG, WebP, GIF or SVG, up to 5 MB</span>
            <button type="button" class="logo-change" id="logoChange" <% if (!company.logo) { %>hidden<% } %>>Change</button>
          </div>
        </div>
        <div class="pnew-summary-card">
          <div class="pnew-summary-title">Current values</div>
          <div class="pnew-summary-row"><span>Industry</span><span><%= company.industry || '—' %></span></div>
          <div class="pnew-summary-row"><span>Status</span><span><%= company.status || '—' %></span></div>
          <div class="pnew-summary-row"><span>Website</span><span style="word-break:break-all; font-size:0.78rem;"><%= company.web || '—' %></span></div>
        </div>
        <div class="pnew-tip-card">
          <i class="bi bi-info-circle"></i>
          <div class="pnew-tip-title">Contacts & deals</div>
          <div class="pnew-tip-text">To manage linked contacts, deals, and projects go back to the <a href="/companies/<%= company.id %>">company profile</a>.</div>
        </div>
      </div>

    </div>
  </form>

  <!-- Documents upload — separate form, below the edit grid -->
  <form action="/companies/<%= company.id %>/attachments" method="POST" enctype="multipart/form-data" style="margin-top:1.5rem;">
    <div class="pnew-card">
      <h2 class="pnew-card-title">Upload documents</h2>
      <p class="pnew-card-sub">Attach contracts, agreements, or any relevant files.</p>
      <div class="pnew-dropzone" id="coDropzone">
        <i class="bi bi-upload" style="font-size:1.5rem; color:var(--crm-muted-fg);"></i>
        <p style="margin:0.5rem 0 0.25rem; font-weight:600;">Drop files here or <label for="coFiles" style="color:var(--crm-accent); cursor:pointer; text-decoration:underline;">browse</label></p>
        <p style="margin:0; font-size:0.78rem; color:var(--crm-muted-fg);">PDF, images, documents — up to 25 MB</p>
        <input type="file" name="attachments" id="coFiles" multiple accept=".pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg,.gif,.txt" style="display:none;" onchange="coUpdateFileList(this)">
      </div>
      <ul id="coFileList" style="margin:0.5rem 0 0.75rem; padding-left:1.25rem; font-size:0.82rem; color:var(--crm-muted-fg);"></ul>
      <button type="submit" class="pnew-btn-save"><i class="bi bi-upload"></i> Upload</button>
    </div>
  </form>

  <script>
    const coDropzone = document.getElementById('coDropzone');
    coDropzone.addEventListener('dragover', e => { e.preventDefault(); coDropzone.classList.add('dragover'); });
    coDropzone.addEventListener('dragleave', () => coDropzone.classList.remove('dragover'));
    coDropzone.addEventListener('drop', e => {
      e.preventDefault(); coDropzone.classList.remove('dragover');
      const input = document.getElementById('coFiles');
      const dt = new DataTransfer();
      [...(input.files||[]), ...e.dataTransfer.files].forEach(f => dt.items.add(f));
      input.files = dt.files;
      coUpdateFileList(input);
    });
    function coUpdateFileList(input) {
      const ul = document.getElementById('coFileList');
      ul.innerHTML = [...input.files].map(f =>
        `<li>${f.name} <span style="color:var(--crm-muted-fg);">(${(f.size/1024).toFixed(0)} KB)</span></li>`
      ).join('');
    }
  </script>

  <script>
  // ── Company logo: click, drag-and-drop or paste; uploads immediately via fetch ──
  (function () {
    var drop = document.getElementById('logoDrop');
    if (!drop) return;
    var file = document.getElementById('logoFile');
    var img = document.getElementById('logoImg');
    var empty = document.getElementById('logoEmpty');
    var busy = document.getElementById('logoBusy');
    var msg = document.getElementById('logoMsg');
    var change = document.getElementById('logoChange');
    var TYPES = ['image/png', 'image/jpeg', 'image/webp', 'image/gif', 'image/svg+xml'];
    var MAX = 5 * 1024 * 1024;
    var DEFAULT_MSG = msg.textContent;
    var uploading = false;

    function say(text, kind) { msg.textContent = text; msg.className = 'logo-msg' + (kind ? ' is-' + kind : ''); }
    function show(src) {
      img.src = src; img.hidden = false; empty.hidden = true;
      drop.classList.add('has-logo'); change.hidden = false;
    }

    function upload(f) {
      if (!f || uploading) return;
      if (TYPES.indexOf(f.type) === -1) return say('Use a PNG, JPG, WebP, GIF or SVG image.', 'error');
      if (f.size > MAX) return say('That image is larger than 5 MB.', 'error');

      var previous = img.hidden ? null : img.src;
      var localUrl = URL.createObjectURL(f);
      show(localUrl);                       // instant preview
      uploading = true; busy.hidden = false; drop.setAttribute('aria-busy', 'true');
      say('Uploading…');

      var fd = new FormData();
      var ext = (f.type.split('/')[1] || 'png').replace('svg+xml', 'svg').replace('jpeg', 'jpg');
      fd.append('logo', f, f.name && f.name !== 'image.png' ? f.name : 'logo.' + ext);

      fetch(drop.getAttribute('data-upload-url'), {
        method: 'POST', body: fd, credentials: 'same-origin', headers: { 'Accept': 'application/json' }
      })
        .then(function (r) { return r.json().catch(function () { return { ok: false }; }).then(function (j) { return r.ok && j.ok ? j : Promise.reject(j); }); })
        .then(function (j) {
          if (j.logo) img.src = j.logo;
          say('Logo updated', 'ok');
          setTimeout(function () { if (msg.classList.contains('is-ok')) say(DEFAULT_MSG); }, 3000);
        })
        .catch(function (j) {
          if (previous) show(previous); else { img.hidden = true; img.removeAttribute('src'); empty.hidden = false; drop.classList.remove('has-logo'); change.hidden = true; }
          say((j && j.error) || "Upload failed. Try again.", 'error');
        })
        .then(function () {
          uploading = false; busy.hidden = true; drop.removeAttribute('aria-busy');
          URL.revokeObjectURL(localUrl); file.value = '';
        });
    }

    function pick() { if (!uploading) file.click(); }
    drop.addEventListener('click', pick);
    change.addEventListener('click', pick);
    drop.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); pick(); } });
    file.addEventListener('change', function () { upload(file.files[0]); });

    ['dragenter', 'dragover'].forEach(function (t) {
      drop.addEventListener(t, function (e) { e.preventDefault(); e.stopPropagation(); drop.classList.add('is-over'); });
    });
    ['dragleave', 'dragend'].forEach(function (t) {
      drop.addEventListener(t, function (e) { if (!drop.contains(e.relatedTarget)) drop.classList.remove('is-over'); });
    });
    drop.addEventListener('drop', function (e) {
      e.preventDefault(); e.stopPropagation(); drop.classList.remove('is-over');
      var f = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0];
      if (f) upload(f); else say('Drop an image file from your computer.', 'error');
    });

    // Paste: an image on the clipboard goes to the logo, unless the user is pasting text into a field
    document.addEventListener('paste', function (e) {
      var cd = e.clipboardData; if (!cd) return;
      var imgItem = Array.prototype.find.call(cd.items || [], function (it) { return it.kind === 'file' && it.type.indexOf('image/') === 0; });
      if (!imgItem) return;
      var t = e.target, tag = (t && t.tagName) || '';
      var typingText = (tag === 'INPUT' || tag === 'TEXTAREA' || (t && t.isContentEditable)) && cd.getData('text/plain');
      if (typingText) return;
      e.preventDefault();
      drop.focus();
      upload(imgItem.getAsFile());
    });
  })();
  </script>

</div>
